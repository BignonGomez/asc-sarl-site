---
import '@fontsource-variable/ibm-plex-sans/wght.css';
import plexLatin from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import BackToTop from '../components/layout/BackToTop.astro';
import { site, noindex } from '../config/site';

/** robots : force la directive (ex. « noindex, nofollow » pour une page de confirmation) */
interface Props { title?: string; description?: string; cta?: { title?: string; text?: string } | false; robots?: string }
const { title, description = site.description, cta, robots } = Astro.props;
// Titres courts (≤ 65 caractères, au-delà Google tronque) : le nom du cabinet n'est ajouté que s'il tient
const suffixed = title ? `${title} | ${site.shortName}` : '';
const fullTitle = title
  ? (suffixed.length <= 65 ? suffixed : title)
  : `${site.shortName} | Bureau d'études, Cotonou`;
// URL canonique toujours rattachée au domaine officiel asc-sarl.com (même sur la version de test)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || '/' : Astro.url.pathname;
const canonical = new URL(path, site.url).href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="preload" href={plexLatin} as="font" type="font/woff2" crossorigin />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(noindex || robots) && <meta name="robots" content={robots ?? 'noindex, nofollow'} />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f6f4f0" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social/og-image-1200x630.png', site.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Logo ${site.name}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/social/twitter-card-1200x675.png', site.url).href} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={`${base}/favicon/favicon.ico`} sizes="any" />
    <link rel="icon" href={`${base}/favicon/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/favicon/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/favicon/site.webmanifest`} />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#contenu" class="sr-only z-[60] rounded-ui bg-ink px-4 py-3 font-semibold text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Aller au contenu</a>
    <Header />
    <main id="contenu" class="flex-1">
      <slot />
    </main>
    <Footer cta={cta} />
    <BackToTop />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
