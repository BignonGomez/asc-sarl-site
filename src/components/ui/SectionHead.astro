---
/**
 * En-tête de section (refonte) : repère technique en IBM Plex Mono à gauche (numéro + intitulé),
 * titre H2 (révélé mot par mot à l'entrée dans l'écran) et introduction facultative à droite, sur la grille de 12 colonnes.
 */
interface Props { index: string; label: string; title: string; intro?: string; id: string }
const { index, label, title, intro, id } = Astro.props;
const words = title.split(' ');
---
<div class="grid-site gap-y-5" data-reveal>
  <p class="col-span-full text-eyebrow uppercase text-muted lg:col-span-3 lg:pt-3">
    <span class="text-accent-text">{index}</span><span aria-hidden="true" class="mx-2 text-line-strong">/</span>{label}
  </p>
  <div class="col-span-full lg:col-span-9">
    <h2 id={id} class="sh-title max-w-[22ch] text-h2 text-ink">
      {words.map((w, i) => <><span class="sh-w"><span class="sh-wi" style={`--wi:${i}`}>{w}</span></span>{' '}</>)}
    </h2>
    {intro && <p class="mt-5 max-w-2xl text-lead text-muted">{intro}</p>}
    <slot />
  </div>
</div>

<style>
  .sh-w { display: inline-block; overflow: clip; overflow-clip-margin: 0.2em; vertical-align: top; }
  .sh-wi { display: inline-block; }
  :global(.js) [data-reveal] .sh-wi { transform: translateY(105%); transition: transform 0.9s var(--ease-out-soft); transition-delay: calc(80ms + var(--wi) * 45ms); }
  :global(.js) [data-reveal].is-visible .sh-wi { transform: none; }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-reveal] .sh-wi { transform: none; transition: none; }
  }
</style>
