---
/**
 * Bouton-lien.
 * Variantes : primary (accent plein, texte blanc), secondary (contour discret, texte principal),
 * light (contour clair sur fond sombre), white (fond clair, texte principal).
 * Rayons, hauteurs et transitions identiques partout (jetons --radius-ui, --ease-out-soft).
 */
import { ArrowRight } from '@lucide/astro';
import { url } from '../../lib/url';

interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'light' | 'white';
  size?: 'md' | 'lg';
  arrow?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', arrow = false, class: extra = '' } = Astro.props;

const variants = {
  primary: 'bg-accent text-white hover:bg-accent-hover',
  secondary: 'border border-line-strong text-ink hover:border-ink hover:bg-paper',
  light: 'border border-white/40 text-white hover:border-white hover:bg-white/10',
  white: 'bg-paper text-ink hover:bg-sunken',
};
const sizes = { md: 'min-h-12 px-5 text-[0.9375rem]', lg: 'min-h-13 px-6 text-base' };
---
<a
  href={url(href)}
  data-magnetic={variant === 'primary' ? '' : undefined}
  class:list={[
    'group/btn inline-flex items-center justify-center gap-2.5 rounded-ui font-medium whitespace-nowrap transition-[background-color,color,border-color,transform] duration-200 ease-[var(--ease-out-soft)]',
    variants[variant],
    sizes[size],
    extra,
  ]}
>
  <slot />
  {arrow && <ArrowRight size={18} aria-hidden="true" class="transition-transform duration-300 ease-[var(--ease-out-soft)] group-hover/btn:translate-x-1" />}
</a>
