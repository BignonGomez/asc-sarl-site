---
/**
 * En-tête des pages intérieures (refonte) : composition typographique sur le fond continu,
 * fil d'Ariane, surtitre technique (IBM Plex Mono), H1 de poids moyen, introduction, puis filet 1 px.
 * Emplacement facultatif « aside » : visuel à droite (photo ou schéma), le texte occupe alors 7 colonnes sur 12.
 * Le fil d'Ariane est aussi publié en données structurées (schema.org BreadcrumbList) pour le référencement.
 */
import { ChevronRight } from '@lucide/astro';
import type { ImageId } from '../../config/images';
import { url } from '../../lib/url';
import { site } from '../../config/site';

interface Crumb { label: string; href?: string }
/** image : conservée pour compatibilité, ignorée depuis la refonte (étape 1). */
interface Props { title: string; eyebrow?: string; intro?: string; crumbs: Crumb[]; image?: ImageId }
const { title, eyebrow, intro, crumbs } = Astro.props;
const trail: Crumb[] = [{ label: 'Accueil', href: '/' }, ...crumbs];
const hasAside = Astro.slots.has('aside');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, site.url).href } : {}),
  })),
};
---
<section class="page-header">
  <div class="container-site pt-28 pb-12 sm:pt-32 lg:pt-44 lg:pb-20">
    <nav aria-label="Fil d'Ariane" class="page-in">
      <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-small text-muted">
        {trail.map((c, i) => (
          <li class="flex items-center gap-1.5">
            {i > 0 && <ChevronRight size={14} aria-hidden="true" class="text-line-strong" />}
            {c.href && i < trail.length - 1
              ? <a href={url(c.href)} class="rounded-sm transition-colors hover:text-ink hover:underline hover:underline-offset-4">{c.label}</a>
              : <span aria-current="page" class="text-ink">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>

    <div class="grid-site mt-10 gap-y-10 lg:mt-14 lg:items-center">
      <div class:list={['col-span-full', hasAside ? 'lg:col-span-7' : 'lg:col-span-9']}>
        {eyebrow && <p class="page-in text-eyebrow uppercase text-accent-text" style="--d:40ms">{eyebrow}</p>}
        <h1 class="page-in mt-4 max-w-4xl text-h1 text-ink" style="--d:80ms">{title}</h1>
        {intro && <p class="page-in mt-6 max-w-2xl text-lead text-muted" style="--d:140ms">{intro}</p>}
        <slot />
      </div>
      {hasAside && <div class="page-in col-span-full lg:col-span-5 lg:col-start-8" style="--d:200ms"><slot name="aside" /></div>}
    </div>
  </div>
  <div class="container-site"><div aria-hidden="true" class="rule-top"></div></div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .page-in {
    animation: page-in 0.6s var(--ease-out-soft) both;
    animation-delay: var(--d, 0ms);
  }
  /* Opacité de départ 0,01 : le titre compte tout de suite comme affiché (mesure du contenu principal) */
  @keyframes page-in {
    from { opacity: 0.01; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .page-in { animation: none; }
  }
</style>
