---
/**
 * En-tête (héro) des pages intérieures : photo plein format + voile vert, contenu centré (fil d'Ariane, étiquette, H1, introduction).
 * Le fil d'Ariane est aussi publié en données structurées (schema.org BreadcrumbList) pour le référencement.
 */
import { ChevronRight } from '@lucide/astro';
import SiteImage from '../ui/SiteImage.astro';
import type { ImageId } from '../../config/images';
import { url } from '../../lib/url';
import { site } from '../../config/site';

interface Crumb { label: string; href?: string }
/** image : identifiant de l'image de fond dans src/config/images.ts (ex. 'cabinet.hero'). */
interface Props { title: string; eyebrow?: string; intro?: string; crumbs: Crumb[]; image: ImageId }
const { title, eyebrow, intro, crumbs, image } = Astro.props;
const trail: Crumb[] = [{ label: 'Accueil', href: '/' }, ...crumbs];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, site.url).href } : {}),
  })),
};
---
<section class="relative isolate flex min-h-[30rem] items-center overflow-hidden bg-forest-night text-white sm:min-h-[34rem] lg:min-h-[38rem]">
  <div class="absolute inset-0 -z-20"><SiteImage id={image} sizes="100vw" priority alt="" /></div>
  <!-- Voile vert en dégradé (même traitement que le héro de l'accueil) -->
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(16_29_8/0.82)_0%,rgb(16_29_8/0.66)_45%,rgb(16_29_8/0.86)_80%,rgb(16_29_8/0.95)_100%)]"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_70%_60%_at_50%_50%,rgb(16_29_8/0.4),transparent_75%),radial-gradient(ellipse_55%_60%_at_100%_100%,rgb(174_36_69/0.28),transparent_70%)]"></div>

  <div class="container-site flex flex-col items-center pb-14 pt-28 text-center sm:pb-20 sm:pt-32 lg:pb-24 lg:pt-36">
    <nav aria-label="Fil d'Ariane" class="page-in">
      <ol class="flex flex-wrap items-center justify-center gap-x-1.5 gap-y-1 rounded-full border border-white/15 bg-white/10 px-4 py-1.5 text-small text-white/80 backdrop-blur-sm">
        {trail.map((c, i) => (
          <li class="flex items-center gap-1.5">
            {i > 0 && <ChevronRight size={14} aria-hidden="true" class="text-white/50" />}
            {c.href && i < trail.length - 1
              ? <a href={url(c.href)} class="rounded-sm transition-colors hover:text-white hover:underline hover:underline-offset-4">{c.label}</a>
              : <span aria-current="page" class="font-semibold text-white">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>

    {eyebrow && (
      <p class="page-in mt-8 inline-flex items-center gap-3 text-eyebrow uppercase text-white sm:mt-10" style="--d:40ms">
        <span aria-hidden="true" class="h-px w-8 bg-flame"></span>{eyebrow}<span aria-hidden="true" class="h-px w-8 bg-flame"></span>
      </p>
    )}
    <h1 class="page-in mt-5 max-w-4xl text-h1 text-white [text-shadow:0_2px_24px_rgb(16_29_8/0.45)] lg:text-[3.5rem]" style="--d:80ms">{title}</h1>
    {intro && <p class="page-in mt-6 max-w-3xl text-lead text-white/90" style="--d:140ms">{intro}</p>}
    <slot />
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .page-in {
    animation: page-in 0.8s var(--ease-out-soft) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes page-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
</style>
