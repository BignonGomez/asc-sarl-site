---
/**
 * En-tête des pages intérieures : composition claire, texte à gauche (fil d'Ariane, étiquette, H1, filet soleil, introduction)
 * et photo dans un cadre arrondi à droite, sans voile sombre (même langage que le héro de l'accueil).
 * Le fil d'Ariane est aussi publié en données structurées (schema.org BreadcrumbList) pour le référencement.
 */
import { ChevronRight } from '@lucide/astro';
import SiteImage from '../ui/SiteImage.astro';
import type { ImageId } from '../../config/images';
import { url } from '../../lib/url';
import { site } from '../../config/site';

interface Crumb { label: string; href?: string }
/** image : identifiant de la photo d'en-tête dans src/config/images.ts (ex. 'cabinet.hero'). */
interface Props { title: string; eyebrow?: string; intro?: string; crumbs: Crumb[]; image: ImageId }
const { title, eyebrow, intro, crumbs, image } = Astro.props;
const trail: Crumb[] = [{ label: 'Accueil', href: '/' }, ...crumbs];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, site.url).href } : {}),
  })),
};
---
<section class="page-header relative isolate overflow-clip">
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,var(--color-mist),#fff_85%)]"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_55%_80%_at_0%_0%,var(--color-mineral),transparent_70%)]"></div>

  <div class="container-site grid items-center gap-10 pb-14 pt-28 sm:pt-32 lg:grid-cols-12 lg:gap-12 lg:pb-20 lg:pt-40">
    <div class="lg:col-span-7">
      <nav aria-label="Fil d'Ariane" class="page-in">
        <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-small text-muted">
          {trail.map((c, i) => (
            <li class="flex items-center gap-1.5">
              {i > 0 && <ChevronRight size={14} aria-hidden="true" class="text-forest-mist" />}
              {c.href && i < trail.length - 1
                ? <a href={url(c.href)} class="rounded-sm transition-colors hover:text-forest hover:underline hover:underline-offset-4">{c.label}</a>
                : <span aria-current="page" class="font-semibold text-forest">{c.label}</span>}
            </li>
          ))}
        </ol>
      </nav>

      {eyebrow && (
        <p class="page-in mt-8 text-eyebrow uppercase text-brand sm:mt-10" style="--d:40ms">{eyebrow}</p>
      )}
      <h1 class="page-in mt-4 max-w-3xl text-h1 text-forest lg:text-[3.25rem]" style="--d:80ms">{title}</h1>
      <span aria-hidden="true" class="page-in mt-7 block h-1 w-14 rounded-full bg-sun" style="--d:120ms"></span>
      {intro && <p class="page-in mt-6 max-w-2xl text-lead text-muted" style="--d:140ms">{intro}</p>}
      <slot />
    </div>

    <div class="page-photo page-in lg:col-span-5" style="--d:200ms">
      <div class="page-photo__frame"><SiteImage id={image} sizes="(min-width: 64rem) 40vw, 100vw" priority alt="" /></div>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .page-in {
    animation: page-in 0.8s var(--ease-out-soft) both;
    animation-delay: var(--d, 0ms);
  }
  /* Photo : cadre arrondi, aplat vert très pâle décalé (même motif que l'accueil, en plus discret) */
  .page-photo { position: relative; }
  .page-photo::before {
    content: '';
    position: absolute;
    inset: 1.25rem -0.75rem -0.75rem 1.25rem;
    z-index: -1;
    border-radius: 2rem 2rem 2rem 6rem;
    background: var(--color-forest-soft);
  }
  .page-photo__frame { overflow: hidden; aspect-ratio: 16 / 10; border-radius: 1.75rem 1.75rem 1.75rem 5rem; box-shadow: var(--shadow-lift); }
  @media (width >= 64rem) {
    .page-photo__frame { aspect-ratio: 4 / 3.4; border-radius: 2rem 2rem 2rem 8rem; }
    .page-photo::before { inset: 1.5rem -1.25rem -1.25rem 1.5rem; border-radius: 2rem 2rem 2rem 9rem; }
  }
  @keyframes page-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
</style>
