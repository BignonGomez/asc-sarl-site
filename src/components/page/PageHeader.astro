---
/**
 * En-tête des pages intérieures : fond vert nuit (courbes de niveau), fil d'Ariane, étiquette, titre H1, introduction.
 * Le fil d'Ariane est aussi publié en données structurées (schema.org BreadcrumbList) pour le référencement.
 */
import { ChevronRight } from '@lucide/astro';
import { url } from '../../lib/url';
import { site } from '../../config/site';

interface Crumb { label: string; href?: string }
interface Props { title: string; eyebrow?: string; intro?: string; crumbs: Crumb[] }
const { title, eyebrow, intro, crumbs } = Astro.props;
const trail: Crumb[] = [{ label: 'Accueil', href: '/' }, ...crumbs];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, site.url).href } : {}),
  })),
};
---
<section class="relative isolate overflow-hidden bg-forest-night text-white">
  <svg aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 h-full w-full text-forest-mist opacity-[0.08]" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid slice" fill="none" stroke="currentColor" stroke-width="1.2">
    <path d="M-50 360 C 180 300, 320 420, 560 350 S 900 250, 1260 320" />
    <path d="M-50 310 C 200 240, 330 370, 580 290 S 920 190, 1260 260" />
    <path d="M-50 260 C 220 180, 340 320, 600 230 S 940 130, 1260 200" />
    <path d="M-50 210 C 240 120, 350 270, 620 170 S 960 70, 1260 140" />
    <path d="M-50 160 C 260 60, 360 220, 640 110 S 980 10, 1260 80" />
    <path d="M-50 110 C 280 0, 370 170, 660 50 S 1000 -50, 1260 20" />
  </svg>
  <div aria-hidden="true" class="absolute inset-0 -z-20 bg-[radial-gradient(ellipse_70%_90%_at_90%_0%,rgb(35_67_18/0.9),transparent_70%),radial-gradient(ellipse_50%_80%_at_0%_100%,rgb(174_36_69/0.22),transparent_70%)]"></div>

  <div class="container-site pb-14 pt-8 sm:pb-20 lg:pb-24 lg:pt-10">
    <nav aria-label="Fil d'Ariane">
      <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-small text-white/70">
        {trail.map((c, i) => (
          <li class="flex items-center gap-1.5">
            {i > 0 && <ChevronRight size={14} aria-hidden="true" class="text-white/40" />}
            {c.href && i < trail.length - 1
              ? <a href={url(c.href)} class="rounded-sm transition-colors hover:text-white hover:underline hover:underline-offset-4">{c.label}</a>
              : <span aria-current="page" class="font-semibold text-white">{c.label}</span>}
          </li>
        ))}
      </ol>
    </nav>

    <div class="mt-10 max-w-4xl sm:mt-14">
      {eyebrow && (
        <p class="page-in inline-flex items-center gap-3 text-eyebrow uppercase text-forest-mist">
          <span aria-hidden="true" class="h-px w-8 bg-flame"></span>{eyebrow}
        </p>
      )}
      <h1 class="page-in mt-5 text-h1 text-white" style="--d:60ms">{title}</h1>
      {intro && <p class="page-in mt-6 max-w-3xl text-lead text-white/85" style="--d:120ms">{intro}</p>}
      <slot />
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .page-in {
    animation: page-in 0.8s var(--ease-out-soft) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes page-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }
</style>
