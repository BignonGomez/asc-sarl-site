---
/** « Poursuivre » : lignes-liens vers les autres pages de la rubrique (la page courante est exclue). */
import { ArrowUpRight } from '@lucide/astro';
import SectionHead from '../ui/SectionHead.astro';
import { url } from '../../lib/url';

interface Props { current: string; links?: string[]; title?: string }
const { current, links, title = 'Poursuivre la découverte du cabinet' } = Astro.props;

const all = [
  { href: '/cabinet', title: 'Présentation du cabinet', text: 'Identité, statut juridique, positionnement et ancrage territorial.' },
  { href: '/cabinet/vision-mission-valeurs', title: 'Vision, mission et valeurs', text: 'Le cap que nous suivons, les actions que nous menons et les principes qui guident notre travail.' },
  { href: '/cabinet/equipe', title: 'Notre équipe', text: 'Des équipes pluridisciplinaires constituées selon chaque mission.' },
  { href: '/cabinet/approche', title: 'Notre approche méthodologique', text: "Comment nous conduisons une mission, de l'analyse des besoins au suivi des actions." },
  { href: '/expertises', title: 'Nos expertises', text: "Nos huit domaines d'intervention complémentaires." },
];
const items = all.filter((l) => l.href !== current && (!links || links.includes(l.href)));
---
<section aria-labelledby="suite-title" class="section-y">
  <div class="container-site">
    <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
    <SectionHead id="suite-title" label="Poursuivre" title={title} />
    <ul class="link-rows mt-12 lg:mt-16" data-reveal>
      {items.map((l, i) => (
        <li>
          <a href={url(l.href)} class="link-row">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <span class="link-row__title">{l.title}</span>
            <span class="link-row__text">{l.text}</span>
            <ArrowUpRight size={18} aria-hidden="true" class="link-row__go" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
