---
/**
 * Accueil, section 2 : présentation du cabinet.
 * Complète le héro sans le répéter : statut et ancrage, puis trois points clés
 * (formulations reprises des pages Le Cabinet, Équipe et FAQ, aucune information nouvelle),
 * puis les quatre familles de compétences de l'équipe (recommandation R5, source : src/data/equipe.ts).
 */
import { MapPin, Users, Handshake, Leaf, Sprout, MessagesSquare, Landmark, ArrowRight } from '@lucide/astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import SiteImage from '../ui/SiteImage.astro';
import { competences } from '../../data/equipe';
import { url } from '../../lib/url';

const competenceIcons = { leaf: Leaf, sprout: Sprout, messages: MessagesSquare, landmark: Landmark };

const points = [
  { icon: MapPin, title: 'Ancré au Bénin', text: "Siège à Cotonou ; interventions auprès d'acteurs nationaux et locaux, en milieu urbain comme en milieu rural." },
  { icon: Users, title: 'Pluridisciplinaire', text: 'Des équipes aux compétences complémentaires, constituées selon les besoins de chaque mission.' },
  { icon: Handshake, title: 'Au service des acteurs publics et privés', text: 'Administrations, collectivités territoriales, organisations de développement, entreprises et porteurs de projets.' },
];
---
<section aria-labelledby="cabinet-title" class="section-y">
  <div class="container-site grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6">
      <SectionHeading id="cabinet-title" title="Un cabinet béninois au service des territoires" />
      <p class="mt-7 max-w-xl text-lead text-ink/85" data-reveal>
        <strong class="font-semibold text-forest">Alkebulan Services et Conseils</strong> est une société à responsabilité limitée de droit béninois, immatriculée à Cotonou en 2025. Le cabinet adapte la composition de ses équipes et ses méthodes à la nature de chaque mission et au contexte de chaque territoire.
      </p>
      <ul class="mt-9 grid gap-5" data-reveal>
        {points.map((p) => (
          <li class="flex gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-forest-soft text-forest">
              <p.icon size={20} stroke-width={1.9} aria-hidden="true" />
            </span>
            <span>
              <span class="block font-display text-h4 text-forest">{p.title}</span>
              <span class="mt-1 block text-[0.9375rem] leading-relaxed text-muted">{p.text}</span>
            </span>
          </li>
        ))}
      </ul>
      <div class="mt-10" data-reveal>
        <ArrowLink href="/cabinet">En savoir plus sur le cabinet</ArrowLink>
      </div>
    </div>
    <div class="lg:col-span-6" data-reveal style="--reveal-delay:120ms">
      <div class="relative aspect-[4/3] overflow-hidden rounded-[1.75rem] shadow-lift ring-1 ring-black/5 lg:aspect-[4/4.4]">
        <SiteImage id="accueil.cabinet" sizes="(min-width: 64rem) 36rem, 100vw" />
      </div>
    </div>
  </div>

  <!-- Familles de compétences de l'équipe -->
  <div class="container-site mt-16 lg:mt-20" data-reveal>
    <div class="competences">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-eyebrow uppercase text-brand">Des compétences complémentaires</p>
          <h3 class="mt-2 text-h3 text-forest">Des équipes constituées selon chaque mission</h3>
        </div>
        <a href={url('/cabinet/equipe')} class="competences__link group">
          Découvrir notre équipe <ArrowRight size={17} aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1" />
        </a>
      </div>
      <ul class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {competences.map((c) => {
          const Icon = competenceIcons[c.icon];
          return (
            <li class="competence">
              <span class="competence__icon"><Icon size={20} stroke-width={1.9} aria-hidden="true" /></span>
              <span class="font-display text-[1.0625rem] font-semibold leading-snug text-forest">{c.label}</span>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<style>
  .competences { padding: clamp(1.5rem, 4vw, 2.5rem); border-radius: 1.75rem; background: var(--color-mineral); box-shadow: inset 0 0 0 1px rgb(20 24 28 / 0.06); }
  .competence { display: flex; align-items: center; gap: 0.9rem; padding: 1.1rem 1.2rem; border-radius: 1.1rem; background: #fff; box-shadow: inset 0 0 0 1px var(--color-line), var(--shadow-card); }
  .competence__icon { display: grid; place-items: center; flex-shrink: 0; width: 2.75rem; height: 2.75rem; border-radius: 0.85rem; color: var(--color-forest-deep); background: var(--color-sun); }
  .competences__link { display: inline-flex; flex-shrink: 0; align-items: center; gap: 0.5rem; font-weight: 700; color: var(--color-forest); }
  .competences__link:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--color-sun); }
</style>
