---
/**
 * Accueil, section 4 : réalisations.
 * Générée à partir de src/data/missions.ts (aucune donnée saisie ici) :
 * la mission la plus récente en vedette (photos, statut, période, commanditaire, lieu, nature des interventions,
 * domaines, résultats), puis les suivantes en cartes compactes dès qu'il y en a d'autres.
 * Résultats : affichés seulement pour une mission achevée qui les renseigne (champ `results`).
 */
import { MapPin, CalendarDays, Landmark, ArrowRight, Info, CircleCheck, Users } from '@lucide/astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import SiteImage from '../ui/SiteImage.astro';
import ExpertiseIcon from '../ui/ExpertiseIcon.astro';
import DurationBadge from '../ui/DurationBadge.astro';
import Button from '../ui/Button.astro';
import { missions } from '../../data/missions';
import { expertises } from '../../data/expertises';
import { url } from '../../lib/url';

const statusLabel = { 'en-cours': 'En cours', achevee: 'Achevée' } as const;
const domainsOf = (slugs: string[]) => expertises.filter((e) => slugs.includes(e.slug));
const ficheHref = (slug: string) => url(`/realisations/missions-en-cours#mission-${slug}`);
const [featured, ...others] = missions;
---
{featured && (
<section aria-labelledby="realisations-title" class="section-y bg-white">
  <div class="container-site">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <SectionHeading
        id="realisations-title"
        title="Nos réalisations"
        intro="Alkebulan Services et Conseils présente ses missions en distinguant clairement celles qui sont achevées de celles qui sont en cours d'exécution."
      />
      <div class="shrink-0" data-reveal>
        <ArrowLink href="/realisations/missions-en-cours">Voir toutes nos réalisations</ArrowLink>
      </div>
    </div>

    <!-- Mission en vedette -->
    <article aria-labelledby="realisation-vedette" class="mt-12 grid gap-8 lg:mt-14 lg:grid-cols-12 lg:gap-12" data-reveal>
      <!-- Photos de la mission (restent visibles pendant la lecture de la fiche sur grand écran) -->
      <div class="lg:sticky lg:top-28 lg:col-span-6 lg:self-start">
        <div class="mission__photo aspect-[4/3] overflow-hidden rounded-[1.5rem]">
          <SiteImage id={featured.images[0]} sizes="(min-width: 64rem) 36rem, 100vw" />
        </div>
        {featured.images.length > 1 && (
          <ul class="mt-3 grid grid-cols-3 gap-3" aria-label="Autres photos de la mission">
            {featured.images.slice(1, 4).map((img) => (
              <li class="aspect-[4/3] overflow-hidden rounded-xl"><SiteImage id={img} sizes="(min-width: 64rem) 12rem, 33vw" /></li>
            ))}
          </ul>
        )}
      </div>

      <!-- Fiche -->
      <div class="lg:col-span-6">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class:list={['statut', featured.status === 'en-cours' ? 'statut--cours' : 'statut--fini']}>
            <span aria-hidden="true" class="statut__dot"></span>{statusLabel[featured.status]}
          </span>
          {featured.duration && <DurationBadge duration={featured.duration} />}
          {/* Avec un badge de durée, seule la date de départ est rappelée ici (le délai figure dans la fiche complète) */}
          {(featured.duration ? featured.period.slice(0, 1) : featured.period).map((p) => (
            <span class="inline-flex items-center gap-1.5 rounded-full bg-mineral px-3 py-1 text-small text-muted">
              <CalendarDays size={14} aria-hidden="true" class="text-brand" /> {p}
            </span>
          ))}
        </div>

        <h3 id="realisation-vedette" class="mt-5 text-h3 leading-snug text-forest">{featured.title}</h3>

        <dl class="mt-6 grid gap-4 sm:grid-cols-2">
          <div class="fact">
            <dt class="fact__label"><Landmark size={15} aria-hidden="true" /> Commanditaire</dt>
            <dd class="fact__value">{featured.client}</dd>
          </div>
          <div class="fact">
            <dt class="fact__label"><MapPin size={15} aria-hidden="true" /> Lieu</dt>
            <dd class="fact__value">{featured.place}</dd>
          </div>
        </dl>

        <h4 class="mt-7 text-eyebrow uppercase text-brand">Nature des interventions</h4>
        <ul class="mt-3 grid gap-3">
          {featured.volets.map((v) => (
            <li class="volet">
              <span class="volet__icon"><Users size={17} aria-hidden="true" /></span>
              <span>
                <span class="block font-display font-semibold text-forest">{v.title}</span>
                <span class="mt-0.5 block text-small text-muted">{v.public}</span>
              </span>
            </li>
          ))}
        </ul>

        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Domaines d'expertise mobilisés">
          {domainsOf(featured.domains).map((d) => (
            <li><a href={url(`/expertises/${d.slug}`)} class="chip"><ExpertiseIcon name={d.icon} size={14} /> {d.title}</a></li>
          ))}
        </ul>

        {featured.status === 'achevee' && featured.results?.length ? (
          <div class="resultats">
            <p class="resultats__title"><CircleCheck size={16} aria-hidden="true" /> Résultats</p>
            <ul class="mt-2 grid gap-1.5">{featured.results.map((r) => <li>{r}</li>)}</ul>
          </div>
        ) : (
          <p class="resultats resultats--attente">
            <Info size={16} aria-hidden="true" class="mt-0.5 shrink-0 text-brand" />
            <span><strong class="font-semibold text-forest">Résultats :</strong> ils seront présentés à l'achèvement de la mission, sur la base de l'attestation de bonne exécution.</span>
          </p>
        )}

        <a href={ficheHref(featured.slug)} class="fiche-link group">
          Voir la fiche complète de la mission
          <ArrowRight size={18} aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-1" />
        </a>
      </div>
    </article>

    <!-- Suite logique (recommandation R7) -->
    <div class="relay mt-12 lg:mt-14" data-reveal>
      <p class="font-display text-h4 text-forest">Vous préparez une mission dans l'un de nos domaines ?</p>
      <Button href="/contact#formulaire" variant="secondary" arrow class="!whitespace-normal py-3 text-center md:shrink-0">Nous transmettre vos termes de référence</Button>
    </div>

    <!-- Missions suivantes (affichées dès qu'il y en a d'autres) -->
    {others.length > 0 && (
      <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {others.slice(0, 3).map((m) => (
          <li>
            <article class="mini group">
              <div class="aspect-[16/10] overflow-hidden"><SiteImage id={m.images[0]} sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw" class="transition-transform duration-700 group-hover:scale-[1.04]" /></div>
              <div class="p-6">
                <div class="flex flex-wrap items-center gap-2">
                  <span class:list={['statut', m.status === 'en-cours' ? 'statut--cours' : 'statut--fini']}><span aria-hidden="true" class="statut__dot"></span>{statusLabel[m.status]}</span>
                  {m.duration && <DurationBadge duration={m.duration} />}
                </div>
                <h3 class="mt-4 text-h4 leading-snug text-forest"><a href={ficheHref(m.slug)} class="after:absolute after:inset-0">{m.title}</a></h3>
                <p class="mt-3 inline-flex items-start gap-1.5 text-small text-muted"><MapPin size={15} aria-hidden="true" class="mt-0.5 shrink-0 text-brand" /> {m.place}</p>
              </div>
            </article>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
)}

<style>
  .mission__photo { box-shadow: var(--shadow-lift); }
  .relay { display: flex; flex-direction: column; align-items: flex-start; gap: 1rem; padding: 1.5rem 1.75rem; border-radius: 1.25rem; background: var(--color-mineral); box-shadow: inset 0 0 0 1px rgb(31 77 46 / 0.06); }
  @media (width >= 48rem) { .relay { flex-direction: row; align-items: center; justify-content: space-between; } }
  .statut { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.8rem; border-radius: 999px; font-size: 0.875rem; font-weight: 700; }
  .statut__dot { width: 0.5rem; height: 0.5rem; border-radius: 999px; background: currentColor; }
  .statut--cours { color: var(--color-status-ongoing); background: var(--color-status-ongoing-bg); }
  .statut--cours .statut__dot { background: var(--color-sun-strong); }
  .statut--fini { color: var(--color-forest); background: var(--color-forest-soft); }

  .fact { padding: 0.9rem 1rem; border-radius: 1rem; background: var(--color-mineral); }
  .fact__label { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-brand); }
  .fact__value { margin-top: 0.3rem; font-weight: 600; line-height: 1.45; color: var(--color-ink); }

  .volet { display: flex; gap: 0.85rem; align-items: flex-start; padding: 0.9rem 1rem; border-radius: 1rem; background: #fff; box-shadow: inset 0 0 0 1px var(--color-line); }
  .volet__icon { display: grid; place-items: center; flex-shrink: 0; width: 2.25rem; height: 2.25rem; border-radius: 0.7rem; color: var(--color-forest-deep); background: var(--color-sun); }

  .chip { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.35rem 0.8rem; border-radius: 999px; font-size: 0.8125rem; font-weight: 600; color: var(--color-forest); background: var(--color-forest-soft); box-shadow: inset 0 0 0 1px rgb(31 77 46 / 0.1); transition: color 0.2s, background-color 0.2s; }
  .chip:hover { color: #fff; background: var(--color-forest); }

  .resultats { margin-top: 1.5rem; padding: 0.9rem 1rem; border-radius: 1rem; font-size: 0.9375rem; background: var(--color-sun-soft); box-shadow: inset 0 0 0 1px rgb(224 168 0 / 0.25); }
  .resultats--attente { display: flex; gap: 0.6rem; color: var(--color-muted); }
  .resultats__title { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 700; color: var(--color-forest); }

  .fiche-link { display: inline-flex; align-items: center; gap: 0.6rem; margin-top: 1.75rem; font-weight: 700; color: var(--color-forest); }
  .fiche-link:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--color-sun); }

  .mini { position: relative; overflow: hidden; height: 100%; border-radius: var(--radius-card); background: #fff; box-shadow: inset 0 0 0 1px var(--color-line), var(--shadow-card); transition: box-shadow 0.3s, transform 0.3s var(--ease-out-soft); }
  .mini:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px rgb(31 77 46 / 0.25), var(--shadow-lift); }
  @media (prefers-reduced-motion: reduce) { .mini:hover { transform: none; } }
</style>
