---
/**
 * Accueil, section 7 : partenaires et collaborations — présentation sobre.
 * Uniquement des institutions ayant réellement confié une mission au cabinet (aucune référence ajoutée).
 * Affichage conditionné à leur accord écrit : voir features.homePartners dans src/config/site.ts.
 * Pour ajouter un partenaire : compléter la liste ci-dessous (et son logo, s'il est fourni et autorisé).
 */
import { Landmark, ArrowRight } from '@lucide/astro';
import { url } from '../../lib/url';

const partners = [
  {
    name: 'Commune de Za-Kpota',
    detail: 'Collectivité territoriale · Département du Zou',
    mission: '/realisations/missions-en-cours#mission-za-kpota-formation-pisciculture-maraichage',
  },
];
---
<section aria-labelledby="partenaires-title" class="border-t border-line bg-white py-16 sm:py-20">
  <div class="container-site">
    <div class="flex flex-col items-center text-center" data-reveal>
      <h2 id="partenaires-title" class="eyebrow-framed font-sans text-eyebrow uppercase text-brand">Partenaires et collaborations</h2>
      <p class="mt-4 max-w-xl text-lead text-muted">Ils ont confié une mission à Alkebulan Services et Conseils.</p>
    </div>
    <ul class="mt-10 flex flex-wrap justify-center gap-5" data-reveal>
      {partners.map((p) => (
        <li class="partner group">
          <span class="partner__icon"><Landmark size={24} stroke-width={1.75} aria-hidden="true" /></span>
          <span class="min-w-0">
            <span class="block font-display text-h4 text-forest">{p.name}</span>
            <span class="mt-0.5 block text-small text-muted">{p.detail}</span>
            <a href={url(p.mission)} class="partner__link">Voir la mission <ArrowRight size={15} aria-hidden="true" class="transition-transform duration-200 group-hover:translate-x-0.5" /></a>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: min(100%, 26rem);
    padding: 1.25rem 1.5rem;
    border-radius: 1.25rem;
    background: var(--color-mineral);
    box-shadow: inset 0 0 0 1px rgb(20 24 28 / 0.08);
  }
  .partner__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    color: var(--color-forest);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .partner__link { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 0.5rem; font-size: 0.875rem; font-weight: 700; color: var(--color-forest); }
  .partner__link:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--color-sun); }
</style>
