---
/**
 * Héro de l'accueil : photo plein format en arrière-plan + voile vert en dégradé, contenu centré.
 * Image : emplacement 'accueil.hero' de src/config/images.ts
 */
import SiteImage from '../ui/SiteImage.astro';
import Button from '../ui/Button.astro';
import { site } from '../../config/site';
---
<section aria-labelledby="hero-title" class="relative isolate flex min-h-[min(46rem,calc(100svh-4.5rem))] items-center overflow-hidden bg-forest-night text-white lg:min-h-[min(50rem,calc(100svh-5rem))]">
  <div class="absolute inset-0 -z-20"><SiteImage id="accueil.hero" sizes="100vw" priority /></div>
  <!-- Voile vert en dégradé : garantit la lisibilité du texte sur la photo -->
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgb(16_29_8/0.78)_0%,rgb(16_29_8/0.62)_40%,rgb(16_29_8/0.80)_75%,rgb(16_29_8/0.94)_100%)]"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_70%_60%_at_50%_45%,rgb(16_29_8/0.45),transparent_75%),radial-gradient(ellipse_55%_50%_at_100%_100%,rgb(174_36_69/0.28),transparent_70%)]"></div>

  <div class="container-site flex flex-col items-center py-20 text-center sm:py-24 lg:py-28">
    <p class="hero-in inline-flex items-center gap-3 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-eyebrow uppercase text-white backdrop-blur-sm" style="--d:0ms">
      <span aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-[#f3a9b8]"></span>
      Cabinet d'études et de conseil · Cotonou, Bénin
    </p>
    <h1 id="hero-title" class="hero-in mt-7 max-w-4xl text-display text-white [text-shadow:0_2px_24px_rgb(16_29_8/0.45)]" style="--d:80ms">
      Bâtir ensemble des territoires <span class="text-[#f3a9b8]">durables et résilients</span>
    </h1>
    <p class="hero-in mt-7 max-w-3xl text-lead text-white/90" style="--d:160ms">
      <strong class="font-semibold text-white">{site.name}</strong> accompagne les institutions publiques, les collectivités, les organisations et les entreprises face aux enjeux environnementaux, climatiques et territoriaux : du diagnostic des besoins aux solutions techniques adaptées, jusqu'à l'accompagnement de vos projets.
    </p>
    <div class="hero-in mt-10 flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:justify-center sm:gap-4" style="--d:240ms">
      <Button href={site.cta.href} size="lg" arrow>{site.cta.label}</Button>
      <Button href="/expertises" variant="light" size="lg">Découvrir nos expertises</Button>
    </div>
  </div>
</section>

<style>
  .hero-in {
    animation: hero-in 0.9s var(--ease-out-soft) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
</style>
