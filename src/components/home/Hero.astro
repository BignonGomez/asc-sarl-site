---
/**
 * Héro de l'accueil : photo plein format + voile vert en dégradé, motif ondulé discret,
 * apparition en cascade (badge, titre mot par mot, texte, boutons),
 * cartes de verre flottantes avec profondeur au défilement (grand écran uniquement).
 * Image : emplacement 'accueil.hero' de src/config/images.ts
 */
import { LayoutGrid, CalendarCheck, MapPin, Handshake } from '@lucide/astro';
import SiteImage from '../ui/SiteImage.astro';
import Button from '../ui/Button.astro';
import { site } from '../../config/site';

// Titre découpé en mots pour l'animation (les mots « accent » sont en rose)
const segments = [
  { text: 'Bâtir ensemble des territoires', accent: false },
  { text: 'durables et résilients', accent: true },
];
let wi = 0;
const words = segments.flatMap((s) => s.text.split(' ').map((w) => ({ w, accent: s.accent, i: wi++ })));

// Cartes flottantes : informations factuelles (protocole, RCCM)
const cards = [
  { icon: LayoutGrid, value: '8 domaines', label: "d'expertise", pos: 'fcard--a', depth: 0.18 },
  { icon: CalendarCheck, value: 'Fondé en 2025', label: 'SARL de droit béninois', pos: 'fcard--b', depth: 0.3 },
  { icon: MapPin, value: 'Cotonou, Bénin', label: 'Siège du cabinet', pos: 'fcard--c', depth: 0.12 },
  { icon: Handshake, value: 'Public et privé', label: 'Secteurs accompagnés', pos: 'fcard--d', depth: 0.24 },
];
---
<section aria-labelledby="hero-title" class="hero relative isolate flex min-h-[min(48rem,100svh)] items-center overflow-clip bg-forest-night text-white lg:min-h-[min(56rem,100svh)]" data-hero>
  <div class="absolute inset-0 -z-30"><SiteImage id="accueil.hero" sizes="100vw" priority /></div>
  <!-- Voile vert en dégradé : lisibilité du texte -->
  <div aria-hidden="true" class="absolute inset-0 -z-20 bg-[linear-gradient(180deg,rgb(16_29_8/0.80)_0%,rgb(16_29_8/0.64)_40%,rgb(16_29_8/0.82)_75%,rgb(16_29_8/0.95)_100%)]"></div>
  <div aria-hidden="true" class="absolute inset-0 -z-20 bg-[radial-gradient(ellipse_70%_60%_at_50%_45%,rgb(16_29_8/0.45),transparent_75%),radial-gradient(ellipse_55%_50%_at_100%_100%,rgb(174_36_69/0.30),transparent_70%),radial-gradient(ellipse_45%_45%_at_0%_0%,rgb(18_128_75/0.25),transparent_70%)]"></div>

  <!-- Motif décoratif : lignes ondulantes vertes très légères -->
  <svg aria-hidden="true" class="hero-waves pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-[70%] w-full" viewBox="0 0 1440 560" preserveAspectRatio="none" fill="none">
    <g stroke="currentColor" stroke-width="1.2">
      <path d="M0 420 C 240 360, 420 470, 720 400 S 1200 300, 1440 360" />
      <path d="M0 460 C 260 400, 440 510, 740 440 S 1210 340, 1440 400" />
      <path d="M0 500 C 280 440, 460 550, 760 480 S 1220 380, 1440 440" />
      <path d="M0 380 C 220 320, 400 430, 700 360 S 1190 260, 1440 320" />
      <path d="M0 340 C 200 280, 380 390, 680 320 S 1180 220, 1440 280" />
    </g>
  </svg>

  <div class="container-site relative z-10 flex flex-col items-center pb-20 pt-32 text-center sm:pb-24 sm:pt-36 lg:pb-28 lg:pt-40">
    <p class="hero-rise inline-flex items-center gap-3 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-eyebrow uppercase text-white backdrop-blur-sm" style="--d:50ms">
      <span aria-hidden="true" class="hero-pulse"></span>
      Cabinet d'études et de conseil · Cotonou, Bénin
    </p>

    <h1 id="hero-title" class="mt-7 max-w-[48rem] text-display text-white [text-shadow:0_2px_24px_rgb(16_29_8/0.45)]">
      {words.map(({ w, accent, i }) => (
        <>
          <span class="w"><span class:list={['wi', accent && 'text-flame']} style={`--wi:${i}`}>{w}</span></span>{' '}
        </>
      ))}
    </h1>

    <p class="hero-rise mt-7 max-w-3xl text-lead text-white/90" style="--d:520ms">
      <strong class="font-semibold text-white">{site.name}</strong> accompagne les institutions publiques, les collectivités, les organisations et les entreprises face aux enjeux environnementaux, climatiques et territoriaux : du diagnostic des besoins aux solutions techniques adaptées, jusqu'à l'accompagnement de vos projets.
    </p>
    <div class="hero-rise mt-10 flex w-full flex-col items-stretch gap-3 sm:w-auto sm:flex-row sm:justify-center sm:gap-4" style="--d:640ms">
      <Button href={site.cta.href} size="lg" arrow>{site.cta.label}</Button>
      <Button href="/expertises" variant="light" size="lg">Découvrir nos expertises</Button>
    </div>
  </div>

  <!-- Cartes de verre flottantes (décoratives : les mêmes informations figurent dans le bandeau) -->
  <div class="hero-float" aria-hidden="true">
    {cards.map((c, i) => (
      <div class:list={['fcard', c.pos]} data-depth={c.depth}>
        <div class="fcard__body" style={`--d:${900 + i * 140}ms`}>
          <span class="fcard__icon"><c.icon size={18} stroke-width={1.9} /></span>
          <span class="flex flex-col leading-tight">
            <span class="fcard__value">{c.value}</span>
            <span class="fcard__label">{c.label}</span>
          </span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  /* ---------- Cascade d'apparition ---------- */
  .hero-rise { animation: hero-rise 0.9s var(--ease-out-soft) var(--d, 0ms) both; }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  /* Pastille animée du badge */
  .hero-pulse { position: relative; width: 8px; height: 8px; border-radius: 999px; background: var(--color-flame); }
  .hero-pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-flame);
    animation: hero-pulse 2.4s var(--ease-out-soft) 3;
  }
  @keyframes hero-pulse { to { transform: scale(3); opacity: 0; } }

  /* ---------- Titre mot par mot ---------- */
  .w { display: inline-block; overflow: clip; overflow-clip-margin: 0.18em; vertical-align: top; }
  .wi {
    display: inline-block;
    animation: word-up 0.95s var(--ease-out-soft) both;
    animation-delay: calc(150ms + var(--wi) * 55ms);
  }
  @keyframes word-up { from { transform: translateY(108%); } to { transform: none; } }

  /* ---------- Motif ---------- */
  .hero-waves { color: rgb(195 214 181 / 0.10); }

  /* ---------- Cartes flottantes (grand écran) ---------- */
  .hero-float { display: none; position: absolute; inset: 0; z-index: 5; pointer-events: none; }
  @media (width >= 80rem) { .hero-float { display: block; } }
  .fcard { position: absolute; will-change: transform; }
  .fcard--a { top: 24%; left: 2%; }
  .fcard--b { top: 29%; right: 2%; }
  .fcard--c { bottom: 17%; left: 3.5%; }
  .fcard--d { bottom: 14%; right: 3%; }
  @media (width >= 90rem) {
    .fcard--a { left: 4%; } .fcard--b { right: 4%; } .fcard--c { left: 6%; } .fcard--d { right: 6%; }
  }
  .fcard__body {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 11.5rem;
    padding: 0.875rem 1.125rem 0.875rem 0.875rem;
    border-radius: 1.125rem;
    background: linear-gradient(150deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.05) 60%, rgb(255 255 255 / 0.09));
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    backdrop-filter: blur(14px) saturate(160%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.22), inset 0 0 0 1px rgb(255 255 255 / 0.14), 0 24px 50px -24px rgb(0 0 0 / 0.7);
    animation: card-in 1.1s var(--ease-out-soft) var(--d, 0ms) both;
  }
  .fcard__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.375rem;
    height: 2.375rem;
    border-radius: 0.75rem;
    color: #fff;
    background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.25), 0 8px 18px -8px rgb(174 36 69 / 0.8);
  }
  .fcard__value { font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: #fff; }
  .fcard__label { margin-top: 0.125rem; font-size: 0.78rem; color: rgb(255 255 255 / 0.75); }
  @keyframes card-in {
    from { opacity: 0; transform: translateY(24px) scale(0.96); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rise, .wi, .fcard__body, .hero-pulse::after { animation: none !important; }
  }
</style>

<script>
  // Profondeur au défilement (parallaxe) : les cartes défilent plus lentement que la page, comme des plans éloignés
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const cards = hero ? [...hero.querySelectorAll<HTMLElement>('.fcard[data-depth]')] : [];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const large = window.matchMedia('(min-width: 80rem)');
  if (hero && cards.length) {
    let ticking = false;
    const update = () => {
      ticking = false;
      if (reduce.matches || !large.matches) { cards.forEach((c) => (c.style.transform = '')); return; }
      const y = Math.min(window.scrollY, hero.offsetHeight);
      cards.forEach((c) => (c.style.transform = `translate3d(0, ${(y * Number(c.dataset.depth)).toFixed(1)}px, 0)`));
    };
    window.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    large.addEventListener('change', update);
    update();
  }
</script>
