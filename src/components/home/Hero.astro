---
/**
 * Héro de l'accueil : composition claire et aérée.
 * Texte à gauche (étiquette, titre mot par mot, filet soleil, introduction, deux actions),
 * photo de terrain à droite dans un cadre arrondi, sans voile sombre.
 * Les chiffres clés sont présentés juste après, dans le bandeau défilant.
 * Image : emplacement 'accueil.hero' de src/config/images.ts
 */
import SiteImage from '../ui/SiteImage.astro';
import Button from '../ui/Button.astro';
import { site } from '../../config/site';

// Titre découpé en mots pour l'animation (les mots « accent » sont en vert feuille)
const segments = [
  { text: 'Bâtir ensemble des territoires', accent: false },
  { text: 'durables et résilients', accent: true },
];
let wi = 0;
const words = segments.flatMap((s) => s.text.split(' ').map((w) => ({ w, accent: s.accent, i: wi++ })));
---
<section aria-labelledby="hero-title" class="hero relative isolate overflow-clip">
  <!-- Fond : blanc avec une lueur vert très pâle en haut à gauche et une touche soleil discrète -->
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_60%_70%_at_0%_0%,var(--color-mineral),transparent_70%),radial-gradient(ellipse_35%_40%_at_100%_100%,rgb(252_209_42/0.08),transparent_70%)]"></div>

  <div class="container-site grid items-center gap-12 pb-16 pt-32 sm:pt-36 lg:grid-cols-12 lg:gap-10 lg:pb-24 lg:pt-44">
    <div class="lg:col-span-6 xl:col-span-6">
      <p class="hero-rise inline-flex items-center gap-2.5 rounded-full bg-forest-soft px-4 py-2 text-eyebrow uppercase text-brand" style="--d:50ms">
        <span aria-hidden="true" class="hero-pulse"></span>
        Cabinet d'études et de conseil · Cotonou, Bénin
      </p>

      <h1 id="hero-title" class="mt-7 max-w-[34rem] text-display text-forest">
        {words.map(({ w, accent, i }) => (
          <>
            <span class="w"><span class:list={['wi', accent && 'text-leaf-strong']} style={`--wi:${i}`}>{w}</span></span>{' '}
          </>
        ))}
      </h1>

      <span aria-hidden="true" class="hero-rise mt-8 block h-1 w-14 rounded-full bg-sun" style="--d:460ms"></span>

      <p class="hero-rise mt-7 max-w-xl text-lead text-muted" style="--d:520ms">
        <strong class="font-semibold text-ink">{site.name}</strong> accompagne les institutions publiques, les collectivités, les organisations et les entreprises face aux enjeux environnementaux, climatiques et territoriaux : du diagnostic des besoins aux solutions techniques adaptées, jusqu'à l'accompagnement de vos projets.
      </p>
      <div class="hero-rise mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-4" style="--d:640ms">
        <Button href={site.cta.href} size="lg" arrow>{site.cta.label}</Button>
        <Button href="/expertises" variant="secondary" size="lg">Découvrir nos expertises</Button>
      </div>
    </div>

    <div class="hero-photo lg:col-span-6 xl:col-span-6">
      <div class="hero-photo__frame">
        <SiteImage id="accueil.hero" sizes="(min-width: 64rem) 50vw, 100vw" priority />
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Cascade d'apparition ---------- */
  .hero-rise { animation: hero-rise 0.9s var(--ease-out-soft) var(--d, 0ms) both; }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  /* Pastille animée de l'étiquette */
  .hero-pulse { position: relative; width: 8px; height: 8px; border-radius: 999px; background: var(--color-sun-strong); }
  .hero-pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-sun);
    animation: hero-pulse 2.4s var(--ease-out-soft) 3;
  }
  @keyframes hero-pulse { to { transform: scale(3); opacity: 0; } }

  /* ---------- Titre mot par mot ---------- */
  .w { display: inline-block; overflow: clip; overflow-clip-margin: 0.18em; vertical-align: top; }
  .wi {
    display: inline-block;
    animation: word-up 0.95s var(--ease-out-soft) both;
    animation-delay: calc(150ms + var(--wi) * 55ms);
  }
  @keyframes word-up { from { transform: translateY(108%); } to { transform: none; } }

  /* ---------- Photo ---------- */
  .hero-photo { position: relative; animation: photo-in 1.2s var(--ease-out-soft) 250ms both; }
  /* Aplat vert très pâle décalé derrière la photo : profondeur sans surcharge */
  .hero-photo::before {
    content: '';
    position: absolute;
    inset: 1.5rem -1rem -1rem 1.5rem;
    z-index: -1;
    border-radius: 2.5rem 2.5rem 2.5rem 8rem;
    background: var(--color-forest-soft);
  }
  .hero-photo__frame {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: 2rem 2rem 2rem 7rem;
    box-shadow: var(--shadow-lift);
  }
  @media (width >= 64rem) {
    .hero-photo__frame { aspect-ratio: 5 / 5.2; border-radius: 2.5rem 2.5rem 2.5rem 11rem; }
    .hero-photo::before { inset: 2rem -1.5rem -1.5rem 2rem; border-radius: 2.5rem 2.5rem 2.5rem 12rem; }
  }
  @keyframes photo-in {
    from { opacity: 0; transform: translateY(24px) scale(0.98); }
    to { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-rise, .wi, .hero-photo, .hero-pulse::after { animation: none !important; }
  }
</style>
