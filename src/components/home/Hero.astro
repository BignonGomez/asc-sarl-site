---
import Button from '../ui/Button.astro';
import PhotoPlaceholder from '../ui/PhotoPlaceholder.astro';
import { site } from '../../config/site';
---
<section aria-labelledby="hero-title" class="relative isolate overflow-hidden bg-forest-night text-white">
  <!-- Décor : courbes de niveau (évoquent les territoires), purement décoratif -->
  <svg aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 h-full w-full text-forest-mist opacity-[0.09]" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice" fill="none" stroke="currentColor" stroke-width="1.2">
    <path d="M-50 620 C 180 540, 320 700, 560 610 S 900 470, 1260 560" />
    <path d="M-50 560 C 200 470, 330 640, 580 540 S 920 400, 1260 490" />
    <path d="M-50 500 C 220 400, 340 580, 600 470 S 940 330, 1260 420" />
    <path d="M-50 440 C 240 330, 350 520, 620 400 S 960 260, 1260 350" />
    <path d="M-50 380 C 260 260, 360 460, 640 330 S 980 190, 1260 280" />
    <path d="M-50 320 C 280 190, 370 400, 660 260 S 1000 120, 1260 210" />
    <path d="M-50 260 C 300 120, 380 340, 680 190 S 1020 50, 1260 140" />
    <path d="M-50 200 C 320 50, 390 280, 700 120 S 1040 -20, 1260 70" />
  </svg>
  <div aria-hidden="true" class="absolute inset-0 -z-20 bg-[radial-gradient(ellipse_80%_70%_at_85%_20%,rgb(35_67_18/0.85),transparent_70%),radial-gradient(ellipse_60%_60%_at_0%_100%,rgb(174_36_69/0.22),transparent_70%)]"></div>

  <div class="container-site grid items-center gap-12 pb-16 pt-14 sm:pt-20 lg:grid-cols-12 lg:gap-10 lg:pb-24 lg:pt-28">
    <div class="lg:col-span-7">
      <p class="hero-in inline-flex items-center gap-3 text-eyebrow uppercase text-forest-mist" style="--d:0ms">
        <span aria-hidden="true" class="h-px w-8 bg-brand"></span>
        Cabinet d'études et de conseil · Cotonou, Bénin
      </p>
      <h1 id="hero-title" class="hero-in mt-6 text-display text-white" style="--d:80ms">
        Des études et des conseils pour des territoires <span class="text-[#f3a9b8]">durables et résilients</span>
      </h1>
      <p class="hero-in mt-7 max-w-2xl text-lead text-white/80" style="--d:160ms">
        Cabinet béninois d'études et de conseil, ASC SARL accompagne les acteurs publics et privés face aux enjeux environnementaux, climatiques et de développement territorial : analyse des besoins, études, solutions techniques adaptées et accompagnement des projets.
      </p>
      <div class="hero-in mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:gap-4" style="--d:240ms">
        <Button href={site.cta.href} size="lg" arrow>{site.cta.label}</Button>
        <Button href="/expertises" variant="light" size="lg">Découvrir nos expertises</Button>
      </div>
    </div>

    <div class="hero-in lg:col-span-5" style="--d:320ms">
      <PhotoPlaceholder tone="dark" context="Photographie de terrain (ex. site d'Allahé, avec l'accord de la commune)" class="aspect-[4/3] rounded-card lg:aspect-[4/5]" />
    </div>
  </div>

  <!-- Repères factuels (sources : RCCM, protocole) -->
  <div class="border-t border-white/10">
    <dl class="container-site grid gap-6 py-8 text-small sm:grid-cols-3 sm:gap-8">
      <div class="hero-in" style="--d:380ms">
        <dt class="font-display text-h4 text-white">Société de droit béninois</dt>
        <dd class="mt-1 text-white/65">SARL immatriculée à Cotonou en 2025</dd>
      </div>
      <div class="hero-in sm:border-l sm:border-white/10 sm:pl-8" style="--d:440ms">
        <dt class="font-display text-h4 text-white">Huit domaines d'expertise</dt>
        <dd class="mt-1 text-white/65">De l'environnement au développement local</dd>
      </div>
      <div class="hero-in sm:border-l sm:border-white/10 sm:pl-8" style="--d:500ms">
        <dt class="font-display text-h4 text-white">Acteurs publics et privés</dt>
        <dd class="mt-1 text-white/65">Administrations, collectivités, organisations, entreprises</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .hero-in {
    animation: hero-in 0.9s var(--ease-out-soft) both;
    animation-delay: var(--d, 0ms);
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(14px); }
    to { opacity: 1; transform: none; }
  }
</style>
