---
/**
 * Héro de l'accueil : illustration en arrière-plan sur toute la surface (cover, centrée),
 * voile vert sombre à gauche pour la lisibilité du texte (sur toute la surface sur mobile).
 * Texte à gauche (étiquette, titre mot par mot, filet soleil, introduction, deux actions, chiffres clés).
 * Image propre à l'accueil : public/images/hero-accueil.svg (les autres pages gardent leur en-tête, PageHeader).
 */
import Button from '../ui/Button.astro';
import { site } from '../../config/site';
import { url } from '../../lib/url';

// Titre découpé en mots pour l'animation (les mots « accent » sont en vert feuille)
const segments = [
  { text: 'Bâtir ensemble des territoires', accent: false },
  { text: 'durables et résilients', accent: true },
];
// Chiffres clés : uniquement des faits vérifiables (protocole, RCCM)
const facts = [
  { value: '8', label: "domaines d'expertise" },
  { value: '2025', label: 'création à Cotonou' },
  { value: 'SARL', label: 'de droit béninois' },
];
let wi = 0;
const words = segments.flatMap((s) => s.text.split(' ').map((w) => ({ w, accent: s.accent, i: wi++ })));
---
<section aria-labelledby="hero-title" class="hero relative isolate overflow-clip bg-forest-night text-white">
  <!-- Arrière-plan : illustration sur toute la surface du héro (décorative) -->
  <img src={url('/images/hero-accueil.svg')} alt="" width="1600" height="900" fetchpriority="high" decoding="async" class="absolute inset-0 -z-20 h-full w-full object-cover object-center" />
  <!-- Voile sombre à gauche : lisibilité du texte -->
  <div aria-hidden="true" class="veil-left absolute inset-0 -z-10"></div>

  <div class="container-site grid items-center gap-12 pb-16 pt-32 sm:pt-36 lg:grid-cols-12 lg:gap-10 lg:pb-20 lg:pt-36">
    <div class="lg:col-span-6 xl:col-span-6">
      <p class="hero-rise inline-flex items-center gap-2.5 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-eyebrow uppercase text-white backdrop-blur-sm" style="--d:50ms">
        <span aria-hidden="true" class="hero-pulse"></span>
        Cabinet d'études et de conseil · Cotonou, Bénin
      </p>

      <h1 id="hero-title" class="mt-7 max-w-[34rem] text-display text-white [text-shadow:0_2px_20px_rgb(15_38_24/0.35)]">
        {words.map(({ w, accent, i }) => (
          <>
            <span class="w"><span class:list={['wi', accent && 'text-leaf-light']} style={`--wi:${i}`}>{w}</span></span>{' '}
          </>
        ))}
      </h1>

      <span aria-hidden="true" class="hero-rise mt-8 block h-[3px] w-10 rounded-full bg-sun" style="--d:460ms"></span>

      <p class="hero-rise mt-7 max-w-[34rem] text-lead text-white/90" style="--d:520ms">
        <strong class="font-semibold text-white">{site.name}</strong> accompagne les institutions publiques, les collectivités, les organisations et les entreprises face aux enjeux environnementaux, climatiques et territoriaux : du diagnostic des besoins aux solutions techniques adaptées, jusqu'à l'accompagnement de vos projets.
      </p>
      <div class="hero-rise mt-10 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:gap-4" style="--d:640ms">
        <Button href={site.cta.href} size="lg" arrow>{site.cta.label}</Button>
        <Button href="/expertises" variant="light" size="lg">Découvrir nos expertises</Button>
      </div>

      <dl class="hero-rise mt-10 grid max-w-xl grid-cols-3 gap-4 border-t border-white/20 pt-7 sm:gap-6" style="--d:760ms">
        {facts.map((f) => (
          <div class="flex flex-col">
            <dt class="order-2 mt-1 text-[0.8125rem] leading-snug text-white/75 sm:text-small">{f.label}</dt>
            <dd class="order-1 font-display text-[1.375rem] font-bold leading-tight text-white sm:text-[1.75rem]">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>

  </div>
</section>

<style>
  /* ---------- Cascade d'apparition ---------- */
  .hero-rise { animation: hero-rise 0.9s var(--ease-out-soft) var(--d, 0ms) both; }
  @keyframes hero-rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }

  /* Pastille animée de l'étiquette */
  .hero-pulse { position: relative; width: 8px; height: 8px; border-radius: 999px; background: var(--color-sun-strong); }
  .hero-pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--color-sun);
    animation: hero-pulse 2.4s var(--ease-out-soft) 3;
  }
  @keyframes hero-pulse { to { transform: scale(3); opacity: 0; } }

  /* ---------- Titre mot par mot ---------- */
  .w { display: inline-block; overflow: clip; overflow-clip-margin: 0.18em; vertical-align: top; }
  .wi {
    display: inline-block;
    animation: word-up 0.95s var(--ease-out-soft) both;
    animation-delay: calc(150ms + var(--wi) * 55ms);
  }
  @keyframes word-up { from { transform: translateY(108%); } to { transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .hero-rise, .wi, .hero-pulse::after { animation: none !important; }
  }
</style>
