---
/**
 * Bandeau défilant (type « titres d'actualité ») placé sous le héro.
 * Défilement continu de droite à gauche, en boucle ; pause au survol et au focus ;
 * affichage fixe (sans mouvement) si l'utilisateur a demandé de réduire les animations.
 */
const items = [
  'Société de droit béninois',
  'SARL immatriculée à Cotonou en 2025',
  "Huit domaines d'expertise",
  "De l'environnement au développement local",
  'Acteurs publics et privés',
  'Administrations, collectivités, organisations, entreprises',
];
---
<section aria-label="Le cabinet en bref" class="bandeau relative overflow-hidden border-b border-line bg-white" tabindex="0">
  <!-- Fondu sur les bords -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-white to-transparent sm:w-24"></div>
  <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-white to-transparent sm:w-24"></div>

  <div class="bandeau-track flex w-max">
    {[0, 1].map((copy) => (
      <ul class="bandeau-list flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
        {items.map((item) => (
          <li class="flex items-center whitespace-nowrap py-4 font-display text-[0.9375rem] font-semibold tracking-[0.01em] text-brand sm:py-5 sm:text-base">
            <span class="px-6 sm:px-8">{item}</span>
            <span aria-hidden="true" class="h-2 w-2 rotate-45 rounded-[1px] bg-forest/70"></span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  .bandeau-track {
    animation: bandeau 45s linear infinite;
  }
  .bandeau:hover .bandeau-track,
  .bandeau:focus-within .bandeau-track,
  .bandeau:focus .bandeau-track {
    animation-play-state: paused;
  }
  @keyframes bandeau {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Réduire les animations : liste fixe, centrée, sur plusieurs lignes */
  @media (prefers-reduced-motion: reduce) {
    .bandeau-track {
      animation: none !important;
      width: 100%;
      justify-content: center;
    }
    .bandeau-list { flex-shrink: 1; width: 100%; flex-wrap: wrap; justify-content: center; padding: 0.5rem var(--spacing-gutter); }
    .bandeau-list[aria-hidden='true'] { display: none; }
    .bandeau-list li { padding-block: 0.375rem; white-space: normal; }
    .bandeau-list li:last-child > span:last-child { display: none; }
    .bandeau > div[aria-hidden='true'] { display: none; }
  }
  @media (prefers-reduced-motion: reduce) and (width < 40rem) {
    .bandeau-list li > span:last-child { display: none; }
    .bandeau-list li > span:first-child { padding-inline: 0; text-align: center; }
    .bandeau-list { flex-direction: column; gap: 0.125rem; }
  }
</style>
