---
/**
 * Accueil, section 6 : dernières actualités publiées (src/content/actualites).
 * Même carte que la rubrique Actualités (ArticleCard) pour une présentation homogène.
 * Mise en page : introduction à gauche, une ou deux publications à droite selon le nombre disponible.
 */
import SectionHeading from '../ui/SectionHeading.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import ArticleCard from '../actualites/ArticleCard.astro';
import { getActualites } from '../../lib/actualites';
const latest = (await getActualites()).slice(0, 2);
---
{latest.length > 0 && (
  <section aria-labelledby="actualites-title" class="section-y bg-white">
    <div class="container-site grid gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-4">
        <SectionHeading id="actualites-title" title="Actualités" intro="La vie du cabinet, ses partenariats, ses rencontres et ses nouvelles prestations." />
        <div class="mt-8" data-reveal><ArrowLink href="/actualites">Toutes les actualités</ArrowLink></div>
      </div>
      <ul class:list={['grid gap-6 lg:col-span-8', latest.length > 1 && 'sm:grid-cols-2']}>
        {latest.map((a, i) => (
          <li data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <ArticleCard slug={a.id} title={a.data.title} date={a.data.date} category={a.data.category} summary={a.data.summary} cover={a.data.cover} headingLevel="h3" horizontal={latest.length === 1} />
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
