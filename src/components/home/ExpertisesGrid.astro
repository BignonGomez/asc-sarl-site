---
import { ArrowRight } from '@lucide/astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ExpertiseIcon from '../ui/ExpertiseIcon.astro';
import SiteImage from '../ui/SiteImage.astro';
import { expertises } from '../../data/expertises';
import { url } from '../../lib/url';
---
<section aria-labelledby="expertises-title" class="section-y bg-mineral">
  <div class="container-site">
    <SectionHeading id="expertises-title" title="Nos domaines d'expertise" />
    <ul class="mt-14 grid gap-5 sm:grid-cols-2 lg:mt-16 lg:grid-cols-4 lg:gap-6">
      {expertises.map((e, i) => (
        <li data-reveal style={`--reveal-delay:${(i % 4) * 70}ms`}>
          <article class="card group relative flex h-full flex-col overflow-hidden rounded-card border border-line bg-white shadow-card transition-[border-color,box-shadow,transform] duration-300 hover:-translate-y-1 hover:border-forest/40 hover:shadow-lift">
            <div class="aspect-[16/10] overflow-hidden bg-mineral">
              <SiteImage id={`expertise.${e.slug}` as any} sizes="(min-width: 64rem) 18rem, (min-width: 40rem) 50vw, 100vw" class="transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.04]" />
            </div>
            <div class="flex flex-1 flex-col px-6 pb-6">
              <span class="relative -mt-6 mb-5 inline-flex size-12 items-center justify-center rounded-ui border border-line bg-white text-forest shadow-card transition-colors duration-300 group-hover:border-forest group-hover:bg-forest group-hover:text-white">
                <ExpertiseIcon name={e.icon} size={22} />
              </span>
              <h3 class="text-h4 text-forest">
                <a href={url(`/expertises/${e.slug}`)} class="after:absolute after:inset-0 focus-visible:outline-none">{e.title}</a>
              </h3>
              <p class="mt-3 flex-1 text-small text-muted">{e.summary}</p>
              <span aria-hidden="true" class="mt-6 inline-flex items-center gap-2 text-small font-semibold text-forest">
                En savoir plus <ArrowRight size={16} class="transition-transform duration-200 group-hover:translate-x-1" />
              </span>
            </div>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* Anneau de focus visible sur toute la carte quand son lien est sélectionné au clavier */
  .card:has(a:focus-visible) { outline: 2px solid var(--color-brand); outline-offset: 3px; }
</style>
