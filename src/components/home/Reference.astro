---
/**
 * Accueil, section 5 : référence, sous forme de fiche de mission (contexte, méthode, livrables).
 * Une seule mission réelle (src/data/missions.ts). Règles appliquées :
 * - nom de la collectivité commanditaire MASQUÉ (autorisation de publication non obtenue au 19/11/2026),
 *   ainsi que le nom de la localité du site ; lieu limité au département ;
 * - noms des membres de l'équipe MASQUÉS (accords écrits non obtenus) ;
 * - aucun livrable ni résultat annoncé tant que la mission est en cours ;
 * - pas de photo de groupe : carte de localisation (Natural Earth, src/assets/carte-benin.svg).
 * Pour publier le nom quand l'autorisation sera obtenue : passer `clientPublie` à true.
 */
import SectionHead from '../ui/SectionHead.astro';
import { missions } from '../../data/missions';
import { expertises } from '../../data/expertises';
import carte from '../../assets/carte-benin.svg?raw';

const clientPublie = false;
const m = missions[0];
const domaines = m.domains.map((s) => expertises.find((e) => e.slug === s)?.title).filter(Boolean);
const commanditaire = clientPublie ? m.client : 'Collectivité territoriale béninoise';
const lieu = clientPublie ? m.place : 'Département du Zou, Bénin';
const statut = m.status === 'en-cours' ? 'En cours' : 'Achevée';
const notifie = m.period[0]; // « Contrat notifié le 23 juillet 2026 »
---
<section aria-labelledby="reference-title" class="section-y">
  <div class="container-site">
    <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
    <SectionHead id="reference-title" index="03" label="Références" title="Mission en cours" />

    <article class="fiche mt-12 lg:mt-16" data-reveal aria-labelledby="fiche-title">
      <div class="fiche__body">
        <p class="fiche__tag text-eyebrow uppercase">
          <span>Fiche 01</span>
          <span class="fiche__status"><span aria-hidden="true" class="fiche__dot"></span>{statut}</span>
        </p>
        <h3 id="fiche-title" class="fiche__title">{m.title}</h3>

        <dl class="fiche__meta">
          <div><dt>Maître d'ouvrage</dt><dd>{commanditaire}</dd></div>
          <div><dt>Lieu</dt><dd>{lieu}</dd></div>
          <div><dt>Calendrier</dt><dd>{notifie}{m.duration && <> · durée contractuelle {m.duration}</>}</dd></div>
          <div><dt>Domaines</dt><dd>{domaines.join(' · ')}</dd></div>
        </dl>

        <div class="fiche__cols">
          <section aria-labelledby="fiche-contexte">
            <h4 id="fiche-contexte" class="fiche__h">Contexte</h4>
            <p>
              Programme commandé par une collectivité territoriale : formation de {m.volets[0].public.split(',')[0].toLowerCase()} à la production piscicole et maraîchère intégrée, et renforcement des capacités des responsables de filières agricoles, dans une perspective d'agriculture résiliente aux changements climatiques.
            </p>
          </section>
          <section aria-labelledby="fiche-methode">
            <h4 id="fiche-methode" class="fiche__h">Méthode</h4>
            <ul class="fiche__list">
              <li><strong>{m.volets[0].title}</strong> : théorie et pratique sur site aménagé ; {m.volets[0].items.map((x) => x.toLowerCase()).join(', ')}.</li>
              <li><strong>{m.volets[1].title}</strong> : {m.volets[1].items.map((x) => x.toLowerCase()).join(', ')}.</li>
            </ul>
          </section>
          <section aria-labelledby="fiche-livrables">
            <h4 id="fiche-livrables" class="fiche__h">Livrables</h4>
            <p class="text-muted">Publiés à l'achèvement de la mission.</p>
          </section>
        </div>
      </div>

      <figure class="fiche__map">
        <div class="fiche__map-svg" set:html={carte} />
        <figcaption class="text-eyebrow uppercase">Localisation · Natural Earth</figcaption>
      </figure>
    </article>
  </div>
</section>

<style>
  .fiche { display: grid; gap: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--color-ink); }
  .fiche__tag { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; color: var(--color-muted); }
  .fiche__status { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-accent-text); }
  .fiche__dot { width: 0.5rem; height: 0.5rem; border-radius: 999px; background: var(--color-accent); }
  .fiche__title { margin-top: 1rem; max-width: 34ch; font-size: var(--text-h3); line-height: var(--text-h3--line-height); letter-spacing: var(--text-h3--letter-spacing); font-weight: 500; color: var(--color-ink); }
  .fiche__meta { margin-top: 2rem; display: grid; gap: 0; border-top: 1px solid var(--color-line); }
  .fiche__meta > div { display: grid; gap: 0.25rem; padding: 0.85rem 0; border-bottom: 1px solid var(--color-line); }
  .fiche__meta dt { font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); }
  .fiche__meta dd { font-size: 0.9375rem; color: var(--color-ink); }
  .fiche__cols { margin-top: 2.25rem; display: grid; gap: 1.75rem; font-size: 0.9375rem; line-height: 1.65; color: var(--color-ink-soft); }
  .fiche__h { margin-bottom: 0.6rem; font-family: var(--font-mono); font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--text-eyebrow--letter-spacing); text-transform: uppercase; color: var(--color-accent-text); }
  .fiche__list { display: grid; gap: 0.6rem; }
  .fiche__list strong { font-weight: 600; color: var(--color-ink); }
  .fiche__map { margin: 0; align-self: start; max-width: 26rem; }
  .fiche__map-svg :global(svg) { display: block; width: 100%; height: auto; }
  .fiche__map figcaption { margin-top: 0.75rem; color: var(--color-muted); }

  .fiche__map :global(.cb-grid) { fill: none; stroke: var(--color-map-grid); stroke-width: 0.75; }
  .fiche__map :global(.cb-neighbors) { fill: none; stroke: var(--color-line-strong); stroke-width: 0.75; }
  .fiche__map :global(.cb-country) { fill: var(--color-surface); stroke: var(--color-ink); stroke-width: 1.2; stroke-linejoin: round; }
  .fiche__map :global(text) { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.04em; fill: var(--color-muted); }
  .fiche__map :global(.cb-sea) { font-style: italic; fill: var(--color-map-water); }
  .fiche__map :global(.cb-pt--siege circle) { fill: var(--color-ink); }
  .fiche__map :global(.cb-pt--siege text) { fill: var(--color-ink); }
  .fiche__map :global(.cb-pt--mission rect) { fill: var(--color-accent); }
  .fiche__map :global(.cb-pt--mission text) { fill: var(--color-accent-text); font-weight: 500; }
  .fiche__map :global(.cb-ring) { fill: none; stroke: var(--color-accent); stroke-width: 1; opacity: 0.45; }

  @media (width >= 48rem) {
    .fiche__meta { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
    .fiche__cols { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; }
  }
  @media (width >= 64rem) {
    .fiche { grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 4rem; }
    .fiche__map { justify-self: end; }
  }
</style>
