---
/**
 * Accueil, section 6 : équipe.
 * Les fiches individuelles (titre, diplôme, domaine technique) attendent l'accord écrit de chaque personne :
 * au 19/11/2026 cet accord n'est pas obtenu, la section présente donc uniquement les familles de compétences
 * déjà publiées (src/data/equipe.ts, recommandation R5), sans nom ni diplôme.
 * Pour afficher les fiches : passer publication.equipe à true (src/config/site.ts).
 */
import SectionHead from '../ui/SectionHead.astro';
import ArrowLink from '../ui/ArrowLink.astro';
import { competences, team } from '../../data/equipe';
import { publication } from '../../config/site';

const accordsObtenus = publication.equipe;
// Profils techniques d'abord (recommandation validée de l'audit)
const ordre = ['Environnement et changements climatiques', 'Agronomie et développement rural', 'Accompagnement des collectivités', 'Communication et sociologie du développement'];
const familles = [...competences].sort((a, b) => ordre.indexOf(a.label) - ordre.indexOf(b.label));
---
<section aria-labelledby="equipe-title" class="section-y">
  <div class="container-site">
    <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
    <SectionHead
      id="equipe-title"
      index="04"
      label="Équipe"
      title="Des équipes constituées selon chaque mission"
      intro="Le cabinet adapte la composition de ses équipes et ses méthodes à la nature de chaque mission et au contexte de chaque territoire."
    />

    {accordsObtenus ? (
      <ul class="equipe mt-12 lg:mt-16" data-reveal>
        {team.map((p) => (
          <li class="membre">
            <p class="membre__role">{p.role}</p>
            <p class="membre__name">{p.firstName} {p.lastName}</p>
            {p.degree && <p class="membre__meta">{p.degree}</p>}
            <p class="membre__meta">{p.specialty}</p>
          </li>
        ))}
      </ul>
    ) : (
      <ul class="equipe mt-12 lg:mt-16" data-reveal>
        {familles.map((c, i) => (
          <li class="membre">
            <p class="membre__role">Compétence {String(i + 1).padStart(2, '0')}</p>
            <p class="membre__name">{c.label}</p>
          </li>
        ))}
      </ul>
    )}

    <div class="mt-10" data-reveal>
      <ArrowLink href="/cabinet/equipe">Notre équipe</ArrowLink>
    </div>
  </div>
</section>

<style>
  .equipe { display: grid; border-top: 1px solid var(--color-line); }
  .membre { padding: 1.5rem 0; border-bottom: 1px solid var(--color-line); }
  .membre__role { font-family: var(--font-mono); font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--text-eyebrow--letter-spacing); text-transform: uppercase; color: var(--color-muted); }
  .membre__name { margin-top: 0.6rem; font-size: 1.125rem; font-weight: 500; letter-spacing: -0.01em; line-height: 1.3; color: var(--color-ink); }
  .membre__meta { margin-top: 0.35rem; font-size: 0.9375rem; color: var(--color-muted); }
  @media (width >= 48rem) {
    .equipe { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .membre { padding: 1.75rem 2rem 1.75rem 0; }
    .membre:nth-child(2n) { padding-left: 2rem; border-left: 1px solid var(--color-line); }
  }
  @media (width >= 64rem) {
    .equipe { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .membre { padding: 2rem 1.75rem 2.25rem; border-left: 1px solid var(--color-line); }
    .membre:nth-child(2n) { padding-left: 1.75rem; }
    .membre:first-child { padding-left: 0; border-left: 0; }
  }
</style>
