---
/**
 * Vue d'ensemble des prestations en deux familles (recommandation R4), refonte étape 5.
 * Générée à partir de src/data/expertises-pages.ts (champ `family`) : aucune prestation n'est saisie ici.
 * Les totaux ne sont pas affichés (chiffres non validés).
 */
import SectionHead from '../ui/SectionHead.astro';
import { expertises } from '../../data/expertises';
import { domainPages, prestationFamilies } from '../../data/expertises-pages';
import { url } from '../../lib/url';

interface Props { index?: string }
const { index = '02' } = Astro.props;

const families = prestationFamilies.map((f) => {
  const groups = expertises
    .map((e) => {
      const page = domainPages.find((d) => d.slug === e.slug);
      const all = [...(page?.prestations ?? []), ...(page?.prestationGroups?.flatMap((g) => g.items) ?? [])];
      const titles = [...new Set(all.filter((p) => p.family === f.id).map((p) => p.title))];
      return { domain: e, n: expertises.indexOf(e) + 1, titles };
    })
    .filter((g) => g.titles.length > 0);
  return { ...f, groups };
});
---
<section id="familles" aria-labelledby="familles-title" class="section-y scroll-mt-28">
  <div class="container-site">
    <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
    <SectionHead
      id="familles-title"
      index={index}
      label="Familles"
      title="Les prestations, en deux familles"
      intro="Les prestations de nos huit domaines, regroupées par nature. Une même mission peut associer les deux."
    />

    <div class="familles mt-12 lg:mt-16">
      {families.map((f) => (
        <article aria-labelledby={`famille-${f.id}`} class="famille" data-reveal>
          <h3 id={`famille-${f.id}`} class="famille__title">{f.title}</h3>
          <p class="famille__intro">{f.intro}</p>
          <ul class="famille__groups">
            {f.groups.map((g) => (
              <li class="famille__group">
                <a href={url(`/expertises/${g.domain.slug}`)} class="famille__domain">
                  <span class="famille__n">{String(g.n).padStart(2, '0')}</span>{g.domain.title}
                </a>
                <ul class="famille__items">
                  {g.titles.map((t) => <li>{t}</li>)}
                </ul>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .familles { display: grid; gap: 3rem; }
  .famille { padding-top: 1.5rem; border-top: 1px solid var(--color-ink); }
  .famille__title { font-size: var(--text-h3); line-height: var(--text-h3--line-height); letter-spacing: var(--text-h3--letter-spacing); font-weight: 500; color: var(--color-ink); }
  .famille__intro { margin-top: 0.5rem; font-size: 0.9375rem; color: var(--color-muted); }
  .famille__groups { margin-top: 1.75rem; border-top: 1px solid var(--color-line); }
  .famille__group { padding: 1.1rem 0; border-bottom: 1px solid var(--color-line); }
  .famille__domain { display: inline-flex; gap: 0.75rem; font-weight: 500; color: var(--color-ink); transition: color 0.2s; }
  .famille__domain:hover { color: var(--color-accent-text); }
  .famille__n { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-accent-text); padding-top: 0.2rem; }
  .famille__items { margin-top: 0.5rem; padding-left: 2.1rem; display: grid; gap: 0.3rem; font-size: 0.9375rem; color: var(--color-muted); }
  @media (width >= 64rem) {
    .familles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4rem; }
  }
</style>
