---
/**
 * Vue d'ensemble des prestations en deux familles (recommandation R4 du rapport d'analyse comparative).
 * Générée à partir de src/data/expertises-pages.ts (champ `family` de chaque prestation) :
 * aucune prestation n'est saisie ici, la liste reste identique à celle des pages de domaine.
 * Tout est visible (pas de contenu masqué), regroupé par domaine avec un lien vers chaque page.
 */
import { FileSearch, Handshake } from '@lucide/astro';
import SectionHeading from '../ui/SectionHeading.astro';
import ExpertiseIcon from '../ui/ExpertiseIcon.astro';
import { expertises } from '../../data/expertises';
import { domainPages, prestationFamilies } from '../../data/expertises-pages';
import { url } from '../../lib/url';

const families = prestationFamilies.map((f) => {
  const groups = expertises
    .map((e) => {
      const page = domainPages.find((d) => d.slug === e.slug);
      // Prestations simples + prestations regroupées par public (ex. économie locale)
      const all = [...(page?.prestations ?? []), ...(page?.prestationGroups?.flatMap((g) => g.items) ?? [])];
      const titles = [...new Set(all.filter((p) => p.family === f.id).map((p) => p.title))];
      return { domain: e, titles };
    })
    .filter((g) => g.titles.length > 0);
  return { ...f, groups, count: groups.reduce((n, g) => n + g.titles.length, 0) };
});
---
<section id="prestations" aria-labelledby="prestations-title" class="section-y scroll-mt-24 bg-white">
  <div class="container-site">
    <SectionHeading
      id="prestations-title"
      title="Nos prestations en un coup d'œil"
      intro="Les prestations de nos huit domaines, regroupées en deux familles. Chaque mission peut associer les deux."
    />

    <div class="mt-12 grid gap-6 lg:mt-14 lg:grid-cols-2 lg:gap-8">
      {families.map((f) => (
        <article aria-labelledby={`famille-${f.id}`} class="famille" data-reveal>
          <header class="famille__head">
            <span class="famille__icon">
              {f.id === 'etudes' ? <FileSearch size={22} aria-hidden="true" /> : <Handshake size={22} aria-hidden="true" />}
            </span>
            <div>
              <h3 id={`famille-${f.id}`} class="text-h3 leading-snug text-forest">{f.title}</h3>
              <p class="mt-1.5 text-[0.9375rem] text-muted">{f.intro}</p>
            </div>
          </header>
          <p class="famille__count">{f.count} prestations · {f.groups.length} domaines</p>

          <ul class="famille__groups">
            {f.groups.map((g) => (
              <li class="groupe">
                <a href={url(`/expertises/${g.domain.slug}`)} class="groupe__domain">
                  <ExpertiseIcon name={g.domain.icon} size={15} />
                  <span>{g.domain.title}</span>
                </a>
                <ul class="groupe__list">
                  {g.titles.map((t) => <li>{t}</li>)}
                </ul>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .famille {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-radius: 1.5rem;
    background: #fff;
    border-top: 4px solid var(--color-sun);
    box-shadow: inset 0 0 0 1px var(--color-line), var(--shadow-card);
  }
  .famille__head { display: flex; gap: 1rem; align-items: flex-start; }
  .famille__icon { display: grid; place-items: center; flex-shrink: 0; width: 3rem; height: 3rem; border-radius: 0.9rem; color: var(--color-forest-deep); background: var(--color-sun); }
  .famille__count { margin-top: 1.25rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-brand); }
  .famille__groups { display: grid; gap: 0.75rem; margin-top: 1rem; }

  .groupe { padding: 1rem 1.1rem; border-radius: 1rem; background: var(--color-mineral); }
  .groupe__domain { display: inline-flex; align-items: center; gap: 0.45rem; font-family: var(--font-display); font-size: 0.9375rem; font-weight: 600; color: var(--color-forest); }
  .groupe__domain:hover span { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-sun); }
  .groupe__list { display: grid; gap: 0.35rem; margin-top: 0.55rem; padding-left: 1.1rem; list-style: disc; font-size: 0.9375rem; line-height: 1.55; color: rgb(28 42 33 / 0.8); }
  .groupe__list li::marker { color: var(--color-brand); }
</style>
