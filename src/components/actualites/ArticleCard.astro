---
/** Vignette d'actualité : image, catégorie, date, titre, résumé (protocole 6.2). */
import { CalendarDays, ArrowRight } from '@lucide/astro';
import SiteImage from '../ui/SiteImage.astro';
import { formatDateFr } from '../../lib/actualites';
import { url } from '../../lib/url';
import type { ImageId } from '../../config/images';

/** horizontal : image à gauche et texte à droite à partir de 768 px (publication mise en avant seule) */
interface Props { slug: string; title: string; date: Date; category: string; summary: string; cover: string; headingLevel?: 'h2' | 'h3'; horizontal?: boolean }
const { slug, title, date, category, summary, cover, headingLevel = 'h2', horizontal = false } = Astro.props;
const H = headingLevel;
---
<article class:list={['acard group', horizontal && 'acard--h']} data-category={category}>
  <div class="acard__media">
    <SiteImage id={cover as ImageId} sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw" class="transition-transform duration-700 group-hover:scale-[1.04]" />
    <span class="acard__cat">{category}</span>
  </div>
  <div class="flex flex-1 flex-col p-6 sm:p-7">
    <p class="inline-flex items-center gap-2 text-small text-muted">
      <CalendarDays size={15} aria-hidden="true" /> <time datetime={date.toISOString().slice(0, 10)}>{formatDateFr(date)}</time>
    </p>
    <H class="mt-3 text-h4 leading-snug text-forest">
      <a href={url(`/actualites/${slug}`)} class="after:absolute after:inset-0 focus-visible:outline-none">{title}</a>
    </H>
    <p class="mt-3 flex-1 text-[0.9375rem] leading-relaxed text-ink/70">{summary}</p>
    <span aria-hidden="true" class="mt-6 inline-flex items-center gap-2 text-small font-semibold text-brand">
      Lire l'article <ArrowRight size={16} class="transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</article>

<style>
  .acard {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 1.5rem;
    background: #fff;
    box-shadow: var(--shadow-card);
    transition: transform 0.45s var(--ease-out-soft), box-shadow 0.45s;
  }
  /* Contour tracé au-dessus du contenu : reste visible même quand l'image occupe le bord de la carte */
  .acard::after { content: ''; position: absolute; inset: 0; z-index: 1; border-radius: inherit; box-shadow: inset 0 0 0 1px var(--color-line); pointer-events: none; transition: box-shadow 0.45s; }
  .acard:hover { transform: translateY(-5px); box-shadow: var(--shadow-lift); }
  .acard:hover::after { box-shadow: inset 0 0 0 1px rgb(31 77 46 / 0.25); }
  .acard:has(a:focus-visible) { outline: 2px solid var(--color-brand); outline-offset: 3px; }
  .acard__media { position: relative; aspect-ratio: 1200 / 630; overflow: hidden; background: #fff; border-bottom: 1px solid var(--color-line); }
  .acard__cat {
    position: absolute;
    top: 0.875rem;
    left: 0.875rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    background: var(--color-forest);
    box-shadow: 0 6px 14px -8px rgb(15 38 24 / 0.6);
  }
  @media (width >= 48rem) {
    .acard--h { display: grid; grid-template-columns: 1fr 1fr; }
    .acard--h .acard__media { aspect-ratio: auto; min-height: 16rem; border-bottom: 0; border-right: 1px solid var(--color-line); }
    .acard--h > div:last-child { justify-content: center; padding: 2.25rem; }
  }
  @media (prefers-reduced-motion: reduce) { .acard:hover { transform: none; } }
</style>
