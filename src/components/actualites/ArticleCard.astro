---
/**
 * Actualité en ligne de liste (refonte, étape 6) : date et catégorie en repères techniques, titre, résumé.
 * Pas d'image dans la liste (les couvertures restent sur la page de l'article).
 */
import { ArrowUpRight } from '@lucide/astro';
import { formatDateFr } from '../../lib/actualites';
import { url } from '../../lib/url';

interface Props { slug: string; title: string; date: Date; category: string; summary: string; cover?: string; headingLevel?: 'h2' | 'h3'; horizontal?: boolean }
const { slug, title, date, category, summary, headingLevel = 'h2' } = Astro.props;
const H = headingLevel;
---
<article class="arow group" data-category={category}>
  <p class="arow__meta">
    <time datetime={date.toISOString().slice(0, 10)}>{formatDateFr(date)}</time>
    <span class="arow__cat">{category}</span>
  </p>
  <div>
    <H class="arow__title"><a href={url(`/actualites/${slug}`)} class="after:absolute after:inset-0 focus-visible:outline-none">{title}</a></H>
    <p class="arow__summary">{summary}</p>
  </div>
  <ArrowUpRight size={18} aria-hidden="true" class="arow__go" />
</article>

<style>
  .arow { position: relative; display: grid; grid-template-columns: 1fr auto; gap: 0.6rem 1.5rem; padding-block: 1.6rem; border-bottom: 1px solid var(--color-line); }
  .arow__meta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; font-family: var(--font-mono); font-size: var(--text-eyebrow); letter-spacing: var(--text-eyebrow--letter-spacing); text-transform: uppercase; color: var(--color-muted); }
  .arow__cat { color: var(--color-accent-text); }
  .arow__title { font-size: 1.25rem; font-weight: 500; line-height: 1.3; letter-spacing: -0.01em; color: var(--color-ink); transition: color 0.2s; }
  .arow__summary { margin-top: 0.5rem; max-width: 46rem; font-size: 0.9375rem; color: var(--color-muted); }
  :global(.arow__go) { color: var(--color-line-strong); transition: color 0.2s, transform 0.3s var(--ease-out-soft); }
  .arow:hover .arow__title { color: var(--color-accent-text); }
  .arow:hover :global(.arow__go) { color: var(--color-accent); transform: translate(2px, -2px); }
  .arow:has(a:focus-visible) { outline: 2px solid var(--color-accent); outline-offset: 4px; }
  @media (width >= 64rem) {
    .arow { grid-template-columns: 3fr 8fr auto; column-gap: 2rem; padding-block: 2rem; }
    .arow__meta { grid-column: 1; flex-direction: column; padding-top: 0.35rem; }
  }
</style>
