---
/** Page introuvable (404). Servie par Hostinger via ErrorDocument (.htaccess) et par GitHub Pages. Page non indexée. */
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';

const liens = [
  { label: 'Le cabinet', href: '/cabinet' },
  { label: 'Nos expertises', href: '/expertises' },
  { label: 'Missions en cours', href: '/realisations/missions-en-cours' },
  { label: 'Foire aux questions', href: '/ressources/faq' },
  { label: 'Contact', href: '/contact' },
];
---
<BaseLayout title="Page introuvable" description="La page demandée n'existe pas ou a été déplacée." cta={false} robots="noindex, nofollow">
  <section class="pb-24 pt-36 sm:pt-44">
    <div class="container-site max-w-3xl">
            <p class="text-eyebrow uppercase text-accent-text">Erreur 404</p>
      <h1 class="mt-4 text-h1 text-ink">Cette page est introuvable.</h1>
      <p class="mt-4 text-lead text-muted">L'adresse saisie est peut-être incomplète, ou la page a été déplacée. Ces rubriques peuvent vous aider :</p>
      <ul class="mt-10 border-t border-line">
        {liens.map((l) => (
          <li><a href={url(l.href)} class="flex border-b border-line py-4 font-medium text-ink transition-colors hover:text-accent-text">{l.label}</a></li>
        ))}
      </ul>
      <a href={url('/')} class="mt-10 inline-flex items-center gap-2 font-medium text-ink hover:text-accent-text"><ArrowLeft size={18} aria-hidden="true" /> Retour à l'accueil</a>
    </div>
  </section>
</BaseLayout>
