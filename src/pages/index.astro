---
/**
 * Accueil (refonte) : héro, chiffres clés, prestations en tableau, méthode, référence, équipe, contact TdR.
 * Actualités et partenaires ne figurent plus sur l'accueil (rubriques accessibles par le menu).
 * La carte d'appel du pied de page est remplacée ici par la section Contact (cta={false}).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Chiffres from '../components/home/Chiffres.astro';
import Prestations from '../components/home/Prestations.astro';
import Methode from '../components/home/Methode.astro';
import Reference from '../components/home/Reference.astro';
import Equipe from '../components/home/Equipe.astro';
import ContactTdr from '../components/home/ContactTdr.astro';
---
<BaseLayout cta={false}>
  <Hero />
  <Chiffres />
  <Prestations />
  <Methode />
  <Reference />
  <Equipe />
  <ContactTdr />
</BaseLayout>
