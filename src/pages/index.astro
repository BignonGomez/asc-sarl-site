---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Bandeau from '../components/home/Bandeau.astro';
import CabinetIntro from '../components/home/CabinetIntro.astro';
import ExpertisesGrid from '../components/home/ExpertisesGrid.astro';
import Realisations from '../components/home/Realisations.astro';
import Approche from '../components/home/Approche.astro';
import Actualites from '../components/home/Actualites.astro';
import Partenaires from '../components/home/Partenaires.astro';
import { features } from '../config/site';
---
<BaseLayout>
  <Hero />
  <Bandeau />
  <CabinetIntro />
  <ExpertisesGrid />
  <Realisations />
  <Approche />
  {features.homeNews && <Actualites />}
  {features.homePartners && <Partenaires />}
</BaseLayout>
