---
/** Confirmation d'envoi (navigateurs sans JavaScript : le script PHP redirige ici). Page non indexée. */
import { ArrowLeft } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
---
<BaseLayout title="Message envoyé" description="Confirmation d'envoi du formulaire de contact." cta={false} robots="noindex, nofollow">
  <section class="pb-24 pt-36 sm:pt-44">
    <div class="container-site max-w-3xl">
      <p class="label-mono text-accent-text">Envoi confirmé</p>
      <h1 class="mt-4 text-h1 text-ink">Merci, votre message a bien été envoyé.</h1>
      <p class="mt-4 text-lead text-muted">Un accusé de réception vous a été adressé par courrier électronique.</p>
      <a href={url('/')} class="mt-10 inline-flex items-center gap-2 font-medium text-ink hover:text-accent-text"><ArrowLeft size={18} aria-hidden="true" /> Retour à l'accueil</a>
    </div>
  </section>
</BaseLayout>
