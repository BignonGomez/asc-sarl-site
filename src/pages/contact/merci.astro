---
/** Confirmation d'envoi (navigateurs sans JavaScript : le script PHP redirige ici). Page non indexée. */
import { CircleCheck, ArrowLeft } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';
---
<BaseLayout title="Message envoyé" description="Confirmation d'envoi du formulaire de contact." cta={false} robots="noindex, nofollow">
  <section class="bg-mineral pb-24 pt-36 sm:pt-44">
    <div class="container-site max-w-2xl text-center">
      <span class="inline-grid size-20 place-items-center rounded-full bg-forest text-white shadow-[0_0_0_12px_var(--color-forest-soft)]"><CircleCheck size={34} aria-hidden="true" /></span>
      <h1 class="mt-8 text-h2 text-forest">Merci, votre message a bien été envoyé.</h1>
      <p class="mt-4 text-lead text-muted">Un accusé de réception vous a été adressé par courrier électronique.</p>
      <a href={url('/')} class="mt-10 inline-flex items-center gap-2 font-semibold text-forest hover:text-brand"><ArrowLeft size={18} aria-hidden="true" /> Retour à l'accueil</a>
    </div>
  </section>
</BaseLayout>
