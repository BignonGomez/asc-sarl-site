---
/**
 * 3.3 Notre équipe — protocole complet, section 3.3. Données : src/data/equipe.ts.
 * Fiches nominatives (titre, diplôme, domaine) affichées seulement si publication.equipe (accords écrits) ;
 * sinon, familles de compétences uniquement.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import CabinetLinks from '../../components/page/CabinetLinks.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import { team, competences } from '../../data/equipe';

const pad = (n: number) => String(n).padStart(2, '0');
// Profils techniques d'abord
const ordre = ['Environnement et changements climatiques', 'Agronomie et développement rural', 'Accompagnement des collectivités', 'Communication et sociologie du développement'];
const familles = [...competences].sort((a, b) => ordre.indexOf(a.label) - ordre.indexOf(b.label));
---
<BaseLayout
  title="Notre équipe"
  description="Environnement et climat, agronomie et développement rural, accompagnement des collectivités, communication et sociologie du développement."
>
  <PageHeader
    eyebrow="Le Cabinet"
    title="Notre équipe"
    intro="Les missions d'Alkebulan Services et Conseils sont conduites par des professionnels aux compétences complémentaires : environnement et changements climatiques, agronomie et développement rural, communication et sociologie du développement, accompagnement des collectivités. Selon la nature de chaque mission, le cabinet constitue des équipes pluridisciplinaires associant ses responsables et des experts associés."
    crumbs={[{ label: 'Le Cabinet', href: '/cabinet' }, { label: 'Notre équipe' }]}
  />

  <section aria-labelledby="competences-title" class="section-y">
    <div class="container-site">
      <SectionHead id="competences-title" index="01" label="Compétences" title="Des compétences complémentaires" />
      <ul class="rows mt-12 lg:mt-16" data-reveal>
        {familles.map((c, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] items-baseline text-h4 text-ink"><span class="num num--accent">{pad(i + 1)}</span>{c.label}</li>
        ))}
      </ul>
    </div>
  </section>

  {team.length > 0 && (
    <section aria-labelledby="membres-title" class="section-y">
      <div class="container-site">
        <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
        <SectionHead id="membres-title" index="02" label="Membres" title="Responsables et experts associés" />
        <ul class="membres mt-12 lg:mt-16" data-reveal>
          {team.map((m) => (
            <li id={`membre-${m.lastName.toLowerCase()}`} class="membre scroll-mt-28">
              <p class="label-mono">{m.badge ?? 'Expert'}</p>
              <h3 class="membre__name">{m.firstName} {m.lastName}</h3>
              <p class="membre__role">{m.role}</p>
              <dl class="kv mt-4">
                <div><dt>Domaine</dt><dd>{m.specialty}</dd></div>
                {m.degree && <div><dt>Diplôme</dt><dd>{m.degree}</dd></div>}
                {m.experience && <div><dt>Expérience</dt><dd>{m.experience} ans</dd></div>}
              </dl>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section aria-labelledby="constitution-title" class="section-y">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="constitution-title" index={team.length > 0 ? '03' : '02'} label="Missions" title="Des équipes adaptées à chaque mission">
        <div class="prose-site mt-8" data-reveal>
          <p>En fonction de la nature et des exigences de chaque mission, Alkebulan Services et Conseils constitue des équipes adaptées, associant ses responsables et des experts associés aux spécialités complémentaires. La composition de l'équipe proposée est précisée dans chacune de nos offres techniques.</p>
        </div>
      </SectionHead>
    </div>
  </section>

  <CabinetLinks current="/cabinet/equipe" links={['/cabinet/vision-mission-valeurs', '/cabinet/approche']} />
</BaseLayout>

<style>
  .membres { display: grid; gap: 2.5rem; }
  .membre { padding-top: 1.25rem; border-top: 1px solid var(--color-ink); }
  .membre__name { margin-top: 0.6rem; font-size: var(--text-h3); font-weight: 500; letter-spacing: -0.015em; color: var(--color-ink); }
  .membre__role { margin-top: 0.25rem; color: var(--color-muted); }
  @media (width >= 64rem) { .membres { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3rem; } }
</style>
