---
/** 3.4 Notre approche méthodologique — protocole complet, section 3.4. Données : src/data/approche.ts, livrables : src/data/livrables.ts (À VALIDER). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import CabinetLinks from '../../components/page/CabinetLinks.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import { steps } from '../../data/approche';
import { livrablesParEtape } from '../../data/livrables';

const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout
  title="Notre approche méthodologique"
  description="Comment Alkebulan Services et Conseils conduit ses missions : une démarche en cinq étapes, structurée, participative et adaptée aux réalités du terrain."
>
  <PageHeader
    eyebrow="Le Cabinet"
    title="Notre approche méthodologique"
    intro="Chaque mission confiée à Alkebulan Services et Conseils suit une démarche structurée, participative et adaptée aux réalités du terrain. Elle repose sur l'analyse des besoins, la collecte et l'exploitation de données fiables, la participation des acteurs concernés et la recherche de solutions techniquement pertinentes et adaptées au contexte local."
    crumbs={[{ label: 'Le Cabinet', href: '/cabinet' }, { label: 'Notre approche méthodologique' }]}
  />

  <section aria-labelledby="etapes-title" class="section-y">
    <div class="container-site">
      <SectionHead id="etapes-title" index="01" label="Démarche" title="Une démarche en cinq étapes" />
      <ol class="etapes mt-12 lg:mt-16">
        {steps.map((s, i) => (
          <li class="etape" data-reveal>
            <span class="etape__n">Étape {pad(i + 1)}</span>
            <div>
              <h3 class="etape__title">{s.title}</h3>
              <p class="etape__text">{s.text}</p>
            </div>
            <p class="etape__livrable"><span class="label-mono block">Livrable</span>{livrablesParEtape[i]}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section aria-labelledby="cadre-title" class="section-y">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="cadre-title" index="02" label="Cadre" title="Un cadre adaptable">
        <div class="prose-site mt-8" data-reveal>
          <p>Cette démarche constitue un cadre de référence et non une procédure rigide. Elle est adaptée à chaque mission, à son domaine technique, à ses objectifs, aux exigences du client et aux contraintes du terrain.</p>
        </div>
      </SectionHead>
    </div>
  </section>

  <CabinetLinks current="/cabinet/approche" links={['/cabinet/vision-mission-valeurs', '/cabinet/equipe', '/expertises']} />
</BaseLayout>

<style>
  .etapes { border-top: 1px solid var(--color-ink); }
  .etape { display: grid; gap: 0.75rem; padding-block: 1.75rem; border-bottom: 1px solid var(--color-line); }
  .etape__n { font-family: var(--font-mono); font-size: var(--text-eyebrow); letter-spacing: var(--text-eyebrow--letter-spacing); text-transform: uppercase; color: var(--color-accent-text); }
  .etape__title { font-size: var(--text-h3); line-height: var(--text-h3--line-height); letter-spacing: var(--text-h3--letter-spacing); font-weight: 500; color: var(--color-ink); }
  .etape__text { margin-top: 0.6rem; max-width: 42rem; color: var(--color-muted); }
  .etape__livrable { font-weight: 500; color: var(--color-ink); }
  .etape__livrable .label-mono { margin-bottom: 0.3rem; }
  @media (width >= 64rem) {
    .etape { grid-template-columns: 3fr 6fr 3fr; gap: 2rem; padding-block: 2.25rem; }
    .etape__n { padding-top: 0.5rem; }
    .etape__livrable { padding-top: 0.35rem; }
  }
</style>
