---
/** 3.1 Présentation du cabinet — protocole complet, section 3.1. */
import { Landmark, MapPin, Handshake, Briefcase, Lightbulb, Building } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import CabinetLinks from '../../components/page/CabinetLinks.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import SiteImage from '../../components/ui/SiteImage.astro';
import ExpertiseIcon from '../../components/ui/ExpertiseIcon.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import { expertises } from '../../data/expertises';
import { site } from '../../config/site';
import { url } from '../../lib/url';

// Fiche signalétique (sources : [MCV], [DOSS], [CONTRAT]). Le numéro IFU n'est pas publié (décision en attente).
const identity = [
  { label: 'Dénomination sociale', value: 'ALKEBULAN SERVICES ET CONSEILS' },
  { label: 'Sigle', value: 'ASC SARL' },
  { label: 'Forme juridique', value: 'Société à responsabilité limitée (SARL)' },
  { label: 'Date de création', value: 'Immatriculation au RCCM de Cotonou le 16 juin 2025' },
  { label: 'Capital social', value: '5 000 000 FCFA' },
  { label: 'Numéro RCCM', value: site.rccm },
  { label: 'Siège social', value: site.address.oneLine },
  { label: 'Direction', value: 'Médard DAHODO, Directeur Général' },
];

const publics = [
  { icon: Landmark, label: 'Administrations publiques' },
  { icon: MapPin, label: 'Collectivités territoriales' },
  { icon: Handshake, label: 'Organisations de développement' },
  { icon: Briefcase, label: 'Entreprises' },
  { icon: Lightbulb, label: 'Porteurs de projets' },
];
---
<BaseLayout
  title="Présentation du cabinet"
  description="Alkebulan Services et Conseils, cabinet béninois d'études et de conseil : identité juridique, positionnement, champs d'intervention et ancrage territorial."
>
  <PageHeader
    image="cabinet.hero"
    eyebrow="Le Cabinet"
    title={site.name}
    intro="Alkebulan Services et Conseils est un cabinet béninois de services et de conseils. Il intervient sur des problématiques liées à l'environnement, aux changements climatiques, à la gestion des ressources naturelles et au développement territorial."
    crumbs={[{ label: 'Le Cabinet', href: '/cabinet' }, { label: 'Présentation du cabinet' }]}
  />

  <!-- Section 1 : vocation -->
  <section aria-labelledby="vocation-title" class="section-y bg-white">
    <div class="container-site grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <SectionHeading id="vocation-title" title="Notre vocation" />
        <p class="mt-8 text-lead text-ink/90" data-reveal>
          Accompagner les acteurs publics et privés à chaque étape de leurs projets : l'analyse de leurs besoins, la réalisation d'études, l'élaboration de solutions techniques et l'accompagnement de leur mise en œuvre, en tenant compte des réalités de chaque territoire.
        </p>
      </div>
      <div class="lg:col-span-6" data-reveal style="--reveal-delay:120ms">
        <div class="relative aspect-[4/3] overflow-hidden rounded-card shadow-lift ring-1 ring-black/5">
          <SiteImage id="cabinet.vocation" sizes="(min-width: 64rem) 36rem, 100vw" />
        </div>
      </div>
    </div>
  </section>

  <!-- Section 2 : fiche signalétique -->
  <section aria-labelledby="identite-title" class="section-y bg-mineral">
    <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4">
        <SectionHeading id="identite-title" title="Identité du cabinet" intro="Informations juridiques et institutionnelles." />
      </div>
      <div class="lg:col-span-8" data-reveal>
        <dl class="overflow-hidden rounded-card border border-line bg-white shadow-card">
          {identity.map((row, i) => (
            <div class:list={['grid gap-1 px-6 py-4 sm:grid-cols-[13rem_1fr] sm:gap-6 sm:px-8 sm:py-5', i > 0 && 'border-t border-line']}>
              <dt class="text-small font-semibold text-muted">{row.label}</dt>
              <dd class="font-medium text-ink">{row.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Section 3 : positionnement et publics -->
  <section aria-labelledby="positionnement-title" class="section-y bg-white">
    <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <SectionHeading id="positionnement-title" title="Notre positionnement" />
        <p class="mt-8 text-lead text-ink/90" data-reveal>
          Alkebulan Services et Conseils se positionne comme un cabinet de conseil, d'études et d'accompagnement technique. Son action est orientée vers les problématiques environnementales, climatiques, hydrauliques, agricoles et territoriales, avec la volonté de contribuer à des réponses adaptées aux enjeux du développement durable.
        </p>
      </div>
      <div class="lg:col-span-6 lg:pt-16" data-reveal style="--reveal-delay:120ms">
        <div class="rounded-card border border-line bg-mineral p-7 sm:p-9">
          <h3 class="flex items-center gap-3 text-h4 text-forest">
            <Building size={22} stroke-width={1.75} aria-hidden="true" class="text-brand" /> Nos publics
          </h3>
          <p class="mt-3 text-small text-muted">Nos prestations s'adressent aux :</p>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {publics.map((p) => (
              <li class="flex items-center gap-3 rounded-ui border border-line bg-white px-4 py-3 text-small font-semibold text-ink">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-ui bg-forest-soft text-forest">
                  <p.icon size={18} stroke-width={1.75} aria-hidden="true" />
                </span>
                {p.label}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 4 : champs d'intervention -->
  <section aria-labelledby="champs-title" class="section-y bg-mineral">
    <div class="container-site">
      <SectionHeading
        id="champs-title"
        title="Nos champs d'intervention"
        intro="Les interventions d'Alkebulan Services et Conseils couvrent huit domaines complémentaires, de l'évaluation environnementale à la formation des acteurs. Cette diversité permet d'aborder les projets de développement dans leurs dimensions techniques, environnementales, sociales et économiques."
      />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2">
        {expertises.map((e, i) => (
          <li class="group relative flex gap-5 rounded-card border border-line bg-white p-6 shadow-card transition-[box-shadow,border-color,transform] duration-300 hover:-translate-y-0.5 hover:border-forest/30 hover:shadow-lift" data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
            <span class="flex size-12 shrink-0 items-center justify-center rounded-ui bg-forest-soft text-forest transition-colors group-hover:bg-forest group-hover:text-white">
              <ExpertiseIcon name={e.icon} size={22} />
            </span>
            <div>
              <p class="text-eyebrow uppercase text-brand">Domaine {String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-1.5 text-h4 text-forest">
                <a href={url(`/expertises/${e.slug}`)} class="after:absolute after:inset-0 after:rounded-card">{e.title}</a>
              </h3>
              <p class="mt-1.5 text-small text-muted">{e.summary}</p>
            </div>
          </li>
        ))}
      </ul>
      <div class="mt-12" data-reveal>
        <ArrowLink href="/expertises">Voir nos expertises</ArrowLink>
      </div>
    </div>
  </section>

  <!-- Section 5 : ancrage territorial -->
  <section aria-labelledby="ancrage-title" class="section-y bg-white">
    <div class="container-site">
      <div class="relative isolate overflow-hidden rounded-[2rem] bg-mineral px-7 py-12 ring-1 ring-forest/10 sm:px-12 lg:px-16 lg:py-16" data-reveal>
        <div aria-hidden="true" class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_55%_80%_at_100%_0%,rgb(252_209_42/0.12),transparent_70%),radial-gradient(ellipse_50%_70%_at_0%_100%,rgb(168_196_90/0.14),transparent_70%)]"></div>
        <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <p class="inline-flex items-center gap-2 text-eyebrow uppercase text-brand"><MapPin size={16} aria-hidden="true" /> Présence locale</p>
            <h2 id="ancrage-title" class="mt-4 text-h2 text-forest">Un cabinet ancré au Bénin</h2>
            <p class="mt-6 text-lead text-muted">
              Implanté à Cotonou, le cabinet intervient au Bénin auprès d'acteurs nationaux et locaux, en milieu urbain comme en milieu rural. Il adapte la composition de ses équipes et ses méthodes à la nature de chaque mission et au contexte de chaque territoire.
            </p>
          </div>
          <div class="lg:col-span-5">
            <div class="rounded-card border-t-4 border-sun bg-white p-6 shadow-card ring-1 ring-line">
              <p class="text-eyebrow uppercase text-brand">Siège social</p>
              <address class="mt-3 not-italic leading-relaxed text-ink">
                {site.address.lines.map((l) => <span class="block">{l}</span>)}
              </address>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CabinetLinks current="/cabinet" links={['/cabinet/vision-mission-valeurs', '/cabinet/equipe', '/cabinet/approche']} />
</BaseLayout>
