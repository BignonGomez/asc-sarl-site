---
/** 3.1 Présentation du cabinet — protocole complet, section 3.1 (refonte, étape 6 : textes inchangés, mise en page technique). */
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import CabinetLinks from '../../components/page/CabinetLinks.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import CarteBenin from '../../components/ui/CarteBenin.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import { expertises } from '../../data/expertises';
import { site, publication } from '../../config/site';
import { url } from '../../lib/url';

// Fiche signalétique (sources : [MCV], [DOSS], [CONTRAT]). Le numéro IFU n'est pas publié (décision en attente).
const identity = [
  { label: 'Dénomination sociale', value: 'ALKEBULAN SERVICES ET CONSEILS' },
  { label: 'Sigle', value: 'ASC SARL' },
  { label: 'Forme juridique', value: 'Société à responsabilité limitée (SARL)' },
  { label: 'Date de création', value: 'Immatriculation au RCCM de Cotonou le 16 juin 2025' },
  { label: 'Capital social', value: '5 000 000 FCFA' },
  { label: 'Numéro RCCM', value: site.rccm },
  { label: 'Siège social', value: site.address.oneLine },
  ...(publication.equipe ? [{ label: 'Direction', value: 'Médard DAHODO, Directeur Général' }] : []),
];

const publics = ['Administrations publiques', 'Collectivités territoriales', 'Organisations de développement', 'Entreprises', 'Porteurs de projets'];
const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout
  title="Présentation du cabinet"
  description="Alkebulan Services et Conseils, cabinet béninois d'études et de conseil : identité juridique, positionnement, champs d'intervention et ancrage territorial."
>
  <PageHeader
    eyebrow="Le Cabinet"
    title={site.name}
    intro="Alkebulan Services et Conseils est un cabinet béninois de services et de conseils. Il intervient sur des problématiques liées à l'environnement, aux changements climatiques, à la gestion des ressources naturelles et au développement territorial."
    crumbs={[{ label: 'Le Cabinet', href: '/cabinet' }, { label: 'Présentation du cabinet' }]}
  >
    <figure slot="aside" class="mx-auto max-w-[22rem] lg:mr-0">
      <CarteBenin />
    </figure>
  </PageHeader>

  <!-- 01 Vocation -->
  <section aria-labelledby="vocation-title" class="section-y">
    <div class="container-site">
      <SectionHead id="vocation-title" index="01" label="Vocation" title="Notre vocation">
        <div class="prose-site mt-8" data-reveal>
          <p>Accompagner les acteurs publics et privés à chaque étape de leurs projets : l'analyse de leurs besoins, la réalisation d'études, l'élaboration de solutions techniques et l'accompagnement de leur mise en œuvre, en tenant compte des réalités de chaque territoire.</p>
        </div>
      </SectionHead>
    </div>
  </section>

  <!-- 02 Identité -->
  <section aria-labelledby="identite-title" class="section-y">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="identite-title" index="02" label="Identité" title="Identité du cabinet" intro="Informations juridiques et institutionnelles.">
        <dl class="kv mt-10" data-reveal>
          {identity.map((row) => (
            <div><dt>{row.label}</dt><dd>{row.value}</dd></div>
          ))}
        </dl>
      </SectionHead>
    </div>
  </section>

  <!-- 03 Positionnement -->
  <section aria-labelledby="positionnement-title" class="section-y">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="positionnement-title" index="03" label="Positionnement" title="Notre positionnement">
        <div class="prose-site mt-8" data-reveal>
          <p>Alkebulan Services et Conseils se positionne comme un cabinet de conseil, d'études et d'accompagnement technique. Son action est orientée vers les problématiques environnementales, climatiques, hydrauliques, agricoles et territoriales, avec la volonté de contribuer à des réponses adaptées aux enjeux du développement durable.</p>
        </div>
        <h3 class="label-mono mt-12">Nos prestations s'adressent aux</h3>
        <ul class="rows mt-4 grid sm:grid-cols-2 sm:gap-x-8" data-reveal>
          {publics.map((p, i) => <li class="flex gap-4 font-medium text-ink"><span class="num">{pad(i + 1)}</span>{p}</li>)}
        </ul>
      </SectionHead>
    </div>
  </section>

  <!-- 04 Champs d'intervention -->
  <section aria-labelledby="champs-title" class="section-y">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead
        id="champs-title"
        index="04"
        label="Domaines"
        title="Nos champs d'intervention"
        intro="Les interventions d'Alkebulan Services et Conseils couvrent huit domaines complémentaires, de l'évaluation environnementale à la formation des acteurs. Cette diversité permet d'aborder les projets de développement dans leurs dimensions techniques, environnementales, sociales et économiques."
      />
      <ul class="link-rows mt-12 lg:mt-16" data-reveal>
        {expertises.map((e, i) => (
          <li>
            <a href={url(`/expertises/${e.slug}`)} class="link-row">
              <span class="num num--accent">{pad(i + 1)}</span>
              <span class="link-row__title">{e.title}</span>
              <span class="link-row__text">{e.summary}</span>
              <ArrowUpRight size={18} aria-hidden="true" class="link-row__go" />
            </a>
          </li>
        ))}
      </ul>
      <div class="mt-10" data-reveal><ArrowLink href="/expertises">Voir nos expertises</ArrowLink></div>
    </div>
  </section>

  <!-- 05 Ancrage territorial -->
  <section aria-labelledby="ancrage-title" class="section-y">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="ancrage-title" index="05" label="Présence locale" title="Un cabinet ancré au Bénin">
        <div class="prose-site mt-8" data-reveal>
          <p>Implanté à Cotonou, le cabinet intervient au Bénin auprès d'acteurs nationaux et locaux, en milieu urbain comme en milieu rural. Il adapte la composition de ses équipes et ses méthodes à la nature de chaque mission et au contexte de chaque territoire.</p>
        </div>
        <dl class="kv mt-10" data-reveal>
          <div><dt>Siège social</dt><dd><address class="not-italic">{site.address.lines.map((l) => <span class="block">{l}</span>)}</address></dd></div>
        </dl>
      </SectionHead>
    </div>
  </section>

  <CabinetLinks current="/cabinet" links={['/cabinet/vision-mission-valeurs', '/cabinet/equipe', '/cabinet/approche']} />
</BaseLayout>
