---
/** 3.2 Vision, mission et valeurs — protocole complet, section 3.2 (textes À VALIDER par la direction ; refonte étape 6 : mise en page seulement). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import CabinetLinks from '../../components/page/CabinetLinks.astro';
import SectionHead from '../../components/ui/SectionHead.astro';

const pillars = [
  {
    id: 'vision',
    label: 'Notre vision',
    statement: 'Des territoires durables et résilients, mieux préparés aux défis environnementaux, climatiques, économiques et sociaux.',
    text: "Alkebulan Services et Conseils souhaite contribuer à l'émergence de territoires où les ressources naturelles sont gérées de manière responsable, où les écosystèmes sont préservés, où les populations sont mieux préparées aux effets des changements climatiques, et où les modèles de développement tiennent compte des réalités locales.",
  },
  {
    id: 'mission',
    label: 'Notre mission',
    statement: 'Accompagner les acteurs publics et privés par des études, des conseils et des solutions techniques adaptées aux réalités des territoires.',
    text: "Pour y parvenir, le cabinet réalise des études, fournit des prestations de conseil, élabore des solutions techniques et accompagne les initiatives de développement. Il mobilise des compétences pluridisciplinaires pour répondre aux problématiques liées à l'environnement, au climat, à la gestion des ressources en eau, à l'aménagement du territoire, à l'agriculture durable et au développement local, en associant toutes les parties prenantes, y compris les femmes.",
  },
];

const values = [
  { title: 'Rigueur professionnelle', text: 'Nous accordons la plus grande attention à la qualité de nos analyses et de nos prestations.' },
  { title: 'Intégrité', text: 'Nous agissons avec honnêteté et transparence, et nous respectons nos engagements.' },
  { title: 'Engagement', text: 'Nous nous investissons pleinement pour atteindre les objectifs des missions qui nous sont confiées.' },
  { title: 'Innovation', text: 'Nous recherchons des solutions adaptées à chaque contexte et améliorons continuellement nos pratiques.' },
  { title: 'Responsabilité environnementale', text: 'Nous intégrons les enjeux écologiques et la gestion durable des ressources naturelles dans chacune de nos interventions.' },
  { title: 'Collaboration', text: 'Nous privilégions le dialogue, la participation et la coopération avec tous les acteurs concernés.' },
];

const levels = [
  { n: 1, name: 'Vision', role: 'Le cap' },
  { n: 2, name: 'Mission', role: 'Les actions' },
  { n: 3, name: 'Valeurs', role: "La manière d'agir" },
];
const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout
  title="Vision, mission et valeurs"
  description="La vision, la mission et les valeurs d'Alkebulan Services et Conseils : des territoires durables et résilients, des solutions adaptées aux réalités locales."
>
  <PageHeader
    eyebrow="Le Cabinet"
    title="Vision, mission et valeurs"
    intro="Notre vision, notre mission et nos valeurs expriment ce que nous voulons contribuer à construire, la manière dont nous entendons agir et les principes qui guident notre travail avec nos clients, nos partenaires et les bénéficiaires de nos missions."
    crumbs={[{ label: 'Le Cabinet', href: '/cabinet' }, { label: 'Vision, mission et valeurs' }]}
  />

  {pillars.map((p, i) => (
    <section aria-labelledby={`${p.id}-title`} class="section-y">
      <div class="container-site">
        {i > 0 && <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>}
        <SectionHead id={`${p.id}-title`} index={pad(i + 1)} label={p.id === 'vision' ? 'Vision' : 'Mission'} title={p.label}>
          <blockquote class="mt-8 max-w-3xl border-l-2 border-accent pl-6" data-reveal>
            <p class="text-h3 text-ink">{p.statement}</p>
          </blockquote>
          <div class="prose-site mt-8" data-reveal><p>{p.text}</p></div>
        </SectionHead>
      </div>
    </section>
  ))}

  <section aria-labelledby="valeurs-title" class="section-y">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="valeurs-title" index="03" label="Valeurs" title="Nos valeurs" intro="Six principes guident chacune de nos interventions." />
      <ul class="valeurs mt-12 lg:mt-16" data-reveal>
        {values.map((v, i) => (
          <li class="valeur">
            <span class="num num--accent">{pad(i + 1)}</span>
            <h3 class="valeur__title">{v.title}</h3>
            <p class="valeur__text">{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section aria-labelledby="articulation-title" class="section-y">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="articulation-title" index="04" label="Articulation" title="Comment elles s'articulent">
        <ol class="rows mt-10" data-reveal>
          {levels.map((l) => (
            <li class="grid grid-cols-[2.5rem_1fr] items-baseline gap-x-0 sm:grid-cols-[2.5rem_10rem_1fr]">
              <span class="num num--accent">{pad(l.n)}</span>
              <span class="label-mono">{l.name}</span>
              <span class="col-start-2 text-h4 text-ink sm:col-start-3">{l.role}</span>
            </li>
          ))}
        </ol>
        <div class="prose-site mt-8" data-reveal>
          <p>Notre vision fixe le cap, notre mission décrit les actions que nous menons pour y contribuer, et nos valeurs encadrent la manière dont nous les menons.</p>
        </div>
      </SectionHead>
    </div>
  </section>

  <CabinetLinks current="/cabinet/vision-mission-valeurs" links={['/cabinet/equipe', '/cabinet/approche']} />
</BaseLayout>

<style>
  .valeurs { display: grid; border-top: 1px solid var(--color-line); }
  .valeur { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.35rem 0; padding-block: 1.4rem; border-bottom: 1px solid var(--color-line); }
  .valeur__title { font-size: 1.125rem; font-weight: 500; color: var(--color-ink); }
  .valeur__text { grid-column: 2; font-size: 0.9375rem; color: var(--color-muted); }
  @media (width >= 64rem) {
    .valeurs { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 2.5rem; }
    .valeur { grid-template-columns: 1fr; padding-block: 1.75rem; }
    .valeur__title { margin-top: 0.75rem; }
    .valeur__text { grid-column: 1; }
  }
</style>
