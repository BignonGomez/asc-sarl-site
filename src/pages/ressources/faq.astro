---
/**
 * 7.2 Foire aux questions — accordéons par thème (protocole complet, section 7.2).
 * Contenu : src/data/faq.ts. Données structurées FAQPage pour les moteurs de recherche.
 */
import { Plus, ArrowRight, Mail } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import { faq } from '../../data/faq';
import { site } from '../../config/site';
import { url } from '../../lib/url';

const total = faq.reduce((n, t) => n + t.items.length, 0);
let n = 0;
const themes = faq.map((t) => ({ ...t, items: t.items.map((it) => ({ ...it, n: ++n })) }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.flatMap((t) => t.items.map((it) => ({ '@type': 'Question', name: it.q, acceptedAnswer: { '@type': 'Answer', text: it.a } }))),
};
---
<BaseLayout
  title="Foire aux questions (FAQ)"
  description="Questions fréquentes : domaines d'intervention, déroulement des missions, livrables, termes de référence et protection des données."
>
  <PageHeader
    eyebrow="Ressources"
    title="Foire aux questions"
    intro="Les réponses aux questions les plus fréquentes sur le cabinet, ses prestations et la manière de travailler avec lui."
    crumbs={[{ label: 'Ressources' }, { label: 'Foire aux questions' }]}
  />

  <section aria-label="Questions et réponses" class="section-y">
    <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Colonne fixe : titre et thèmes -->
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-28" data-reveal>
          <h2 class="text-h2 text-ink">Vos questions, nos réponses</h2>
          <p class="label-mono mt-4">{total} questions · {faq.length} thèmes</p>
          <nav aria-label="Thèmes de la FAQ" class="mt-8">
            <ul class="grid gap-2">
              {themes.map((t) => {
                return (
                  <li>
                    <a href={`#theme-${t.id}`} class="theme-link group">
                      <span class="flex-1">{t.title}</span>
                      <span class="theme-link__count">{t.items.length}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </nav>
          <div class="faq-help mt-8 hidden lg:block">
            <p class="text-h4 text-ink">Vous ne trouvez pas votre réponse ?</p>
            <a href={`mailto:${site.email}`} class="mt-3 inline-flex items-center gap-2 text-small font-medium text-accent-text underline underline-offset-4">
              <Mail size={16} aria-hidden="true" /> {site.email}
            </a>
          </div>
        </div>
      </div>

      <!-- Accordéons par thème -->
      <div class="grid gap-12 lg:col-span-8">
        {themes.map((t) => {
          return (
            <section id={`theme-${t.id}`} aria-labelledby={`titre-${t.id}`} class="scroll-mt-28">
              <h2 id={`titre-${t.id}`} class="text-h3 text-ink" data-reveal>{t.title}</h2>
              <div class="faq-list mt-6">
                {t.items.map((it, i) => (
                  <details class="faq-item" data-reveal>
                    <summary>
                      <span class="faq-item__n" aria-hidden="true">{String(it.n).padStart(2, '0')}</span>
                      <span class="flex-1">{it.q}</span>
                      <span class="faq-item__icon" aria-hidden="true"><Plus size={18} stroke-width={2.2} /></span>
                    </summary>
                    <div class="faq-item__a">
                      <p>{it.a}</p>
                      {it.link && (
                        <a href={url(it.link.href)} class="mt-4 inline-flex items-center gap-2 text-small font-medium text-accent-text hover:underline hover:underline-offset-4">
                          {it.link.label} <ArrowRight size={16} aria-hidden="true" />
                        </a>
                      )}
                    </div>
                  </details>
                ))}
              </div>
            </section>
          );
        })}

        <div class="faq-help lg:hidden" data-reveal>
          <p class="text-h4 text-ink">Vous ne trouvez pas votre réponse ?</p>
          <a href={`mailto:${site.email}`} class="mt-3 inline-flex items-center gap-2 text-small font-medium text-accent-text underline underline-offset-4">
            <Mail size={16} aria-hidden="true" /> {site.email}
          </a>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .theme-link { display: flex; align-items: baseline; gap: 0.85rem; padding-block: 0.8rem; border-bottom: 1px solid var(--color-line); font-weight: 500; color: var(--color-ink); transition: color 0.2s; }
  .theme-link:hover { color: var(--color-accent-text); }
  .theme-link__count { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-muted); }
  nav[aria-label='Thèmes de la FAQ'] ul { gap: 0; border-top: 1px solid var(--color-line); }
  .faq-help { padding-top: 1.25rem; border-top: 1px solid var(--color-ink); }

  .faq-list { border-top: 1px solid var(--color-ink); }
  .faq-item { border-bottom: 1px solid var(--color-line); }
  .faq-item summary { display: flex; align-items: baseline; gap: 1rem; padding-block: 1.2rem; cursor: pointer; list-style: none; font-size: 1.0625rem; font-weight: 500; color: var(--color-ink); }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { color: var(--color-accent-text); }
  .faq-item__n { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 400; color: var(--color-muted); }
  .faq-item__icon { display: grid; place-items: center; flex-shrink: 0; align-self: center; width: 2rem; height: 2rem; border-radius: var(--radius-ui); color: var(--color-ink); box-shadow: inset 0 0 0 1px var(--color-line); transition: transform 0.3s var(--ease-out-soft), color 0.2s, background-color 0.2s; }
  .faq-item[open] .faq-item__icon { transform: rotate(45deg); color: #fff; background: var(--color-accent); box-shadow: none; }
  .faq-item__a { padding: 0 3rem 1.4rem 2.1rem; color: var(--color-muted); }
  .faq-item::details-content { block-size: 0; overflow: hidden; transition: block-size 0.35s var(--ease-out-soft), content-visibility 0.35s allow-discrete; }
  .faq-item[open]::details-content { block-size: auto; }
  :root { interpolate-size: allow-keywords; }
  @media (prefers-reduced-motion: reduce) {
    .faq-item::details-content { transition: none; }
  }
</style>
