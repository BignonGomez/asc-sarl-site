---
/**
 * Ressources › Recrutement — page ajoutée à la demande du cabinet (hors protocole initial).
 * Offres : src/data/recrutement.ts (tableau vide = bloc « Aucune offre en cours »).
 * Aucune offre, aucun avantage, aucun salaire ni délai de réponse n'est annoncé.
 */
import {
  Send, MapPin, CalendarClock, ArrowUpRight, Mail,
} from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { offres, candidature } from '../../data/recrutement';
import { site } from '../../config/site';
import { url } from '../../lib/url';

const enc = encodeURIComponent;
const mailSpontanee = `mailto:${candidature.email}?subject=${enc(candidature.objetSpontanee)}&body=${enc(
  "Bonjour,\n\nVeuillez trouver ci-joints mon CV et ma lettre de motivation.\n\nDomaine d'intérêt : \n\nCordialement,\n",
)}`;
const mailOffre = (title: string) => `mailto:${candidature.email}?subject=${enc(`Candidature : ${title}`)}`;
const formatDate = (iso: string) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso));

const domaines = [
  { label: 'Environnement et études environnementales' },
  { label: 'Climat et adaptation' },
  { label: 'Eau et gestion des ressources' },
  { label: 'Aménagement du territoire' },
  { label: 'Agriculture et développement rural' },
  { label: 'Économie et développement local' },
];

const etapes = [
  { title: 'Réception du dossier', text: 'Votre CV et votre lettre de motivation sont enregistrés.' },
  { title: 'Étude de la candidature', text: 'Le cabinet examine votre profil au regard de ses besoins et de ses missions.' },
  { title: 'Entretien', text: 'Les candidates et candidats dont le profil correspond peuvent être invités à un entretien.' },
  { title: 'Réponse', text: 'Le cabinet vous informe de la suite donnée à votre candidature.' },
];
---
<BaseLayout
  title="Recrutement"
  description="Rejoindre Alkebulan Services et Conseils, cabinet béninois d'études et de conseil : environnement, climat, eau, aménagement du territoire, agriculture et développement local. Offres en cours et candidature spontanée."
>
  <PageHeader
    eyebrow="Ressources"
    title="Recrutement"
    intro={`Vous partagez nos domaines d'intervention ? Découvrez comment rejoindre ${site.name} ou nous proposer votre candidature.`}
    crumbs={[{ label: 'Ressources', href: '/ressources/faq' }, { label: 'Recrutement' }]}
  />

  <!-- Présentation -->
  <section aria-labelledby="rejoindre-title" class="section-y">
    <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <SectionHeading id="rejoindre-title" title="Rejoindre le cabinet" />
        <p class="mt-8 text-lead text-ink/90" data-reveal>
          {site.name} accompagne les acteurs publics et privés face aux enjeux environnementaux, climatiques et territoriaux. Pour chaque mission, le cabinet constitue des équipes pluridisciplinaires associant ses responsables et des experts associés aux spécialités complémentaires.
        </p>
        <p class="mt-5 text-body text-muted" data-reveal style="--reveal-delay:80ms">
          Nous nous intéressons aux profils qui souhaitent mettre leurs compétences au service des territoires : experts, experts associés pour des missions ponctuelles et stagiaires, dans les domaines où le cabinet intervient.
        </p>
        <p class="mt-6 text-small text-muted" data-reveal style="--reveal-delay:120ms">
          <span>Découvrez les responsables et experts du cabinet dans <a href={url('/cabinet/equipe')} class="font-semibold underline underline-offset-4 hover:text-accent-text">Notre équipe</a>.</span>
        </p>
      </div>
      <div class="lg:col-span-6" data-reveal style="--reveal-delay:120ms">
        <div class="profils">
          <p class="label-mono">Profils recherchés</p>
          <p class="mt-3 text-h3 text-ink">Des compétences en lien avec nos domaines</p>
          <ul class="rows mt-7">
            {domaines.map((d) => (
              <li class="profil">
                {d.label}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Offres en cours : bloc « Aucune offre en cours » tant que la liste est vide -->
  <section id="offres" aria-labelledby="offres-title" class="section-y scroll-mt-24">
    <div class="container-site">
      <SectionHeading id="offres-title" title="Offres en cours" />

      {offres.length === 0 ? (
        <div class="aucune mt-12" data-reveal>
          <p class="label-mono">Offres ouvertes : 0</p>
          <h3 class="mt-3 text-h3 text-ink">Aucune offre en cours</h3>
          <p class="mt-4 max-w-xl text-body text-muted">
            Le cabinet n'a pas de poste ouvert actuellement. Il reste toutefois attentif aux profils qui partagent ses domaines d'intervention.
          </p>
          <div class="mt-8 flex">
            <a href={mailSpontanee} class="btn-mail">
              <Send size={18} aria-hidden="true" /> Envoyer une candidature spontanée
            </a>
          </div>
        </div>
      ) : (
        <ul class="mt-12 border-t border-ink">
          {offres.map((o, i) => (
            <li class="offre" data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
              <span class="offre__tag">{o.contrat}</span>
              <h3 class="mt-4 text-h4 text-ink">{o.title}</h3>
              <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-small text-muted">
                <li class="inline-flex items-center gap-1.5"><MapPin size={15} aria-hidden="true" class="text-accent-text" /> {o.lieu}</li>
                <li class="inline-flex items-center gap-1.5"><CalendarClock size={15} aria-hidden="true" class="text-accent-text" /> Date limite : <time datetime={o.dateLimite}>{formatDate(o.dateLimite)}</time></li>
              </ul>
              {o.description && <p class="mt-4 text-small text-muted">{o.description}</p>}
              <div class="mt-6 flex flex-wrap gap-3">
                <a href={mailOffre(o.title)} class="btn-mail btn-mail--sm"><Send size={16} aria-hidden="true" /> Postuler</a>
                {o.lien && <a href={o.lien} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-small font-semibold text-ink hover:text-accent-text">Fiche de poste <ArrowUpRight size={15} aria-hidden="true" /><span class="sr-only">(nouvel onglet)</span></a>}
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <!-- Candidature spontanée -->
  <section id="candidature" aria-labelledby="spontanee-title" class="section-y scroll-mt-24">
    <div class="container-site grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <SectionHeading id="spontanee-title" title="Candidature spontanée" />
        <p class="mt-8 text-lead text-ink/90" data-reveal>
          Envoyez votre <strong class="font-semibold text-ink">CV</strong> et votre <strong class="font-semibold text-ink">lettre de motivation</strong> par courrier électronique à l'adresse <a href={`mailto:${candidature.email}`} class="font-semibold text-accent-text underline underline-offset-4">{candidature.email}</a>, avec pour objet « {candidature.objetSpontanee} ».
        </p>
        <p class="mt-5 text-body text-muted" data-reveal style="--reveal-delay:80ms">
          Précisez dans votre message le domaine qui vous intéresse et le type de collaboration envisagé.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4" data-reveal style="--reveal-delay:120ms">
          <a href={mailSpontanee} class="btn-mail"><Mail size={18} aria-hidden="true" /> Écrire au cabinet</a>
        </div>
      </div>
      <div class="lg:col-span-6" data-reveal style="--reveal-delay:120ms">
        <ol class="dossier">
          <li><span class="dossier__num">01</span><span><strong>Votre CV</strong> à jour</span></li>
          <li><span class="dossier__num">02</span><span><strong>Votre lettre de motivation</strong></span></li>
          <li><span class="dossier__num">03</span><span>L'objet <strong>« {candidature.objetSpontanee} »</strong></span></li>
          <li><span class="dossier__num">04</span><span>Envoi à <strong>{candidature.email}</strong></span></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Déroulement du recrutement -->
  <section aria-labelledby="deroulement-title" class="section-y">
    <div class="container-site">
      <SectionHeading id="deroulement-title" title="Comment se déroule le recrutement" />
      <ol class="etapes mt-12">
        {etapes.map((e, i) => (
          <li class="etape" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span aria-hidden="true" class="etape__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-h4 text-ink"><span class="sr-only">Étape {i + 1} : </span>{e.title}</h3>
            <p class="mt-2 text-small text-muted">{e.text}</p>
          </li>
        ))}
      </ol>

      <!-- Protection des données des candidats -->
      <p class="donnees mt-10" data-reveal>
        <span>
          <strong class="font-semibold text-ink">Protection de vos données.</strong> Les informations et documents que vous nous transmettez sont utilisés uniquement pour l'étude de votre candidature. Pour en savoir plus et exercer vos droits, consultez notre <a href={url('/politique-de-confidentialite')} class="font-semibold text-accent-text underline underline-offset-4">politique de confidentialité</a>.
        </span>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .profils { padding-top: 1.25rem; border-top: 1px solid var(--color-ink); }
  .profil { font-weight: 500; color: var(--color-ink); }
  .aucune { max-width: 48rem; padding-top: 1.25rem; border-top: 1px solid var(--color-ink); }
  .btn-mail { display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem; min-height: 3rem; padding: 0 1.4rem; border-radius: var(--radius-ui); font-weight: 500; color: #fff; background: var(--color-accent); transition: background-color 0.2s; }
  .btn-mail:hover { background: var(--color-accent-hover); }
  .btn-mail--sm { min-height: 2.75rem; padding: 0 1.1rem; font-size: 0.9375rem; }
  .offre { padding-block: 1.6rem; border-bottom: 1px solid var(--color-line); }
  .offre__tag { font-family: var(--font-mono); font-size: var(--text-eyebrow); letter-spacing: var(--text-eyebrow--letter-spacing); text-transform: uppercase; color: var(--color-accent-text); }
  .dossier { border-top: 1px solid var(--color-ink); }
  .dossier li { display: flex; align-items: baseline; gap: 1rem; padding-block: 1rem; border-bottom: 1px solid var(--color-line); color: var(--color-ink); overflow-wrap: anywhere; }
  .dossier strong { font-weight: 600; }
  .dossier__num { flex-shrink: 0; font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-accent-text); }
  .etapes { display: grid; border-top: 1px solid var(--color-ink); }
  .etape { padding-block: 1.4rem; border-bottom: 1px solid var(--color-line); }
  .etape__num { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-accent-text); }
  @media (width >= 64rem) {
    .etapes { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 2rem; }
    .etape { border-bottom: 0; }
  }
  .donnees { max-width: 46rem; font-size: 0.9375rem; color: var(--color-muted); }
</style>
