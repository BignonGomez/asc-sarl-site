---
/**
 * Ressources › Recrutement — page ajoutée à la demande du cabinet (hors protocole initial).
 * Offres : src/data/recrutement.ts (tableau vide = bloc « Aucune offre en cours »).
 * Aucune offre, aucun avantage, aucun salaire ni délai de réponse n'est annoncé.
 */
import {
  Users, Leaf, Thermometer, Droplets, Map as MapIcon, Sprout, Store, Send, Inbox, FileUser, MessagesSquare,
  MailCheck, ShieldCheck, MapPin, CalendarClock, BriefcaseBusiness, ArrowUpRight, Mail,
} from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { offres, candidature } from '../../data/recrutement';
import { site } from '../../config/site';
import { url } from '../../lib/url';

const enc = encodeURIComponent;
const mailSpontanee = `mailto:${candidature.email}?subject=${enc(candidature.objetSpontanee)}&body=${enc(
  "Bonjour,\n\nVeuillez trouver ci-joints mon CV et ma lettre de motivation.\n\nDomaine d'intérêt : \n\nCordialement,\n",
)}`;
const mailOffre = (title: string) => `mailto:${candidature.email}?subject=${enc(`Candidature : ${title}`)}`;
const formatDate = (iso: string) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(iso));

const domaines = [
  { icon: Leaf, label: 'Environnement et études environnementales' },
  { icon: Thermometer, label: 'Climat et adaptation' },
  { icon: Droplets, label: 'Eau et gestion des ressources' },
  { icon: MapIcon, label: 'Aménagement du territoire' },
  { icon: Sprout, label: 'Agriculture et développement rural' },
  { icon: Store, label: 'Économie et développement local' },
];

const etapes = [
  { icon: Inbox, title: 'Réception du dossier', text: 'Votre CV et votre lettre de motivation sont enregistrés.' },
  { icon: FileUser, title: 'Étude de la candidature', text: 'Le cabinet examine votre profil au regard de ses besoins et de ses missions.' },
  { icon: MessagesSquare, title: 'Entretien', text: 'Les candidates et candidats dont le profil correspond peuvent être invités à un entretien.' },
  { icon: MailCheck, title: 'Réponse', text: 'Le cabinet vous informe de la suite donnée à votre candidature.' },
];
---
<BaseLayout
  title="Recrutement"
  description="Rejoindre Alkebulan Services et Conseils, cabinet béninois d'études et de conseil : environnement, climat, eau, aménagement du territoire, agriculture et développement local. Offres en cours et candidature spontanée."
>
  <PageHeader
    image="recrutement.hero"
    eyebrow="Ressources"
    title="Recrutement"
    intro={`Vous partagez nos domaines d'intervention ? Découvrez comment rejoindre ${site.name} ou nous proposer votre candidature.`}
    crumbs={[{ label: 'Ressources', href: '/ressources/faq' }, { label: 'Recrutement' }]}
  />

  <!-- Présentation -->
  <section aria-labelledby="rejoindre-title" class="section-y bg-white">
    <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <SectionHeading id="rejoindre-title" title="Rejoindre le cabinet" />
        <p class="mt-8 text-lead text-ink/90" data-reveal>
          {site.name} accompagne les acteurs publics et privés face aux enjeux environnementaux, climatiques et territoriaux. Pour chaque mission, le cabinet constitue des équipes pluridisciplinaires associant ses responsables et des experts associés aux spécialités complémentaires.
        </p>
        <p class="mt-5 text-body text-muted" data-reveal style="--reveal-delay:80ms">
          Nous nous intéressons aux profils qui souhaitent mettre leurs compétences au service des territoires : experts, experts associés pour des missions ponctuelles et stagiaires, dans les domaines où le cabinet intervient.
        </p>
        <p class="mt-6 inline-flex items-start gap-3 rounded-[1rem] bg-forest-soft px-4 py-3 text-small text-forest" data-reveal style="--reveal-delay:120ms">
          <Users size={18} aria-hidden="true" class="mt-0.5 shrink-0" /><span>Découvrez les responsables et experts du cabinet dans <a href={url('/cabinet/equipe')} class="font-semibold underline underline-offset-4 hover:text-brand">Notre équipe</a>.</span>
        </p>
      </div>
      <div class="lg:col-span-6" data-reveal style="--reveal-delay:120ms">
        <div class="profils">
          <p class="text-eyebrow uppercase text-leaf-light">Profils recherchés</p>
          <p class="mt-3 font-display text-h3 text-white">Des compétences en lien avec nos domaines</p>
          <ul class="mt-7 grid gap-3 sm:grid-cols-2">
            {domaines.map((d) => (
              <li class="profil">
                <span class="profil__icon"><d.icon size={18} stroke-width={1.9} aria-hidden="true" /></span>
                {d.label}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Offres en cours : bloc « Aucune offre en cours » tant que la liste est vide -->
  <section id="offres" aria-labelledby="offres-title" class="section-y scroll-mt-24 bg-mineral">
    <div class="container-site">
      <SectionHeading id="offres-title" title="Offres en cours" />

      {offres.length === 0 ? (
        <div class="aucune mt-12" data-reveal>
          <span aria-hidden="true" class="aucune__halo"></span>
          <span class="aucune__icon"><BriefcaseBusiness size={30} stroke-width={1.6} aria-hidden="true" /></span>
          <h3 class="mt-6 text-h3 text-forest">Aucune offre en cours</h3>
          <p class="mx-auto mt-4 max-w-xl text-body text-muted">
            Le cabinet n'a pas de poste ouvert actuellement. Il reste toutefois attentif aux profils qui partagent ses domaines d'intervention.
          </p>
          <div class="mt-8 flex justify-center">
            <a href={mailSpontanee} class="btn-mail">
              <Send size={18} aria-hidden="true" /> Envoyer une candidature spontanée
            </a>
          </div>
        </div>
      ) : (
        <ul class="mt-12 grid gap-5 md:grid-cols-2">
          {offres.map((o, i) => (
            <li class="offre" data-reveal style={`--reveal-delay:${(i % 2) * 80}ms`}>
              <span class="offre__tag">{o.contrat}</span>
              <h3 class="mt-4 text-h4 text-forest">{o.title}</h3>
              <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-small text-muted">
                <li class="inline-flex items-center gap-1.5"><MapPin size={15} aria-hidden="true" class="text-brand" /> {o.lieu}</li>
                <li class="inline-flex items-center gap-1.5"><CalendarClock size={15} aria-hidden="true" class="text-brand" /> Date limite : <time datetime={o.dateLimite}>{formatDate(o.dateLimite)}</time></li>
              </ul>
              {o.description && <p class="mt-4 text-small text-muted">{o.description}</p>}
              <div class="mt-6 flex flex-wrap gap-3">
                <a href={mailOffre(o.title)} class="btn-mail btn-mail--sm"><Send size={16} aria-hidden="true" /> Postuler</a>
                {o.lien && <a href={o.lien} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-small font-semibold text-forest hover:text-brand">Fiche de poste <ArrowUpRight size={15} aria-hidden="true" /><span class="sr-only">(nouvel onglet)</span></a>}
              </div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <!-- Candidature spontanée -->
  <section id="candidature" aria-labelledby="spontanee-title" class="section-y scroll-mt-24 bg-white">
    <div class="container-site grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-6">
        <SectionHeading id="spontanee-title" title="Candidature spontanée" />
        <p class="mt-8 text-lead text-ink/90" data-reveal>
          Envoyez votre <strong class="font-semibold text-forest">CV</strong> et votre <strong class="font-semibold text-forest">lettre de motivation</strong> par courrier électronique à l'adresse <a href={`mailto:${candidature.email}`} class="font-semibold text-brand underline underline-offset-4">{candidature.email}</a>, avec pour objet « {candidature.objetSpontanee} ».
        </p>
        <p class="mt-5 text-body text-muted" data-reveal style="--reveal-delay:80ms">
          Précisez dans votre message le domaine qui vous intéresse et le type de collaboration envisagé.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4" data-reveal style="--reveal-delay:120ms">
          <a href={mailSpontanee} class="btn-mail"><Mail size={18} aria-hidden="true" /> Écrire au cabinet</a>
        </div>
      </div>
      <div class="lg:col-span-6" data-reveal style="--reveal-delay:120ms">
        <ol class="dossier">
          <li><span class="dossier__num">1</span><span><strong>Votre CV</strong> à jour</span></li>
          <li><span class="dossier__num">2</span><span><strong>Votre lettre de motivation</strong></span></li>
          <li><span class="dossier__num">3</span><span>L'objet <strong>« {candidature.objetSpontanee} »</strong></span></li>
          <li><span class="dossier__num">4</span><span>Envoi à <strong>{candidature.email}</strong></span></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Déroulement du recrutement -->
  <section aria-labelledby="deroulement-title" class="section-y bg-mineral">
    <div class="container-site">
      <SectionHeading id="deroulement-title" title="Comment se déroule le recrutement" />
      <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {etapes.map((e, i) => (
          <li class="etape" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span aria-hidden="true" class="etape__num">{i + 1}</span>
            <span class="etape__icon"><e.icon size={20} stroke-width={1.8} aria-hidden="true" /></span>
            <h3 class="mt-5 text-h4 text-forest"><span class="sr-only">Étape {i + 1} : </span>{e.title}</h3>
            <p class="mt-2 text-small text-muted">{e.text}</p>
          </li>
        ))}
      </ol>

      <!-- Protection des données des candidats -->
      <p class="donnees mt-10" data-reveal>
        <ShieldCheck size={22} aria-hidden="true" class="mt-0.5 shrink-0 text-forest" />
        <span>
          <strong class="font-semibold text-forest">Protection de vos données.</strong> Les informations et documents que vous nous transmettez sont utilisés uniquement pour l'étude de votre candidature. Pour en savoir plus et exercer vos droits, consultez notre <a href={url('/politique-de-confidentialite')} class="font-semibold text-brand underline underline-offset-4">politique de confidentialité</a>.
        </span>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Profils recherchés */
  .profils {
    padding: 2rem;
    border-radius: 1.5rem;
    background: radial-gradient(ellipse 70% 70% at 100% 0%, rgb(74 115 32 / 0.55), transparent 70%), radial-gradient(ellipse 60% 60% at 0% 100%, rgb(252 209 42 / 0.21), transparent 70%), var(--color-forest-night);
    box-shadow: var(--shadow-lift);
  }
  @media (width >= 40rem) { .profils { padding: 2.5rem; } }
  .profil {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border-radius: 1rem;
    font-weight: 600;
    color: #fff;
    background: rgb(255 255 255 / 0.07);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .profil__icon { display: grid; place-items: center; flex-shrink: 0; width: 2.25rem; height: 2.25rem; border-radius: 0.75rem; color: var(--color-sun); background: rgb(255 255 255 / 0.08); }

  /* Aucune offre en cours */
  .aucune {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    max-width: 48rem;
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.25rem, 5vw, 3.5rem);
    border-radius: 1.75rem;
    text-align: center;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--color-line), var(--shadow-lift);
  }
  .aucune__halo {
    position: absolute;
    inset: -40% 10% auto;
    z-index: -1;
    height: 80%;
    filter: blur(30px);
    background: radial-gradient(closest-side, rgb(74 115 32 / 0.14), rgb(252 209 42 / 0.05) 60%, transparent);
  }
  .aucune__icon {
    display: inline-grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 1.25rem;
    color: var(--color-forest);
    background: var(--color-forest-soft);
    box-shadow: inset 0 0 0 1px rgb(31 77 46 / 0.12);
  }

  /* Bouton e-mail (relief, comme les boutons principaux) */
  .btn-mail {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 3.25rem;
    padding: 0 1.6rem;
    border-radius: 999px;
    font-weight: 600;
    color: var(--color-forest-deep);
    background: linear-gradient(180deg, var(--color-sun-light), var(--color-sun));
    box-shadow: var(--shadow-button);
    transition: transform 0.25s var(--ease-out-soft), box-shadow 0.25s;
  }
  .btn-mail:hover { transform: translateY(-2px); box-shadow: var(--shadow-button-hover); }
  .btn-mail--sm { min-height: 2.75rem; padding: 0 1.2rem; font-size: 0.9375rem; }

  /* Offres (affichées dès que le tableau n'est pas vide) */
  .offre { padding: 1.75rem; border-radius: 1.5rem; background: #fff; box-shadow: inset 0 0 0 1px var(--color-line), var(--shadow-card); }
  .offre__tag { display: inline-flex; padding: 0.3rem 0.75rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; color: var(--color-forest); background: var(--color-forest-soft); }

  /* Pièces du dossier */
  .dossier { display: grid; gap: 0.75rem; padding: 1.5rem; border-radius: 1.5rem; background: var(--color-mineral); box-shadow: inset 0 0 0 1px var(--color-line); }
  .dossier li { display: flex; align-items: center; gap: 1rem; padding: 1rem 1.1rem; border-radius: 1rem; background: #fff; box-shadow: inset 0 0 0 1px var(--color-line); color: var(--color-ink); overflow-wrap: anywhere; }
  .dossier__num { display: grid; place-items: center; flex-shrink: 0; width: 2.25rem; height: 2.25rem; border-radius: 999px; font-family: var(--font-display); font-weight: 700; color: #fff; background: var(--color-brand); }
  .dossier li:nth-child(even) .dossier__num { background: var(--color-forest); }

  /* Étapes */
  .etape { position: relative; overflow: hidden; padding: 1.5rem; border-radius: 1.25rem; background: #fff; box-shadow: inset 0 0 0 1px var(--color-line); }
  .etape__num { position: absolute; top: -0.5rem; right: 0.75rem; font-family: var(--font-display); font-size: 4.5rem; font-weight: 700; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px rgb(74 115 32 / 0.26); }
  .etape__icon { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 0.875rem; color: #fff; background: linear-gradient(135deg, var(--color-forest), var(--color-forest-night)); }

  .donnees { display: flex; gap: 0.9rem; padding: 1.25rem 1.4rem; border-radius: 1.25rem; font-size: 0.9375rem; color: var(--color-ink); background: #fff; box-shadow: inset 0 0 0 1px var(--color-line); }

  @media (prefers-reduced-motion: reduce) { .btn-mail:hover { transform: none; } }
</style>
