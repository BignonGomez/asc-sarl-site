---
/**
 * 5.3 Missions en cours — protocole complet, chapitre 5.
 * Fiche courte : titre, domaines, lieu, période prévue, nature des activités, client (si autorisé),
 * mention « En cours » et date de dernière mise à jour. Aucun résultat, montant ni information de marché.
 * Données : src/data/missions.ts
 */
import { MapPin, CalendarDays, RefreshCw, Building, Users, LayoutGrid, Check, ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import SiteImage from '../../components/ui/SiteImage.astro';
import ExpertiseIcon from '../../components/ui/ExpertiseIcon.astro';
import { missions, formatDate } from '../../data/missions';
import { expertises } from '../../data/expertises';
import { team } from '../../data/equipe';
import { site } from '../../config/site';
import { url } from '../../lib/url';

const enCours = missions.filter((m) => m.status === 'en-cours');
---
<BaseLayout
  title="Missions en cours"
  description="Les missions en cours d'exécution confiées à Alkebulan Services et Conseils, cabinet d'études et de conseil à Cotonou : formation, agriculture durable et développement rural."
>
  <PageHeader
    image="realisations.hero"
    eyebrow="Réalisations"
    title="Missions en cours"
    intro={`Les réalisations présentées ici sont exclusivement des missions confiées à ${site.name}. Chacune est accompagnée de son statut : achevée ou en cours d'exécution.`}
    crumbs={[{ label: 'Réalisations' }, { label: 'Missions en cours' }]}
  />

  {enCours.map((m) => {
    const domains = m.domains.map((s) => expertises.find((e) => e.slug === s)!).filter(Boolean);
    const members = m.team.map((t) => ({ ...t, member: team.find((p) => p.lastName === t.lastName)! })).filter((t) => t.member);
    return (
      <article aria-labelledby={`mission-${m.slug}`} class="section-y bg-white">
        <div class="container-site">
          <!-- En-tête de la fiche -->
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-small" data-reveal>
            <span class="inline-flex items-center gap-2 rounded-full bg-status-ongoing-bg px-3.5 py-1.5 font-semibold text-status-ongoing">
              <span aria-hidden="true" class="statut-pulse"></span> En cours d'exécution
            </span>
            <span class="inline-flex items-center gap-2 text-muted">
              <RefreshCw size={15} aria-hidden="true" /><span>Fiche mise à jour le <time datetime={m.updated}>{formatDate(m.updated)}</time></span>
            </span>
          </div>
          <h2 id={`mission-${m.slug}`} class="mt-6 max-w-4xl text-h2 text-forest" data-reveal>{m.title}</h2>
          <p class="mt-5 inline-flex items-start gap-2 text-lead text-muted" data-reveal>
            <MapPin size={20} aria-hidden="true" class="mt-1 shrink-0 text-brand" /> {m.place}
          </p>

          <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-12">
            <!-- Galerie -->
            <div class="lg:col-span-7" data-reveal>
              <div class="galerie">
                {m.images.map((img, i) => (
                  <figure class:list={['galerie__item', i === 0 && 'galerie__item--main']}>
                    <SiteImage id={img} sizes={i === 0 ? '(min-width: 64rem) 42rem, 100vw' : '(min-width: 64rem) 14rem, 33vw'} class="transition-transform duration-700 hover:scale-[1.04]" />
                  </figure>
                ))}
              </div>
              <p class="mt-6 text-lead text-ink/90">{m.summary}</p>
            </div>

            <!-- Fiche signalétique -->
            <aside aria-label="Fiche de la mission" class="lg:col-span-5">
              <div class="fiche lg:sticky lg:top-28" data-reveal style="--reveal-delay:120ms">
                <dl class="grid gap-6">
                  <div class="fiche__row">
                    <dt class="fiche__label"><Building size={16} aria-hidden="true" /> Client</dt>
                    <dd class="fiche__value">{m.client}</dd>
                  </div>
                  <div class="fiche__row">
                    <dt class="fiche__label"><MapPin size={16} aria-hidden="true" /> Lieu</dt>
                    <dd class="fiche__value">{m.place}</dd>
                  </div>
                  <div class="fiche__row">
                    <dt class="fiche__label"><CalendarDays size={16} aria-hidden="true" /> Période prévue</dt>
                    <dd class="fiche__value">{m.period.map((p) => <span class="block">{p}</span>)}</dd>
                  </div>
                  <div class="fiche__row">
                    <dt class="fiche__label"><LayoutGrid size={16} aria-hidden="true" /> Domaines</dt>
                    <dd class="mt-1 flex flex-wrap gap-2">
                      {domains.map((d) => (
                        <a href={url(`/expertises/${d.slug}`)} class="fiche__chip"><ExpertiseIcon name={d.icon} size={14} /> {d.title}</a>
                      ))}
                    </dd>
                  </div>
                  <div class="fiche__row">
                    <dt class="fiche__label"><Users size={16} aria-hidden="true" /> Équipe mobilisée</dt>
                    <dd class="mt-1 grid gap-2">
                      {members.map((t) => (
                        <a href={url(`/cabinet/equipe#membre-${t.lastName.toLowerCase()}`)} class="fiche__member group">
                          <span aria-hidden="true" class="fiche__avatar">{(t.member.firstName[0] + t.member.lastName[0]).toUpperCase()}</span>
                          <span class="flex-1">
                            <span class="block font-semibold text-white">{t.member.firstName} {t.member.lastName}</span>
                            <span class="block text-xs text-white/75">{t.role ?? t.member.role}</span>
                          </span>
                          <ArrowUpRight size={16} aria-hidden="true" class="text-white/60 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                        </a>
                      ))}
                    </dd>
                  </div>
                </dl>
              </div>
            </aside>
          </div>

          <!-- Nature des activités -->
          <div class="mt-16 lg:mt-20">
            <h3 class="text-h3 text-forest" data-reveal>Nature des activités</h3>
            <div class="mt-8 grid gap-6 lg:grid-cols-2">
              {m.volets.map((v, i) => (
                <section aria-label={v.title} class:list={['volet', i === 1 && 'volet--dark']} data-reveal style={`--reveal-delay:${i * 100}ms`}>
                  <span aria-hidden="true" class="volet__num">{String(i + 1).padStart(2, '0')}</span>
                  <h4 class="volet__title">{v.title}</h4>
                  <p class="volet__public">{v.public}</p>
                  <ul class="mt-6 grid gap-2.5 sm:grid-cols-2">
                    {v.items.map((it) => (
                      <li class="volet__item"><span class="volet__check"><Check size={14} stroke-width={2.5} aria-hidden="true" /></span>{it}</li>
                    ))}
                  </ul>
                  {v.extra && <p class="volet__extra">{v.extra}</p>}
                </section>
              ))}
            </div>
          </div>
        </div>
      </article>
    );
  })}
</BaseLayout>

<style>
  .statut-pulse { position: relative; width: 8px; height: 8px; border-radius: 999px; background: var(--color-sun-strong); }
  .statut-pulse::after { content: ''; position: absolute; inset: 0; border-radius: inherit; background: var(--color-sun-strong); animation: statut-pulse 2.4s var(--ease-out-soft) infinite; }
  @keyframes statut-pulse { to { transform: scale(2.8); opacity: 0; } }

  /* Galerie : une grande image et trois vignettes */
  .galerie { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
  .galerie__item { position: relative; margin: 0; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 1rem; box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.05); }
  .galerie__item--main { grid-column: 1 / -1; aspect-ratio: 16 / 10; border-radius: 1.5rem; box-shadow: var(--shadow-lift); }

  /* Fiche signalétique */
  .fiche {
    padding: 2rem;
    border-radius: 1.5rem;
    color: #fff;
    background: radial-gradient(ellipse 80% 60% at 100% 0%, rgb(74 115 32 / 0.55), transparent 70%), radial-gradient(ellipse 70% 60% at 0% 100%, rgb(252 209 42 / 0.21), transparent 70%), var(--color-forest-night);
    box-shadow: var(--shadow-lift);
  }
  .fiche__row + .fiche__row { padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 0.12); }
  .fiche__label { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-leaf-light); }
  .fiche__value { margin-top: 0.4rem; font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; line-height: 1.4; }
  .fiche__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #fff;
    background: rgb(255 255 255 / 0.1);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
    transition: background-color 0.2s, color 0.2s;
  }
  .fiche__chip:hover { color: var(--color-forest-night); background: #fff; }
  .fiche__member {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 0.9rem;
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    transition: background-color 0.2s;
  }
  .fiche__member:hover { background: rgb(255 255 255 / 0.12); }
  .fiche__avatar { display: grid; place-items: center; flex-shrink: 0; width: 2.5rem; height: 2.5rem; border-radius: 999px; font-family: var(--font-display); font-size: 0.875rem; font-weight: 700; color: var(--color-forest-night); background: #fff; }

  /* Volets d'activités */
  .volet {
    position: relative;
    overflow: hidden;
    padding: 2rem;
    border-radius: 1.5rem;
    background: var(--color-mineral);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .volet--dark { background: linear-gradient(150deg, var(--color-forest), var(--color-forest-night)); box-shadow: var(--shadow-lift); color: #fff; }
  .volet__num { position: absolute; top: 0.5rem; right: 1.25rem; font-family: var(--font-display); font-size: 4rem; font-weight: 700; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px rgb(74 115 32 / 0.3); }
  .volet--dark .volet__num { -webkit-text-stroke-color: rgb(255 255 255 / 0.2); }
  .volet__title { padding-right: 4.5rem; font-family: var(--font-display); font-size: var(--text-h3); font-weight: 600; color: var(--color-forest); }
  .volet--dark .volet__title { color: #fff; }
  .volet__public { margin-top: 0.5rem; max-width: 30rem; color: var(--color-muted); }
  .volet--dark .volet__public { color: rgb(255 255 255 / 0.8); }
  .volet__item { display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 0.85rem; border-radius: 0.8rem; font-weight: 600; background: #fff; box-shadow: inset 0 0 0 1px var(--color-line); color: var(--color-ink); }
  .volet--dark .volet__item { background: rgb(255 255 255 / 0.08); box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12); color: #fff; }
  .volet__check { display: grid; place-items: center; flex-shrink: 0; width: 1.4rem; height: 1.4rem; border-radius: 999px; color: #fff; background: var(--color-brand); }
  .volet__extra { margin-top: 1.25rem; font-size: 0.9375rem; color: var(--color-muted); }
  .volet--dark .volet__extra { color: rgb(255 255 255 / 0.85); }

  @media (prefers-reduced-motion: reduce) { .statut-pulse::after { animation: none; } }
</style>
