---
/**
 * 5.3 Missions en cours — protocole complet, chapitre 5 (refonte, étape 6).
 * Fiche : titre, statut, maître d'ouvrage (si autorisé), lieu, période, domaines, résumé, nature des activités,
 * date de dernière mise à jour. Aucun résultat, montant ni information de marché. Données : src/data/missions.ts
 * Pas de galerie photo : les photos de terrain montrent des groupes de personnes identifiables (règle « pas de photos
 * de groupe » et droit à l'image) ; à la place, carte de localisation. Équipe nominative : seulement si publication.equipe.
 */
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import CarteBenin from '../../components/ui/CarteBenin.astro';
import { missions, formatDate } from '../../data/missions';
import { expertises } from '../../data/expertises';
import { team } from '../../data/equipe';
import { site } from '../../config/site';
import { url } from '../../lib/url';

const enCours = missions.filter((m) => m.status === 'en-cours');
const pad = (n: number) => String(n).padStart(2, '0');
---
<BaseLayout
  title="Missions en cours"
  description="Les missions en cours confiées à Alkebulan Services et Conseils : maître d'ouvrage, lieu, calendrier, domaines et nature des activités."
>
  <PageHeader
    eyebrow="Réalisations"
    title="Missions en cours"
    intro={`Les réalisations présentées ici sont exclusivement des missions confiées à ${site.name}. Chacune est accompagnée de son statut : achevée ou en cours d'exécution.`}
    crumbs={[{ label: 'Réalisations' }, { label: 'Missions en cours' }]}
  />

  {enCours.map((m, k) => {
    const domains = m.domains.map((s) => expertises.find((e) => e.slug === s)!).filter(Boolean);
    const members = m.team.map((t) => ({ ...t, member: team.find((p) => p.lastName === t.lastName)! })).filter((t) => t.member);
    return (
      <article aria-labelledby={`mission-${m.slug}`} class="section-y">
        <div class="container-site">
          {k > 0 && <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>}
          <p class="fiche-tag" data-reveal>
            <span>Fiche {pad(k + 1)}</span>
            <span class="fiche-tag__status"><span aria-hidden="true" class="fiche-tag__dot"></span>En cours d'exécution</span>
            <span>Mise à jour le <time datetime={m.updated}>{formatDate(m.updated)}</time></span>
          </p>
          <h2 id={`mission-${m.slug}`} class="mt-6 max-w-4xl scroll-mt-28 text-h2 text-ink" data-reveal>{m.title}</h2>

          <div class="grid-site mt-12 gap-y-12 lg:mt-16">
            <div class="col-span-full lg:col-span-8">
              <dl class="kv" data-reveal>
                <div><dt>Maître d'ouvrage</dt><dd>{m.client}</dd></div>
                <div><dt>Lieu</dt><dd>{m.place}</dd></div>
                <div><dt>Calendrier</dt><dd>{m.period.map((p) => <span class="block">{p}</span>)}</dd></div>
                <div>
                  <dt>Domaines</dt>
                  <dd class="flex flex-wrap gap-x-5 gap-y-1">
                    {domains.map((d) => <a href={url(`/expertises/${d.slug}`)} class="text-accent-text underline decoration-line-strong underline-offset-4 hover:decoration-accent">{d.title}</a>)}
                  </dd>
                </div>
                {members.length > 0 && (
                  <div>
                    <dt>Équipe mobilisée</dt>
                    <dd>{members.map((t) => <span class="block">{t.member.firstName} {t.member.lastName} · {t.role ?? t.member.role}</span>)}</dd>
                  </div>
                )}
              </dl>
              <div class="prose-site mt-10" data-reveal><p>{m.summary}</p></div>
            </div>
            <figure class="col-span-full mx-auto w-full max-w-[22rem] lg:col-span-4 lg:mr-0" data-reveal>
              <CarteBenin />
              <figcaption class="label-mono mt-3">Localisation · Natural Earth</figcaption>
            </figure>
          </div>

          <!-- Nature des activités -->
          <div class="mt-16 lg:mt-20">
            <h3 class="label-mono" data-reveal>Nature des activités</h3>
            <div class="volets mt-6">
              {m.volets.map((v, i) => (
                <section aria-labelledby={`volet-${k}-${i}`} class="volet" data-reveal style={`--reveal-delay:${i * 100}ms`}>
                  <p class="num num--accent">Volet {pad(i + 1)}</p>
                  <h4 id={`volet-${k}-${i}`} class="volet__title">{v.title}</h4>
                  <p class="volet__public">{v.public}</p>
                  <ul class="rows mt-6">
                    {v.items.map((it) => <li class="text-[0.9375rem] text-ink">{it}</li>)}
                  </ul>
                  {v.extra && <p class="mt-5 text-[0.9375rem] text-muted">{v.extra}</p>}
                </section>
              ))}
            </div>
          </div>

          <p class="mt-12 max-w-3xl text-[0.9375rem] text-muted" data-reveal>
            Mission en cours : aucun résultat n'est publié avant son achèvement et la délivrance de l'attestation de bonne exécution.
          </p>
        </div>
      </article>
    );
  })}

  <section aria-labelledby="suite-title" class="section-y">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="suite-title" label="Poursuivre" title="Nos domaines d'intervention" />
      <ul class="link-rows mt-12 lg:mt-16" data-reveal>
        <li>
          <a href={url('/expertises')} class="link-row">
            <span class="num">01</span>
            <span class="link-row__title">Nos expertises</span>
            <span class="link-row__text">Huit domaines, leurs prestations et leurs livrables types.</span>
            <ArrowUpRight size={18} aria-hidden="true" class="link-row__go" />
          </a>
        </li>
        <li>
          <a href={url('/cabinet/approche')} class="link-row">
            <span class="num">02</span>
            <span class="link-row__title">Notre approche méthodologique</span>
            <span class="link-row__text">Une démarche en cinq étapes, un livrable à chacune.</span>
            <ArrowUpRight size={18} aria-hidden="true" class="link-row__go" />
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .fiche-tag { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.5rem; font-family: var(--font-mono); font-size: var(--text-eyebrow); letter-spacing: var(--text-eyebrow--letter-spacing); text-transform: uppercase; color: var(--color-muted); }
  .fiche-tag__status { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-accent-text); }
  .fiche-tag__dot { width: 0.5rem; height: 0.5rem; border-radius: 999px; background: var(--color-accent); }
  .volets { display: grid; gap: 2.5rem; }
  .volet { padding-top: 1.25rem; border-top: 1px solid var(--color-ink); }
  .volet__title { margin-top: 0.6rem; font-size: var(--text-h3); line-height: var(--text-h3--line-height); font-weight: 500; letter-spacing: -0.015em; color: var(--color-ink); }
  .volet__public { margin-top: 0.4rem; color: var(--color-muted); }
  @media (width >= 64rem) { .volets { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 3rem; } }
</style>
