---
/**
 * Gabarit des pages de domaine — protocole complet, section 4.2.
 * Blocs : en-tête, sommaire, enjeux et contexte, prestations, démarche (méthodes), publics,
 * experts mobilisables (si identifiés), mission liée (si elle existe), domaines complémentaires.
 * L'appel à l'action final est la carte du pied de page.
 * La mise en page varie selon `layout` (src/data/expertises-pages.ts).
 */
import { ArrowUpRight, ArrowRight, Info } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import SiteImage from '../../components/ui/SiteImage.astro';
import ExpertiseIcon from '../../components/ui/ExpertiseIcon.astro';
import Icon from '../../components/ui/Icon.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import { expertises } from '../../data/expertises';
import { domainPages, publics, type DomainPage } from '../../data/expertises-pages';
import { team } from '../../data/equipe';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return domainPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: DomainPage };
const domain = expertises.find((e) => e.slug === page.slug)!;
const index = expertises.indexOf(domain);
const experts = page.experts.map((n) => team.find((m) => m.lastName === n)).filter(Boolean) as typeof team;
const complementary = page.complementary.map((s) => expertises.find((e) => e.slug === s)!).filter(Boolean);
const others = expertises.filter((e) => e.slug !== page.slug && !page.complementary.includes(e.slug));
const initials = (m: (typeof team)[number]) => (m.firstName[0] + m.lastName[0]).toUpperCase();

const toc = [
  { id: 'enjeux', label: 'Enjeux' },
  { id: 'prestations', label: 'Ce que nous faisons' },
  { id: 'demarche', label: 'Notre démarche' },
  { id: 'publics', label: 'Pour qui ?' },
  ...(experts.length ? [{ id: 'experts', label: 'Experts mobilisables' }] : []),
  ...(page.mission ? [{ id: 'mission', label: 'Mission en cours' }] : []),
  { id: 'complementaires', label: 'Domaines complémentaires' },
];
const L = page.layout;
---
<BaseLayout title={page.seoTitle} description={page.seoDescription}>
  <PageHeader
    image={page.heroImage}
    eyebrow={`Domaine ${String(index + 1).padStart(2, '0')} · Nos expertises`}
    title={domain.title}
    intro={page.accroche}
    crumbs={[{ label: 'Nos expertises', href: '/expertises' }, { label: domain.title }]}
  />

  <!-- Sommaire cliquable (protocole, 4.2) -->
  <nav aria-label="Sur cette page" class="border-b border-line bg-white">
    <div class="container-site flex items-center gap-3 overflow-x-auto py-4 [scrollbar-width:none]">
      <span class="shrink-0 text-eyebrow uppercase text-muted">Sur cette page</span>
      <ul class="flex gap-2">
        {toc.map((t) => <li class="shrink-0"><a href={`#${t.id}`} class="toc-chip">{t.label}</a></li>)}
      </ul>
    </div>
  </nav>

  <!-- 2. Enjeux et contexte -->
  <section id="enjeux" aria-labelledby="enjeux-title" class="section-y scroll-mt-24 bg-white">
    <div class:list={['container-site grid items-center gap-12 lg:grid-cols-12 lg:gap-16']}>
      <div class:list={['lg:col-span-6', L.presentation === 'split-left' && 'lg:order-2']}>
        <SectionHeading id="enjeux-title" title="Enjeux et contexte" />
        {page.enjeux.map((p, i) => (
          <p class:list={[i === 0 ? 'mt-8 text-lead text-ink/90' : 'mt-5 text-body text-muted']} data-reveal style={`--reveal-delay:${i * 80}ms`}>{p}</p>
        ))}
      </div>
      <div class:list={['relative lg:col-span-6', L.presentation === 'split-left' && 'lg:order-1']} data-reveal style="--reveal-delay:120ms">
        <div class="relative aspect-[4/3] overflow-hidden rounded-[1.5rem] shadow-lift ring-1 ring-black/5">
          <SiteImage id={page.sideImage} sizes="(min-width: 64rem) 36rem, 100vw" />
        </div>
        <div class="badge-domaine">
          <span class="badge-domaine__icon"><ExpertiseIcon name={domain.icon} size={20} /></span>
          <span class="font-display text-small font-semibold leading-tight text-forest">{domain.title}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Prestations -->
  <section id="prestations" aria-labelledby="prestations-title" class="section-y scroll-mt-24 bg-mineral">
    <div class="container-site">
      <SectionHeading id="prestations-title" title="Ce que nous faisons" intro="Nos prestations dans ce domaine." />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {page.prestations.map((p, i) => (
          <li class:list={['presta', i === 0 && page.prestations.length % 3 === 2 && 'lg:col-span-2']} data-reveal style={`--reveal-delay:${(i % 3) * 80}ms`}>
            <span class="presta__icon"><Icon name={p.icon} size={22} /></span>
            <span aria-hidden="true" class="presta__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-6 text-h4 text-forest">{p.title}</h3>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4. Démarche (méthodes) -->
  <section id="demarche" aria-labelledby="demarche-title" class="section-y scroll-mt-24 bg-white">
    <div class="container-site">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading id="demarche-title" title="Notre démarche" intro="Les grandes étapes d'une mission dans ce domaine." />
        <div class="shrink-0" data-reveal><ArrowLink href="/cabinet/approche">Notre approche méthodologique</ArrowLink></div>
      </div>
      <ol class="frise mt-14" style={`--n:${page.steps.length}`}>
        {page.steps.map((s, i) => (
          <li class="frise__step" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="frise__dot">{i + 1}</span>
            <p class="frise__label">{s}</p>
          </li>
        ))}
      </ol>
      {page.stepsNote && (
        <p class="mt-10 flex items-start gap-3 rounded-[1.25rem] bg-forest-soft p-5 text-body text-forest sm:p-6" data-reveal>
          <Info size={20} aria-hidden="true" class="mt-0.5 shrink-0" />{page.stepsNote}
        </p>
      )}
    </div>
  </section>

  <!-- 5. Publics -->
  <section id="publics" aria-labelledby="publics-title" class="publics section-y scroll-mt-24 text-white">
    <div class="container-site">
      <SectionHeading id="publics-title" title="Pour qui ?" tone="light" intro="Nous accompagnons les acteurs publics et privés." />
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {publics.map((p, i) => (
          <li class="public" data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
            <span class="public__icon"><Icon name={p.icon} size={20} /></span>
            <span class="font-display text-h4 text-white">{p.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7. Experts mobilisables (si identifiés) -->
  {experts.length > 0 && (
    <section id="experts" aria-labelledby="experts-title" class="section-y scroll-mt-24 bg-white">
      <div class="container-site grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-5">
          <SectionHeading id="experts-title" title="Experts mobilisables" intro="Selon la nature de chaque mission, l'équipe est complétée par des experts associés." />
        </div>
        <ul class="grid gap-4 lg:col-span-7">
          {experts.map((m) => (
            <li data-reveal>
              <a href={url(`/cabinet/equipe#membre-${m.lastName.toLowerCase()}`)} class="expert group">
                <span aria-hidden="true" class="expert__avatar">{initials(m)}</span>
                <span class="flex-1">
                  <span class="block font-display text-h4 text-forest">{m.firstName} {m.lastName}</span>
                  <span class="block text-small font-semibold text-brand">{m.role}</span>
                  <span class="mt-1 block text-small text-muted">{m.specialty}</span>
                </span>
                <span aria-hidden="true" class="expert__arrow"><ArrowUpRight size={18} /></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- 8. Domaines complémentaires et autres expertises -->
  <section id="complementaires" aria-labelledby="compl-title" class="section-y scroll-mt-24 bg-mineral">
    <div class="container-site">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading id="compl-title" title="Domaines complémentaires" />
        <div class="shrink-0" data-reveal><ArrowLink href="/expertises">Toutes nos expertises</ArrowLink></div>
      </div>
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {complementary.map((e, i) => (
          <li data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <article class="compl group">
              <div class="aspect-[16/10] overflow-hidden">
                <SiteImage id={`expertise.${e.slug}` as any} sizes="(min-width: 48rem) 24rem, 100vw" class="transition-transform duration-700 group-hover:scale-[1.05]" />
              </div>
              <div class="flex flex-1 items-start justify-between gap-4 p-6">
                <h3 class="text-h4 text-forest">
                  <a href={url(`/expertises/${e.slug}`)} class="after:absolute after:inset-0 focus-visible:outline-none">{e.title}</a>
                </h3>
                <span aria-hidden="true" class="domaine-arrow"><ArrowRight size={18} /></span>
              </div>
            </article>
          </li>
        ))}
      </ul>
      <div class="mt-10 flex flex-wrap items-center gap-2" data-reveal>
        <span class="mr-2 text-eyebrow uppercase text-muted">Autres domaines</span>
        {others.map((e) => (
          <a href={url(`/expertises/${e.slug}`)} class="toc-chip !bg-white">
            <ExpertiseIcon name={e.icon} size={15} /> {e.title}
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .toc-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--color-forest);
    background: var(--color-mineral);
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s;
  }
  .toc-chip:hover { color: #fff; background: var(--color-forest) !important; box-shadow: none; }

  .badge-domaine {
    position: absolute;
    left: 1rem;
    bottom: -1.25rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    max-width: calc(100% - 2rem);
    padding: 0.75rem 1.1rem 0.75rem 0.75rem;
    border-radius: 1.1rem;
    background: rgb(255 255 255 / 0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px var(--color-line), var(--shadow-lift);
  }
  @media (width >= 40rem) { .badge-domaine { left: -1.25rem; } }
  .badge-domaine__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.75rem;
    color: #fff;
    background: linear-gradient(135deg, var(--color-brand), var(--color-brand-deep));
  }

  /* Prestations : cartes */
  .presta {
    position: relative;
    overflow: hidden;
    padding: 1.75rem;
    border-radius: 1.5rem;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--color-line), var(--shadow-card);
    transition: transform 0.45s var(--ease-out-soft), box-shadow 0.45s var(--ease-out-soft);
  }
  .presta:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px rgb(35 67 18 / 0.25), var(--shadow-lift); }
  .presta__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 0.9rem;
    color: var(--color-forest);
    background: var(--color-forest-soft);
    transition: color 0.3s, background-color 0.3s;
  }
  .presta:hover .presta__icon { color: #fff; background: var(--color-brand); }
  .presta__num {
    position: absolute;
    top: 0.75rem;
    right: 1.25rem;
    font-family: var(--font-display);
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(35 67 18 / 0.14);
  }

  /* Démarche : frise (verticale sur mobile, horizontale sur ordinateur) */
  .frise { position: relative; display: grid; gap: 1.25rem; }
  .frise::before {
    content: '';
    position: absolute;
    left: 1.375rem;
    top: 1.375rem;
    bottom: 1.375rem;
    width: 2px;
    background: linear-gradient(var(--color-brand), var(--color-forest-mist));
  }
  .frise__step { position: relative; display: flex; align-items: center; gap: 1.25rem; }
  .frise__dot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 700;
    color: #fff;
    background: var(--color-brand);
    box-shadow: 0 0 0 6px #fff, 0 8px 18px -8px rgb(174 36 69 / 0.7);
  }
  .frise__step:nth-child(even) .frise__dot { background: var(--color-forest); box-shadow: 0 0 0 6px #fff, 0 8px 18px -8px rgb(35 67 18 / 0.7); }
  .frise__label { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600; line-height: 1.3; color: var(--color-ink); }
  @media (width >= 64rem) {
    .frise { grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 1rem; }
    .frise::before { left: calc(50% / var(--n)); right: calc(50% / var(--n)); top: 1.375rem; bottom: auto; width: auto; height: 2px; background: linear-gradient(90deg, var(--color-brand), var(--color-forest-mist)); }
    .frise__step { flex-direction: column; text-align: center; gap: 1rem; }
  }

  /* Publics : bande verte */
  .publics { background: radial-gradient(ellipse 60% 80% at 100% 0%, rgb(18 128 75 / 0.45), transparent 70%), radial-gradient(ellipse 50% 70% at 0% 100%, rgb(174 36 69 / 0.25), transparent 70%), var(--color-forest-night); }
  .public {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem 1.4rem;
    border-radius: 1.25rem;
    background: linear-gradient(150deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.12), inset 0 0 0 1px rgb(255 255 255 / 0.12);
  }
  .public__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.875rem;
    color: var(--color-flame);
    background: rgb(255 255 255 / 0.08);
  }

  /* Experts */
  .expert {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1.5rem;
    background: var(--color-mineral);
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition: box-shadow 0.3s, transform 0.4s var(--ease-out-soft);
  }
  .expert:hover { transform: translateY(-3px); box-shadow: inset 0 0 0 1px rgb(35 67 18 / 0.3), var(--shadow-lift); }
  .expert__avatar {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-forest);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--color-line), 0 8px 18px -10px rgb(16 29 8 / 0.4);
  }
  .expert__arrow, .domaine-arrow {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    color: var(--color-brand);
    background: var(--color-brand-soft);
    transition: transform 0.35s var(--ease-out-soft), background-color 0.3s, color 0.3s;
  }
  .expert:hover .expert__arrow, .compl:hover .domaine-arrow { color: #fff; background: var(--color-brand); transform: rotate(-45deg); }

  /* Domaines complémentaires */
  .compl {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 1.5rem;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--color-line), var(--shadow-card);
    transition: transform 0.45s var(--ease-out-soft), box-shadow 0.45s;
  }
  .compl:hover { transform: translateY(-5px); box-shadow: var(--shadow-lift); }
  .compl:has(a:focus-visible) { outline: 2px solid var(--color-brand); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .presta:hover, .expert:hover, .compl:hover { transform: none; }
  }
</style>
