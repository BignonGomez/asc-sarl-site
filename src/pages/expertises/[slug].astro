---
/**
 * Gabarit des pages de domaine (refonte, étape 5).
 * En-tête typographique + photo technique (registre images.json), puis sections numérotées :
 * 01 Enjeux · 02 Prestations et livrables types · 03 Démarche · 04 Pour qui · (05 Mission en cours) · Domaines complémentaires.
 * Contenus : src/data/expertises-pages.ts (prestations SOURCÉES, accroches et enjeux À VALIDER),
 * livrables types : src/data/livrables.ts (À VALIDER). Experts nominatifs : affichés seulement si publication.equipe.
 */
import { ArrowUpRight, ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Photo from '../../components/ui/Photo.astro';
import { expertises } from '../../data/expertises';
import { domainPages, publics, prestationFamilies, type DomainPage, type Prestation } from '../../data/expertises-pages';
import { livrablesParDomaine } from '../../data/livrables';
import { team } from '../../data/equipe';
import { missions } from '../../data/missions';
import { url } from '../../lib/url';

export function getStaticPaths() {
  return domainPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: DomainPage };
const domain = expertises.find((e) => e.slug === page.slug)!;
const index = expertises.indexOf(domain);
const pad = (n: number) => String(n).padStart(2, '0');

// Photo de l'en-tête (registre images.json)
const photos: Record<string, string> = {
  'etudes-environnementales-sociales': 'expertise-etudes-environnementales',
  'changements-climatiques': 'expertise-changements-climatiques',
  'hydraulique-gire': 'expertise-hydraulique',
  'amenagement-territoire': 'expertise-amenagement',
  'agriculture-developpement-rural': 'expertise-agriculture',
  'economie-locale': 'expertise-economie-locale',
  'tourisme-conservation': 'expertise-tourisme-conservation',
  'formation-sensibilisation': 'expertise-formation',
};

// Prestations : liste simple, ou groupes par public (économie locale)
const groups: { title?: string; items: Prestation[] }[] = page.prestationGroups?.length
  ? page.prestationGroups
  : [{ items: page.prestations }];
const familyLabel = Object.fromEntries(prestationFamilies.map((f) => [f.id, f.id === 'etudes' ? 'Étude' : 'Accompagnement']));
const livrables = livrablesParDomaine[page.slug] ?? [];

const experts = page.experts.map((n) => team.find((m) => m.lastName === n)).filter(Boolean) as typeof team;
const mission = page.mission ? missions[0] : undefined;
const complementary = page.complementary.map((s) => expertises.find((e) => e.slug === s)!).filter(Boolean);
const others = expertises.filter((e) => e.slug !== page.slug && !page.complementary.includes(e.slug));

let n = 0;
const num = () => pad(++n);
const sections = [
  { id: 'enjeux', label: 'Enjeux' },
  { id: 'prestations', label: 'Prestations' },
  { id: 'demarche', label: 'Démarche' },
  { id: 'publics', label: 'Pour qui' },
  ...(experts.length ? [{ id: 'experts', label: 'Experts' }] : []),
  ...(mission ? [{ id: 'mission', label: 'Mission en cours' }] : []),
  { id: 'complementaires', label: 'Domaines liés' },
];
---
<BaseLayout title={page.seoTitle} description={page.seoDescription}>
  <PageHeader
    eyebrow={`Domaine ${pad(index + 1)} / ${pad(expertises.length)}`}
    title={domain.title}
    intro={page.accroche}
    crumbs={[{ label: 'Nos expertises', href: '/expertises' }, { label: domain.title }]}
  >
    <figure slot="aside" class="domain-photo">
      <Photo name={photos[page.slug]} priority sizes="(min-width: 64rem) 34rem, 100vw" />
    </figure>
  </PageHeader>

  <!-- Sommaire de la page -->
  <nav aria-label="Sur cette page" class="toc">
    <div class="container-site">
      <ul class="toc__list">
        {sections.map((s, i) => (
          <li><a href={`#${s.id}`} class="toc__link"><span class="toc__n">{pad(i + 1)}</span>{s.label}</a></li>
        ))}
      </ul>
    </div>
  </nav>

  <!-- 01 Enjeux -->
  <section id="enjeux" aria-labelledby="enjeux-title" class="section-y scroll-mt-28">
    <div class="container-site">
      <SectionHead id="enjeux-title" index={num()} label="Enjeux" title="Enjeux et contexte">
        <div class="mt-8 grid max-w-3xl gap-5 text-lead text-ink-soft" data-reveal>
          {page.enjeux.map((p) => <p>{p}</p>)}
        </div>
      </SectionHead>
    </div>
  </section>

  <!-- 02 Prestations et livrables -->
  <section id="prestations" aria-labelledby="prestations-title" class="section-y scroll-mt-28">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="prestations-title" index={num()} label="Prestations" title="Ce que nous faisons" />
      <div class="grid-site mt-12 gap-y-12 lg:mt-16">
        <div class="col-span-full lg:col-span-8">
          {groups.map((g) => (
            <div class="presta-group" data-reveal>
              {g.title && <h3 class="presta-group__title">{g.title}</h3>}
              <ol class="presta-list">
                {g.items.map((p, i) => (
                  <li class="presta-item">
                    <span class="presta-item__n">{pad(i + 1)}</span>
                    <span class="presta-item__title">{p.title}</span>
                    <span class="presta-item__fam">{familyLabel[p.family]}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
        {livrables.length > 0 && (
          <aside class="col-span-full lg:col-span-4" aria-labelledby="livrables-title" data-reveal>
            <div class="livrables">
              <h3 id="livrables-title" class="livrables__title">Livrables types</h3>
              <ul class="livrables__list">
                {livrables.map((l) => <li>{l}</li>)}
              </ul>
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>

  <!-- 03 Démarche -->
  <section id="demarche" aria-labelledby="demarche-title" class="section-y scroll-mt-28">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="demarche-title" index={num()} label="Démarche" title="Notre démarche dans ce domaine" />
      <ol class="demarche mt-12 lg:mt-16" style={`--cols:${page.steps.length}`} data-reveal>
        {page.steps.map((s, i) => (
          <li class="demarche__step">
            <span class="demarche__n">{pad(i + 1)}</span>
            <span class="demarche__title">{s}</span>
          </li>
        ))}
      </ol>
      {page.stepsNote && (
        <p class="demarche__note" data-reveal><span class="demarche__note-label">Note</span>{page.stepsNote}</p>
      )}
      <div class="mt-10" data-reveal>
        <a href={url('/cabinet/approche')} class="link-arrow group">Notre démarche générale en cinq étapes <ArrowRight size={16} aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1" /></a>
      </div>
    </div>
  </section>

  <!-- 04 Pour qui -->
  <section id="publics" aria-labelledby="publics-title" class="section-y scroll-mt-28">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="publics-title" index={num()} label="Pour qui" title="Nous intervenons pour" />
      <ul class="publics mt-12 lg:mt-16" data-reveal>
        {publics.map((p, i) => <li><span class="publics__n">{pad(i + 1)}</span>{p.label}</li>)}
      </ul>
      {page.publicsSpecific && (
        <p class="mt-6 text-[0.9375rem] text-muted" data-reveal>Dans ce domaine en particulier : {page.publicsSpecific.join(', ').toLowerCase()}.</p>
      )}
    </div>
  </section>

  <!-- Experts (uniquement si la publication nominative est autorisée) -->
  {experts.length > 0 && (
    <section id="experts" aria-labelledby="experts-title" class="section-y scroll-mt-28">
      <div class="container-site">
        <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
        <SectionHead id="experts-title" index={num()} label="Experts" title="Experts mobilisables" />
        <ul class="publics mt-12 lg:mt-16" data-reveal>
          {experts.map((m) => <li><span class="publics__n">{m.degree}</span>{m.firstName} {m.lastName}, {m.specialty.toLowerCase()}</li>)}
        </ul>
      </div>
    </section>
  )}

  <!-- Mission en cours liée au domaine -->
  {mission && (
    <section id="mission" aria-labelledby="mission-title" class="section-y scroll-mt-28">
      <div class="container-site">
        <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
        <SectionHead id="mission-title" index={num()} label="Référence" title="Mission en cours dans ce domaine" />
        <a href={url('/realisations/missions-en-cours')} class="mission group mt-12 lg:mt-16" data-reveal>
          <span class="mission__tag"><span aria-hidden="true" class="mission__dot"></span>En cours · {mission.duration ? `durée contractuelle ${mission.duration}` : mission.period[0]}</span>
          <span class="mission__title">{mission.title}</span>
          <span class="mission__meta">{mission.client} · {mission.place}</span>
          <span class="mission__go">Voir la fiche <ArrowUpRight size={16} aria-hidden="true" class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" /></span>
        </a>
      </div>
    </section>
  )}

  <!-- Domaines complémentaires -->
  <section id="complementaires" aria-labelledby="compl-title" class="section-y scroll-mt-28">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="compl-title" index={num()} label="Domaines liés" title="Domaines complémentaires" />
      <ul class="liens mt-12 lg:mt-16" data-reveal>
        {complementary.map((e) => (
          <li>
            <a href={url(`/expertises/${e.slug}`)} class="liens__row group">
              <span class="liens__n">{pad(expertises.indexOf(e) + 1)}</span>
              <span class="liens__title">{e.title}</span>
              <span class="liens__summary">{e.short}</span>
              <ArrowUpRight size={18} aria-hidden="true" class="liens__go" />
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-8 text-[0.9375rem] text-muted" data-reveal>
        Autres domaines :{' '}
        {others.map((e, i) => <><a href={url(`/expertises/${e.slug}`)} class="text-ink underline decoration-line-strong underline-offset-4 hover:text-accent-text hover:decoration-accent">{e.title}</a>{i < others.length - 1 ? ' · ' : '.'}</>)}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- En-tête : photo ---------- */
  .domain-photo { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; border-radius: var(--radius-card); background: var(--color-sunken); }
  @media (width >= 64rem) { .domain-photo { aspect-ratio: 5 / 4; } }

  /* ---------- Sommaire ---------- */
  .toc__list { display: flex; gap: 0.25rem 1.5rem; overflow-x: auto; padding: 1.1rem 0; scrollbar-width: none; }
  .toc__link { display: inline-flex; gap: 0.5rem; white-space: nowrap; font-size: 0.875rem; color: var(--color-muted); transition: color 0.2s; }
  .toc__link:hover { color: var(--color-ink); }
  .toc__n { font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-accent-text); }

  /* ---------- Prestations ---------- */
  .presta-group + .presta-group { margin-top: 2.5rem; }
  .presta-group__title { margin-bottom: 1rem; font-family: var(--font-mono); font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--text-eyebrow--letter-spacing); text-transform: uppercase; color: var(--color-accent-text); }
  .presta-list { border-top: 1px solid var(--color-line); }
  .presta-item { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.35rem 0; padding: 1.25rem 0; border-bottom: 1px solid var(--color-line); }
  .presta-item__n { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-muted); padding-top: 0.15rem; }
  .presta-item__title { font-size: 1.0625rem; font-weight: 500; line-height: 1.4; color: var(--color-ink); }
  .presta-item__fam { grid-column: 2; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); }
  @media (width >= 48rem) {
    .presta-item { grid-template-columns: 3.5rem 1fr auto; align-items: baseline; column-gap: 1.5rem; }
    .presta-item__fam { grid-column: 3; }
  }
  .livrables { padding: 1.75rem; border-radius: var(--radius-card); background: var(--color-surface); box-shadow: inset 0 0 0 1px var(--color-line); }
  .livrables__title { font-family: var(--font-mono); font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--text-eyebrow--letter-spacing); text-transform: uppercase; color: var(--color-accent-text); }
  .livrables__list { margin-top: 1.1rem; display: grid; gap: 0.85rem; }
  .livrables__list li { position: relative; padding-left: 1.25rem; font-size: 0.9375rem; font-weight: 500; line-height: 1.45; color: var(--color-ink); }
  .livrables__list li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 0.5rem; height: 0.5rem; border-radius: 1px; box-shadow: inset 0 0 0 1.5px var(--color-accent); }
  @media (width >= 64rem) { .livrables { position: sticky; top: 7rem; } }

  /* ---------- Démarche ---------- */
  .demarche { display: grid; border-top: 1px solid var(--color-line); }
  .demarche__step { display: grid; grid-template-columns: 2.5rem 1fr; padding: 1.1rem 0; border-bottom: 1px solid var(--color-line); }
  .demarche__n { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-accent-text); }
  .demarche__title { font-weight: 500; color: var(--color-ink); }
  @media (width >= 64rem) {
    .demarche { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); border-top: 0; }
    .demarche__step { display: block; padding: 1.5rem 1.5rem 0 0; border-bottom: 0; border-top: 1px solid var(--color-ink); }
    .demarche__step + .demarche__step { padding-left: 0; }
    .demarche__n { display: block; margin-bottom: 0.75rem; }
    .demarche__title { font-size: 1.0625rem; line-height: 1.35; }
  }
  .demarche__note { margin-top: 2rem; max-width: 46rem; font-size: 0.9375rem; color: var(--color-muted); }
  .demarche__note-label { margin-right: 0.75rem; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-text); }
  .link-arrow { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 500; color: var(--color-ink); }
  .link-arrow:hover { color: var(--color-accent-text); }

  /* ---------- Publics ---------- */
  .publics { display: grid; border-top: 1px solid var(--color-line); }
  .publics li { display: flex; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--color-line); font-weight: 500; color: var(--color-ink); }
  .publics__n { flex-shrink: 0; min-width: 1.5rem; font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 400; color: var(--color-muted); padding-top: 0.1rem; }
  @media (width >= 48rem) { .publics { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; } }
  @media (width >= 64rem) { .publics { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* ---------- Mission ---------- */
  .mission { display: grid; gap: 0.75rem; padding: 1.75rem 0; border-top: 1px solid var(--color-ink); border-bottom: 1px solid var(--color-line); }
  .mission__tag { display: inline-flex; align-items: center; gap: 0.5rem; font-family: var(--font-mono); font-size: var(--text-eyebrow); letter-spacing: var(--text-eyebrow--letter-spacing); text-transform: uppercase; color: var(--color-accent-text); }
  .mission__dot { width: 0.5rem; height: 0.5rem; border-radius: 999px; background: var(--color-accent); }
  .mission__title { max-width: 48rem; font-size: var(--text-h3); line-height: var(--text-h3--line-height); letter-spacing: var(--text-h3--letter-spacing); font-weight: 500; color: var(--color-ink); transition: color 0.2s; }
  .mission__meta { font-size: 0.9375rem; color: var(--color-muted); }
  .mission__go { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.5rem; font-weight: 500; color: var(--color-ink); }
  .mission:hover .mission__title { color: var(--color-accent-text); }

  /* ---------- Domaines liés ---------- */
  .liens { border-top: 1px solid var(--color-line); }
  .liens__row { display: grid; grid-template-columns: 2.5rem 1fr auto; gap: 0.25rem 0; align-items: baseline; padding: 1.4rem 0; border-bottom: 1px solid var(--color-line); transition: background-color 0.25s; }
  .liens__n { font-family: var(--font-mono); font-size: 0.8125rem; color: var(--color-muted); }
  .liens__title { font-size: 1.125rem; font-weight: 500; color: var(--color-ink); transition: color 0.2s; }
  .liens__summary { grid-column: 2; font-size: 0.9375rem; color: var(--color-muted); }
  :global(.liens__go) { grid-column: 3; grid-row: 1; color: var(--color-line-strong); transition: color 0.2s, transform 0.3s var(--ease-out-soft); }
  .liens__row:hover .liens__title { color: var(--color-accent-text); }
  .liens__row:hover :global(.liens__go) { color: var(--color-accent); transform: translate(2px, -2px); }
  @media (width >= 64rem) {
    .liens__row { grid-template-columns: 4rem 5fr 6fr auto; }
    .liens__summary { grid-column: 3; grid-row: 1; }
    :global(.liens__go) { grid-column: 4; }
  }
</style>
