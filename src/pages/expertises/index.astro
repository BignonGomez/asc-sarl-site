---
/** 4.1 Page d'entrée « Nos expertises » — protocole complet, section 4.1. */
import { ArrowUpRight, ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import SiteImage from '../../components/ui/SiteImage.astro';
import ExpertiseIcon from '../../components/ui/ExpertiseIcon.astro';
import StepIcon from '../../components/ui/StepIcon.astro';
import ArrowLink from '../../components/ui/ArrowLink.astro';
import { expertises } from '../../data/expertises';
import { besoins } from '../../data/expertises-pages';
import { steps } from '../../data/approche';
import { site } from '../../config/site';
import { url } from '../../lib/url';
---
<BaseLayout
  title="Nos expertises"
  description="Environnement, climat, eau, aménagement du territoire, agriculture durable, économie locale, tourisme et formation : les huit domaines d'intervention d'Alkebulan Services et Conseils, cabinet d'études et de conseil à Cotonou."
  cta={{
    title: 'Vous avez un projet ou des termes de référence ?',
    text: 'Transmettez-les-nous : nous étudierons votre demande avec attention.',
  }}
>
  <PageHeader
    image="expertises.hero"
    eyebrow="Huit domaines complémentaires"
    title="Nos expertises"
    intro={`Environnement, climat, eau, territoire, agriculture, économie locale, tourisme et formation : les domaines d'intervention d'${site.name} sont complémentaires. Ils permettent d'aborder chaque projet dans sa globalité, en tenant compte de ses dimensions techniques, environnementales, sociales et économiques.`}
    crumbs={[{ label: 'Nos expertises' }]}
  />

  <section aria-labelledby="domaines-title" class="section-y bg-mineral">
    <div class="container-site">
      <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading id="domaines-title" title="Nos huit domaines d'intervention" />

        <!-- Sélecteur « Quel est votre besoin ? » (nécessite JavaScript ; sans lui, toutes les cartes restent visibles) -->
        <div class="besoin js-only lg:max-w-xl" data-reveal>
          <p id="besoin-label" class="text-eyebrow uppercase text-brand">Quel est votre besoin ?</p>
          <div class="mt-3 flex flex-wrap gap-2" role="group" aria-labelledby="besoin-label">
            {besoins.map((b) => (
              <button type="button" class="besoin__chip" aria-pressed="false" data-besoin={b.slugs.join(' ')}>{b.label}</button>
            ))}
          </div>
          <p class="sr-only" aria-live="polite" data-besoin-status></p>
        </div>
      </div>

      <ul class="mt-12 grid gap-6 md:grid-cols-2 lg:mt-14 lg:gap-7" data-domaines>
        {expertises.map((e, i) => (
          <li class="domaine" data-slug={e.slug} data-reveal style={`--reveal-delay:${(i % 2) * 90}ms`}>
            <article class="domaine__card group" data-spot>
              <div class="relative aspect-[16/9] overflow-hidden">
                <SiteImage id={`expertise.${e.slug}` as any} sizes="(min-width: 48rem) 36rem, 100vw" class="transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.05]" />
                <span aria-hidden="true" class="absolute inset-0 bg-[linear-gradient(180deg,transparent_45%,rgb(15_38_24/0.55))]"></span>
                <span aria-hidden="true" class="domaine__num">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="relative flex flex-1 flex-col p-6 sm:p-8">
                <span class="domaine__icon"><ExpertiseIcon name={e.icon} size={22} /></span>
                <h3 class="mt-5 text-h3 text-forest">
                  <a href={url(`/expertises/${e.slug}`)} class="after:absolute after:inset-0 after:rounded-[1.5rem] focus-visible:outline-none">{e.title}</a>
                </h3>
                <p class="mt-3 flex-1 text-body text-muted">{e.summary}</p>
                <span aria-hidden="true" class="mt-6 inline-flex items-center gap-3 font-semibold text-brand">
                  Découvrir ce domaine
                  <span class="domaine__arrow"><ArrowUpRight size={18} /></span>
                </span>
              </div>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Comment nous intervenons -->
  <section aria-labelledby="intervention-title" class="section-y bg-white">
    <div class="container-site">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <SectionHeading id="intervention-title" title="Comment nous intervenons" intro="Quel que soit le domaine, chaque mission suit une démarche en cinq étapes, adaptée à son contexte." />
        <div class="shrink-0" data-reveal><ArrowLink href="/cabinet/approche">Notre approche méthodologique</ArrowLink></div>
      </div>
      <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:mt-14 lg:grid-cols-5">
        {steps.map((s, i) => (
          <li class="etape" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span aria-hidden="true" class="etape__num">{i + 1}</span>
            <span class="etape__icon"><StepIcon name={s.icon} size={20} /></span>
            <h3 class="mt-5 text-h4 text-forest"><span class="sr-only">Étape {i + 1} : </span>{s.short}</h3>
            <p class="mt-2 text-small text-muted">{s.summary}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Sélecteur ---------- */
  :global(html:not(.js)) .js-only { display: none; }
  .besoin__chip {
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-forest);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--color-line);
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s;
  }
  .besoin__chip:hover { box-shadow: inset 0 0 0 1px var(--color-forest); }
  .besoin__chip[aria-pressed='true'] { color: #fff; background: var(--color-brand); box-shadow: 0 8px 18px -10px rgb(74 115 32 / 0.96); }
  [data-domaines].is-filtering .domaine:not(.is-match) { opacity: 0.35; filter: saturate(0.4); }
  [data-domaines].is-filtering .domaine.is-match .domaine__card { box-shadow: 0 0 0 2px var(--color-brand), var(--shadow-lift); }
  .domaine { transition: opacity 0.4s var(--ease-out-soft), filter 0.4s; }

  /* ---------- Grandes cartes ---------- */
  .domaine__card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: 1.5rem;
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--color-line), var(--shadow-card);
    transition: transform 0.5s var(--ease-out-soft), box-shadow 0.5s var(--ease-out-soft);
  }
  .domaine__card:hover { transform: translateY(-6px); box-shadow: inset 0 0 0 1px rgb(31 77 46 / 0.25), var(--shadow-lift); }
  .domaine__card:has(a:focus-visible) { outline: 2px solid var(--color-brand); outline-offset: 3px; }
  /* Halo qui suit la souris */
  .domaine__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    border-radius: inherit;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, -20%), rgb(252 209 42 / 0.05), transparent 45%);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .domaine__card:hover::after { opacity: 1; }
  .domaine__num {
    position: absolute;
    right: 1.25rem;
    bottom: 0.5rem;
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.85);
  }
  .domaine__icon {
    position: absolute;
    top: -1.75rem;
    left: 1.5rem;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 1rem;
    color: var(--color-forest);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--color-line), 0 10px 24px -12px rgb(15 38 24 / 0.45);
    transition: background-color 0.3s, color 0.3s;
  }
  @media (width >= 40rem) { .domaine__icon { left: 2rem; } }
  .domaine__card:hover .domaine__icon { color: #fff; background: var(--color-forest); }
  .domaine__arrow {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: var(--color-brand-soft);
    transition: transform 0.35s var(--ease-out-soft), background-color 0.3s, color 0.3s;
  }
  .domaine__card:hover .domaine__arrow { color: #fff; background: var(--color-brand); transform: rotate(45deg); }

  /* ---------- Étapes ---------- */
  .etape {
    position: relative;
    overflow: hidden;
    padding: 1.5rem;
    border-radius: 1.25rem;
    background: var(--color-mineral);
    box-shadow: inset 0 0 0 1px var(--color-line);
  }
  .etape__num {
    position: absolute;
    top: -0.5rem;
    right: 0.75rem;
    font-family: var(--font-display);
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(74 115 32 / 0.26);
  }
  .etape__icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.875rem;
    color: #fff;
    background: linear-gradient(135deg, var(--color-forest), var(--color-forest-night));
  }
  @media (prefers-reduced-motion: reduce) {
    .domaine__card:hover { transform: none; }
  }
</style>

<script>
  // Halo qui suit la souris
  document.querySelectorAll<HTMLElement>('[data-spot]').forEach((el) =>
    el.addEventListener('pointermove', (e) => {
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${e.clientX - r.left}px`);
      el.style.setProperty('--my', `${e.clientY - r.top}px`);
    }),
  );
  // Sélecteur « Quel est votre besoin ? » : met en évidence les domaines correspondants
  const grid = document.querySelector<HTMLElement>('[data-domaines]');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-besoin]')];
  const status = document.querySelector('[data-besoin-status]');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const active = chip.getAttribute('aria-pressed') !== 'true';
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip && active)));
      const slugs = active ? chip.dataset.besoin!.split(' ') : [];
      grid?.classList.toggle('is-filtering', active);
      const matches: string[] = [];
      grid?.querySelectorAll<HTMLElement>('.domaine').forEach((d) => {
        const m = slugs.includes(d.dataset.slug!);
        d.classList.toggle('is-match', m);
        if (m) matches.push(d.querySelector('h3')!.textContent!.trim());
      });
      if (status) status.textContent = active ? `Domaines correspondants : ${matches.join(', ')}.` : 'Tous les domaines sont affichés.';
      if (active) grid?.querySelector<HTMLElement>('.domaine.is-match')?.scrollIntoView({ behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'center' });
    }),
  );
</script>
