---
/**
 * Page d'entrée « Nos expertises » (refonte, étape 5).
 * 01 Domaines et livrables types (tableau partagé avec l'accueil) · 02 Prestations par famille (R4)
 * · 03 Orientation selon le besoin · 04 Méthode commune en cinq étapes.
 */
import { ArrowUpRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/page/PageHeader.astro';
import SectionHead from '../../components/ui/SectionHead.astro';
import Prestations from '../../components/home/Prestations.astro';
import PrestationsOverview from '../../components/expertises/PrestationsOverview.astro';
import Methode from '../../components/home/Methode.astro';
import { expertises } from '../../data/expertises';
import { besoins } from '../../data/expertises-pages';
import { site } from '../../config/site';
import { url } from '../../lib/url';
---
<BaseLayout
  title="Nos expertises"
  description="Environnement, climat, eau, aménagement du territoire, agriculture durable, économie locale, tourisme et formation : les huit domaines d'intervention d'Alkebulan Services et Conseils, cabinet d'études et de conseil à Cotonou."
>
  <PageHeader
    eyebrow="Huit domaines complémentaires"
    title="Nos expertises"
    intro={`Environnement, climat, eau, territoire, agriculture, économie locale, tourisme et formation : les domaines d'intervention d'${site.name} sont complémentaires. Ils permettent d'aborder chaque projet dans sa globalité, en tenant compte de ses dimensions techniques, environnementales, sociales et économiques.`}
    crumbs={[{ label: 'Nos expertises' }]}
  />

  <Prestations index="01" link={false} id="domaines" />

  <PrestationsOverview index="02" />

  <section aria-labelledby="besoins-title" class="section-y">
    <div class="container-site">
      <div aria-hidden="true" class="rule-top mb-12 lg:mb-16"></div>
      <SectionHead id="besoins-title" index="03" label="Orientation" title="Quel est votre besoin ?" intro="Les domaines à consulter selon la nature de votre demande." />
      <ul class="besoins mt-12 lg:mt-16" data-reveal>
        {besoins.map((b) => (
          <li class="besoin">
            <span class="besoin__label">{b.label}</span>
            <span class="besoin__links">
              {b.slugs.map((s) => {
                const e = expertises.find((x) => x.slug === s)!;
                return (
                  <a href={url(`/expertises/${s}`)} class="besoin__link group">
                    {e.title} <ArrowUpRight size={15} aria-hidden="true" class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
                  </a>
                );
              })}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Methode index="04" />
</BaseLayout>

<style>
  .besoins { border-top: 1px solid var(--color-line); }
  .besoin { display: grid; gap: 0.6rem; padding: 1.25rem 0; border-bottom: 1px solid var(--color-line); }
  .besoin__label { font-size: 1.0625rem; font-weight: 500; color: var(--color-ink); }
  .besoin__links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.5rem; }
  .besoin__link { display: inline-flex; align-items: center; gap: 0.3rem; font-size: 0.9375rem; color: var(--color-accent-text); }
  .besoin__link:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (width >= 64rem) {
    .besoin { grid-template-columns: 5fr 7fr; gap: 2rem; align-items: baseline; }
  }
</style>
